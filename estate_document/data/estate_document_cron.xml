<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aviso diario de documentos próximos a vencer (cédulas, contratos, certificados).
         La anticipación en días se controla con el parámetro de sistema
         'estate_document.expiry_warning_days' (por defecto 30). -->
    <record id="cron_notify_expiring_documents" model="ir.cron">
        <field name="name">Documentos: aviso de vencimientos próximos</field>
        <field name="model_id" ref="model_estate_document"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_expiring_documents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Parámetro configurable de anticipación (días). -->
    <record id="param_expiry_warning_days" model="ir.config_parameter">
        <field name="key">estate_document.expiry_warning_days</field>
        <field name="value">30</field>
    </record>
</odoo>
