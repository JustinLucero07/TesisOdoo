<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Gráfico Chart.js -->
    <t t-name="estate_reports.DashChart">
        <div class="o_estate_chart">
            <canvas t-if="hasData" t-ref="canvas"/>
            <div t-else="" class="o_estate_chart__empty">
                <i class="fa fa-bar-chart" aria-hidden="true"/>
                <span>Sin datos en el período</span>
            </div>
        </div>
    </t>

    <!-- Dashboard -->
    <t t-name="estate_reports.DashboardAction">
        <div class="o_estate_dash">
            <div class="o_estate_dash__inner">

                <!-- ═══ Encabezado ═══ -->
                <header class="o_estate_dash__head">
                    <div>
                        <p class="o_estate_dash__eyebrow">Inmobi · Resumen</p>
                        <h1 class="o_estate_dash__title">Dashboard General</h1>
                    </div>
                    <div class="o_estate_dash__filters">
                        <label class="o_estate_dash__select">
                            <i class="fa fa-user-o" aria-hidden="true"/>
                            <select t-on-change="onUser" aria-label="Asesor">
                                <option value="">Todos los asesores</option>
                                <t t-foreach="state.advisors" t-as="a" t-key="a.id">
                                    <option t-att-value="a.id" t-att-selected="a.id === state.userId" t-esc="a.name"/>
                                </t>
                            </select>
                        </label>
                        <label class="o_estate_dash__select">
                            <i class="fa fa-calendar-o" aria-hidden="true"/>
                            <select t-on-change="onPeriod" aria-label="Período">
                                <t t-foreach="state.periods" t-as="p" t-key="p.value">
                                    <option t-att-value="p.value" t-att-selected="p.value === state.period" t-esc="p.label"/>
                                </t>
                            </select>
                        </label>
                        <button class="o_estate_dash__icon-btn" t-on-click="refresh" title="Actualizar" aria-label="Actualizar">
                            <i t-att-class="state.loading ? 'fa fa-refresh fa-spin' : 'fa fa-refresh'"/>
                        </button>
                    </div>
                </header>

                <!-- ═══ KPIs ═══ -->
                <section class="o_estate_dash__kpis">
                    <button class="o_estate_kpi o_estate_kpi--link"
                            t-on-click="() =&gt; this.openList('estate.property', 'Disponibles', [['state','=','available']])">
                        <span class="o_estate_kpi__icon"><i class="fa fa-home"/></span>
                        <span class="o_estate_kpi__label">Disponibles</span>
                        <span class="o_estate_kpi__value" t-esc="state.k.available_properties or 0"/>
                    </button>
                    <div class="o_estate_kpi">
                        <span class="o_estate_kpi__icon"><i class="fa fa-handshake-o"/></span>
                        <span class="o_estate_kpi__label">Ofertas activas</span>
                        <span class="o_estate_kpi__value" t-esc="state.k.active_offers_count or 0"/>
                    </div>
                    <div class="o_estate_kpi">
                        <span class="o_estate_kpi__icon"><i class="fa fa-file-text-o"/></span>
                        <span class="o_estate_kpi__label">Contratos activos</span>
                        <span class="o_estate_kpi__value" t-esc="state.k.active_contracts_count or 0"/>
                    </div>
                    <div class="o_estate_kpi">
                        <span class="o_estate_kpi__icon"><i class="fa fa-map-marker"/></span>
                        <span class="o_estate_kpi__label">Visitas</span>
                        <span class="o_estate_kpi__value" t-esc="state.k.appointments_done or 0"/>
                    </div>
                    <div class="o_estate_kpi o_estate_kpi--warn">
                        <span class="o_estate_kpi__icon"><i class="fa fa-hourglass-half"/></span>
                        <span class="o_estate_kpi__label">Estancadas</span>
                        <span class="o_estate_kpi__value" t-esc="state.k.stagnant_properties or 0"/>
                    </div>
                    <div class="o_estate_kpi o_estate_kpi--danger">
                        <span class="o_estate_kpi__icon"><i class="fa fa-calendar-times-o"/></span>
                        <span class="o_estate_kpi__label">Por vencer</span>
                        <span class="o_estate_kpi__value" t-esc="state.k.contracts_expiring or 0"/>
                    </div>
                </section>

                <!-- Cargando -->
                <div t-if="state.loading" class="o_estate_dash__loading">
                    <span class="o_estate_dash__skeleton"/>
                    <span class="o_estate_dash__skeleton"/>
                    <span class="o_estate_dash__skeleton"/>
                </div>

                <t t-else="">
                    <!-- ═══ Asistente IA ═══ -->
                    <section class="o_estate_card o_estate_ai">
                        <div class="o_estate_ai__row">
                            <span class="o_estate_ai__badge"><i class="fa fa-magic"/></span>
                            <input type="text" class="o_estate_ai__input"
                                   placeholder="Pregúntale al asistente: ¿quién fue el mejor asesor este mes?"
                                   t-model="state.aiQuery"
                                   t-on-keydown="(ev) =&gt; ev.key === 'Enter' and this.askAi()"/>
                            <button class="btn btn-primary o_estate_ai__btn" t-on-click="askAi"
                                    t-att-disabled="state.aiLoading">
                                <i t-att-class="state.aiLoading ? 'fa fa-spinner fa-spin' : 'fa fa-paper-plane'"/>
                                <span class="d-none d-sm-inline ms-1">Preguntar</span>
                            </button>
                        </div>
                        <div t-if="state.aiResponse" class="o_estate_ai__answer" t-out="raw(state.aiResponse)"/>
                    </section>

                    <!-- ═══ Bloques de métricas ═══ -->
                    <section class="o_estate_dash__grid">
                        <article class="o_estate_card">
                            <h2 class="o_estate_card__title">Propiedades</h2>
                            <dl class="o_estate_metrics">
                                <div><dt>Total</dt><dd t-esc="state.k.total_properties or 0"/></div>
                                <div><dt>Disponibles</dt><dd t-esc="state.k.available_properties or 0"/></div>
                                <div><dt>Vendidas / rentadas</dt><dd t-esc="state.k.sold_properties or 0"/></div>
                                <div><dt>Estancadas (+60 días)</dt><dd t-esc="state.k.stagnant_properties or 0"/></div>
                                <div><dt>Días promedio en mercado</dt><dd t-esc="num(state.k.avg_days_on_market)"/></div>
                            </dl>
                        </article>
                        <article class="o_estate_card">
                            <h2 class="o_estate_card__title">Clientes y actividad</h2>
                            <dl class="o_estate_metrics">
                                <div><dt>Total clientes</dt><dd t-esc="state.k.total_clients or 0"/></div>
                                <div><dt>Clientes activos</dt><dd t-esc="state.k.active_clients or 0"/></div>
                                <div><dt>Visitas realizadas</dt><dd t-esc="state.k.appointments_done or 0"/></div>
                                <div><dt>Ofertas activas</dt><dd t-esc="state.k.active_offers_count or 0"/></div>
                                <div><dt>Contratos por vencer</dt><dd t-esc="state.k.contracts_expiring or 0"/></div>
                            </dl>
                        </article>
                        <article class="o_estate_card">
                            <h2 class="o_estate_card__title">Indicadores financieros</h2>
                            <dl class="o_estate_metrics">
                                <div><dt>Comisiones del período</dt><dd t-att-class="state.k.monthly_commissions &gt; 0 ? 'is-positive' : ''" t-esc="money(state.k.monthly_commissions)"/></div>
                                <div><dt>Ingresos cerrados</dt><dd t-esc="money(state.k.won_revenue_month)"/></div>
                                <div><dt>Pipeline pendiente</dt><dd t-esc="money(state.k.pending_revenue)"/></div>
                                <div><dt>Facturas pendientes</dt><dd t-esc="money(state.k.pending_invoices_amount)"/></div>
                            </dl>
                        </article>
                        <article class="o_estate_card">
                            <h2 class="o_estate_card__title">Embudo CRM</h2>
                            <dl class="o_estate_metrics">
                                <div><dt>Leads nuevos</dt><dd t-esc="state.k.funnel_leads_new or 0"/></div>
                                <div><dt>Visitas realizadas</dt><dd t-esc="state.k.funnel_visits_done or 0"/></div>
                                <div><dt>Ofertas realizadas</dt><dd t-esc="state.k.funnel_offers_made or 0"/></div>
                                <div><dt>Ganados</dt><dd t-att-class="state.k.funnel_won &gt; 0 ? 'is-positive' : ''" t-esc="state.k.funnel_won or 0"/></div>
                                <div><dt>Perdidos</dt><dd t-att-class="state.k.funnel_lost &gt; 0 ? 'is-negative' : ''" t-esc="state.k.funnel_lost or 0"/></div>
                                <div><dt>Tasa de conversión</dt><dd t-esc="num(state.k.funnel_conversion_pct) + '%'"/></div>
                            </dl>
                        </article>
                    </section>

                    <!-- ═══ Tendencia ═══ -->
                    <section class="o_estate_dash__trend">
                        <article class="o_estate_card o_estate_trend">
                            <p class="o_estate_trend__label">Ventas</p>
                            <div class="o_estate_trend__row">
                                <span class="o_estate_trend__value" t-esc="state.k.trend_sales_current or 0"/>
                                <span class="o_estate_trend__chip" t-att-class="pctClass(state.k.trend_sales_pct)">
                                    <t t-esc="pctArrow(state.k.trend_sales_pct)"/> <t t-esc="num(state.k.trend_sales_pct)"/>%
                                </span>
                            </div>
                            <p class="o_estate_trend__prev">Período anterior: <t t-esc="state.k.trend_sales_prev or 0"/></p>
                        </article>
                        <article class="o_estate_card o_estate_trend">
                            <p class="o_estate_trend__label">Leads nuevos</p>
                            <div class="o_estate_trend__row">
                                <span class="o_estate_trend__value" t-esc="state.k.trend_leads_current or 0"/>
                                <span class="o_estate_trend__chip" t-att-class="pctClass(state.k.trend_leads_pct)">
                                    <t t-esc="pctArrow(state.k.trend_leads_pct)"/> <t t-esc="num(state.k.trend_leads_pct)"/>%
                                </span>
                            </div>
                            <p class="o_estate_trend__prev">Período anterior: <t t-esc="state.k.trend_leads_prev or 0"/></p>
                        </article>
                    </section>

                    <!-- ═══ Gráficos ═══ -->
                    <section class="o_estate_dash__grid">
                        <article class="o_estate_card">
                            <h2 class="o_estate_card__title">Ventas · últimos 6 meses</h2>
                            <DashChart data="state.salesChart"/>
                        </article>
                        <article class="o_estate_card">
                            <h2 class="o_estate_card__title">Leads · últimos 6 meses</h2>
                            <DashChart data="state.leadsChart"/>
                        </article>
                    </section>

                    <!-- ═══ Ranking ═══ -->
                    <section class="o_estate_card o_estate_rank">
                        <h2 class="o_estate_card__title">Ranking de asesores</h2>
                        <div class="table-responsive">
                            <table class="o_estate_rank__table">
                                <thead>
                                    <tr>
                                        <th class="text-start">Asesor</th>
                                        <th class="text-center">Ventas</th>
                                        <th class="text-end">Ingresos</th>
                                        <th class="text-end">Comisión</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.ranking" t-as="r" t-key="r_index">
                                        <td>
                                            <span class="o_estate_rank__pos" t-att-class="r_index &lt; 3 ? 'is-top' : ''" t-esc="r_index + 1"/>
                                            <span class="o_estate_rank__avatar" t-esc="(r.name or '?').slice(0, 1).toUpperCase()"/>
                                            <span class="o_estate_rank__name" t-esc="r.name"/>
                                        </td>
                                        <td class="text-center" t-esc="r.sales"/>
                                        <td class="text-end" t-esc="money(r.revenue)"/>
                                        <td class="text-end is-positive" t-esc="money(r.commission)"/>
                                    </tr>
                                    <tr t-if="!state.ranking.length">
                                        <td colspan="4" class="o_estate_rank__empty">Sin ventas registradas en el período</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                </t>
            </div>
        </div>
    </t>

</templates>
