<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_view_form_report_button" model="ir.ui.view">
        <field name="name">estate.property.form.report.button</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate_management.estate_property_view_form"/>
        <field name="arch" type="xml">
            <button name="action_calculate_avm" position="after">
                <button name="%(action_estate_ficha_wizard)d" string="Descargar Ficha PDF" type="action" class="btn-secondary" icon="fa-download"/>
                <button name="%(action_report_negocio_cerrado)d" string="Imprimir Negocio Cerrado" type="action"
                        class="btn-secondary" icon="fa-file-text-o"
                        invisible="state != 'sold'"/>
            </button>
        </field>
    </record>
</odoo>
