<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Cobros de comisiones (lo que pagan los propietarios) ─────────── -->
    <record id="view_sale_order_estate_collections_pivot" model="ir.ui.view">
        <field name="name">sale.order.pivot.estate.collections</field>
        <field name="model">sale.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Cobros de comisiones" sample="1">
                <field name="estate_collected_date" interval="month" type="row"/>
                <field name="estate_collected_method" type="col"/>
                <field name="amount_total" type="measure" string="Comisión cobrada"/>
            </pivot>
        </field>
    </record>

    <record id="view_sale_order_estate_collections_graph" model="ir.ui.view">
        <field name="name">sale.order.graph.estate.collections</field>
        <field name="model">sale.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <graph string="Cobros de comisiones" type="bar" stacked="1" sample="1">
                <field name="estate_collected_date" interval="month"/>
                <field name="estate_collected_method"/>
                <field name="amount_total" type="measure" string="Comisión cobrada"/>
            </graph>
        </field>
    </record>

    <record id="action_estate_report_collections" model="ir.actions.act_window">
        <field name="name">Cobros de Comisiones</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('property_id', '!=', False), ('state', '=', 'sale'), ('amount_total', '>', 0)]</field>
        <field name="context">{'search_default_estate_collected': 1, 'search_default_estate_group_collected_date': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('estate_management.view_sale_order_estate_collected_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_sale_order_estate_collections_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_sale_order_estate_collections_graph')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay comisiones cobradas.</p>
            <p>Cada cobro muestra la fecha, cómo pagó el propietario (efectivo, transferencia…)
               y si fue con o sin factura.</p>
        </field>
    </record>

    <!-- ── Pagos a asesores ──────────────────────────────────────────────── -->
    <record id="view_estate_commission_payouts_list" model="ir.ui.view">
        <field name="name">estate.commission.list.payouts</field>
        <field name="model">estate.commission</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Pagos a asesores" create="0" default_order="payment_date desc">
                <field name="payment_date" string="Fecha de pago"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="property_id"/>
                <field name="role"/>
                <field name="amount" string="Monto pagado" sum="Total pagado"/>
                <field name="payment_method"/>
                <field name="payment_reference" optional="show"/>
                <field name="invoice_id" string="Factura" optional="show"/>
                <field name="paid_by_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_estate_commission_payouts_pivot" model="ir.ui.view">
        <field name="name">estate.commission.pivot.payouts</field>
        <field name="model">estate.commission</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Pagos a asesores" sample="1">
                <field name="user_id" type="row"/>
                <field name="payment_method" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_estate_report_payouts" model="ir.actions.act_window">
        <field name="name">Pagos a Asesores</field>
        <field name="res_model">estate.commission</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('state', '=', 'paid')]</field>
        <field name="context">{'search_default_group_payment_month': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_estate_commission_payouts_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_estate_commission_payouts_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay pagos a asesores.</p>
            <p>Cada pago muestra a quién, por qué propiedad y paso, cuánto, cómo se pagó y su comprobante.</p>
        </field>
    </record>
</odoo>
