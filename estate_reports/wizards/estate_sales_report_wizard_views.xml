<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_sales_report_wizard_view_form" model="ir.ui.view">
        <field name="name">estate.sales.report.wizard.form</field>
        <field name="model">estate.sales.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Promedio de Ventas" create="false" delete="false">
                <sheet>

                    <!-- Stat buttons: KPIs + exportar -->
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-hashtag"
                                type="object" name="action_open_detail"
                                invisible="not has_data">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="kpi_count" readonly="1"/>
                                </span>
                                <span class="o_stat_text">Operaciones</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-dollar"
                                type="object" name="action_open_detail"
                                invisible="not has_data">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="kpi_avg_price" widget="monetary" readonly="1"/>
                                </span>
                                <span class="o_stat_text">Precio Promedio</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-calendar"
                                type="object" name="action_open_detail"
                                invisible="not has_data">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="kpi_avg_days" readonly="1"/>
                                </span>
                                <span class="o_stat_text">Días Promedio</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-percent"
                                type="object" name="action_open_detail"
                                invisible="not has_data">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="kpi_close_rate" widget="percentage" readonly="1"/>
                                </span>
                                <span class="o_stat_text">Tasa de Cierre</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-file-pdf-o"
                                type="object" name="action_generate_pdf"
                                invisible="not has_data">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Descargar PDF</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-file-excel-o"
                                type="object" name="action_generate_xlsx"
                                invisible="not has_data">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Descargar Excel</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-bar-chart"
                                type="object" name="action_open_graph">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Gráfico</span>
                            </div>
                        </button>
                    </div>

                    <!-- Título -->
                    <div class="oe_title">
                        <h1>Promedio de Ventas</h1>
                    </div>

                    <!-- Filtros -->
                    <group string="Filtros">
                        <group>
                            <field name="period"/>
                            <field name="date_from"
                                   invisible="period != 'custom'"
                                   required="period == 'custom'"/>
                            <field name="date_to"
                                   invisible="period != 'custom'"
                                   required="period == 'custom'"/>
                            <field name="operation_type" widget="radio"
                                   options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="property_type_ids" widget="many2many_tags"/>
                            <field name="city" placeholder="Todas las ciudades"/>
                            <field name="user_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <!-- Sin datos -->
                    <div class="alert alert-info" role="alert" invisible="has_data">
                        <i class="fa fa-info-circle" title="Sin datos"/>
                        <strong>Sin operaciones en el período seleccionado.</strong>
                        Ajuste los filtros o el rango de fechas.
                    </div>

                    <!-- Resultados -->
                    <div invisible="not has_data">

                        <div class="o_horizontal_separator">Indicadores del Período</div>

                        <group>
                            <group string="Precios">
                                <field name="kpi_avg_price" widget="monetary" readonly="1"
                                       string="Precio promedio"/>
                                <field name="kpi_median_price" widget="monetary" readonly="1"
                                       string="Mediana"/>
                                <field name="kpi_min_price" widget="monetary" readonly="1"
                                       string="Mínimo"/>
                                <field name="kpi_max_price" widget="monetary" readonly="1"
                                       string="Máximo"/>
                            </group>
                            <group string="Rendimiento">
                                <field name="kpi_avg_listed" widget="monetary" readonly="1"
                                       string="Precio listado promedio"/>
                                <field name="kpi_pct_vs_listed" widget="percentage" readonly="1"
                                       string="% logrado vs listado"/>
                                <field name="kpi_avg_days" readonly="1"
                                       string="Días promedio en mercado"/>
                                <field name="kpi_close_rate" widget="percentage" readonly="1"
                                       string="Tasa de cierre"/>
                            </group>
                        </group>

                        <div class="o_horizontal_separator">Comparativa con Período Anterior</div>

                        <group>
                            <group string="Precios">
                                <field name="prev_avg_price" widget="monetary" readonly="1"
                                       string="Promedio anterior"/>
                                <field name="pct_change_avg" widget="percentage" readonly="1"
                                       string="Variación %"/>
                            </group>
                            <group string="Tiempo en Mercado">
                                <field name="prev_avg_days" readonly="1"
                                       string="Días anteriores"/>
                                <field name="pct_change_days" readonly="1"
                                       string="Cambio en días"/>
                            </group>
                        </group>

                    </div>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_estate_sales_report_wizard" model="ir.actions.act_window">
        <field name="name">Promedio de Ventas</field>
        <field name="res_model">estate.sales.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>
