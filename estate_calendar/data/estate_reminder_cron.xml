<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Avisos de recordatorios de clientes (pólizas, cuotas, renovaciones).
         Corre cada hora: la anticipación se define recordatorio por recordatorio
         en días, así que basta con revisar unas cuantas veces al día. -->
    <record id="cron_notify_client_reminders" model="ir.cron">
        <field name="name">Recordatorios de clientes: enviar avisos</field>
        <field name="model_id" ref="model_estate_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
