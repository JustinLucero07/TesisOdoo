<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Avisos de recordatorios de clientes (pólizas, cuotas, renovaciones).
         Corre cada 15 minutos porque la anticipación puede pedirse en minutos;
         la consulta va por índice sobre notify_datetime y state. -->
    <record id="cron_notify_client_reminders" model="ir.cron">
        <field name="name">Recordatorios de clientes: enviar avisos</field>
        <field name="model_id" ref="model_estate_reminder"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_reminders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
