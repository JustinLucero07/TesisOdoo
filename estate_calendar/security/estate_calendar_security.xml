<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Indisponibilidad ("día ocupado"): cada asesor gestiona SOLO la suya -->
        <record id="rule_unavailability_agent" model="ir.rule">
            <field name="name">Indisponibilidad: el asesor solo ve/gestiona la suya</field>
            <field name="model_id" ref="model_estate_advisor_unavailability"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('estate_management.estate_group_agent'))]"/>
        </record>

        <!-- Gerente/Administrador ven y gestionan la indisponibilidad de todos -->
        <record id="rule_unavailability_manager" model="ir.rule">
            <field name="name">Indisponibilidad: gerente/admin ven todas</field>
            <field name="model_id" ref="model_estate_advisor_unavailability"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('estate_management.estate_group_manager'))]"/>
        </record>

    </data>
</odoo>
