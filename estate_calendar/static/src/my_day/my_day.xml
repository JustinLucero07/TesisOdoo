<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="estate_calendar.MyDay">
        <div class="o_ix_myday">
            <div class="o_ix_myday__inner">
                <header class="o_ix_myday__head">
                    <div>
                        <p class="o_ix_myday__date" t-esc="state.data.date_label"/>
                        <h1 class="o_ix_myday__title" t-esc="state.data.greeting or 'Mi día'"/>
                    </div>
                    <div class="o_ix_myday__quick">
                        <button class="btn btn-primary" t-on-click="() =&gt; this.newRecord('crm.lead', {default_type: 'opportunity'})">
                            <i class="fa fa-user-plus me-1"/>Nuevo lead
                        </button>
                        <button class="btn btn-secondary" t-on-click="() =&gt; this.newRecord('estate.property')">
                            <i class="fa fa-home me-1"/>Nueva propiedad
                        </button>
                        <button class="btn btn-secondary" t-on-click="() =&gt; this.newRecord('calendar.event', {default_appointment_type: 'visit'})">
                            <i class="fa fa-calendar-plus-o me-1"/>Agendar visita
                        </button>
                    </div>
                </header>

                <div t-if="state.loading" class="o_ix_myday__grid">
                    <span class="o_ix_skeleton"/><span class="o_ix_skeleton"/>
                    <span class="o_ix_skeleton"/><span class="o_ix_skeleton"/>
                </div>

                <t t-else="">
                    <section class="o_ix_myday__stats">
                        <div class="o_ix_stat">
                            <span class="o_ix_stat__value" t-esc="state.data.citas.length"/>
                            <span class="o_ix_stat__label">Citas hoy</span>
                        </div>
                        <div class="o_ix_stat">
                            <span class="o_ix_stat__value" t-esc="state.data.recordatorios.length"/>
                            <span class="o_ix_stat__label">Recordatorios (7 días)</span>
                        </div>
                        <div class="o_ix_stat" t-att-class="state.data.leads.length ? 'is-hot' : ''">
                            <span class="o_ix_stat__value" t-esc="state.data.leads.length"/>
                            <span class="o_ix_stat__label">Leads calientes</span>
                        </div>
                        <div class="o_ix_stat" t-att-class="state.data.activities_late ? 'is-late' : ''">
                            <span class="o_ix_stat__value" t-esc="state.data.activities_late"/>
                            <span class="o_ix_stat__label">Actividades atrasadas</span>
                        </div>
                        <button t-if="state.data.is_manager and state.data.cobros" class="o_ix_stat o_ix_stat--link"
                                t-on-click="() =&gt; this.openXml('estate_management.action_sale_order_estate_to_collect')">
                            <span class="o_ix_stat__value" t-esc="money(state.data.cobros.amount)"/>
                            <span class="o_ix_stat__label">Por cobrar (<t t-esc="state.data.cobros.count"/>)</span>
                        </button>
                    </section>

                    <section class="o_ix_myday__grid">
                        <!-- Citas -->
                        <article class="o_ix_panel">
                            <h2 class="o_ix_panel__title"><i class="fa fa-calendar"/>Citas de hoy</h2>
                            <ul t-if="state.data.citas.length" class="o_ix_list">
                                <li t-foreach="state.data.citas" t-as="c" t-key="c.id" t-on-click="() =&gt; this.openRecord('calendar.event', c.id)">
                                    <span class="o_ix_list__time" t-esc="c.hour"/>
                                    <span class="o_ix_list__main">
                                        <span class="o_ix_list__name" t-esc="c.client or c.name"/>
                                        <span class="o_ix_list__sub" t-esc="c.property or c.type"/>
                                    </span>
                                    <span t-attf-class="o_ix_pill o_ix_pill--{{ c.state }}" t-esc="stateLabel(c.state)"/>
                                </li>
                            </ul>
                            <p t-else="" class="o_ix_empty">No tienes citas para hoy.</p>
                        </article>

                        <!-- Leads calientes -->
                        <article class="o_ix_panel">
                            <h2 class="o_ix_panel__title"><i class="fa fa-fire"/>Leads que esperan respuesta</h2>
                            <ul t-if="state.data.leads.length" class="o_ix_list">
                                <li t-foreach="state.data.leads" t-as="l" t-key="l.id" t-on-click="() =&gt; this.openRecord('crm.lead', l.id)">
                                    <span t-attf-class="o_ix_dot o_ix_dot--{{ l.temperature }}"/>
                                    <span class="o_ix_list__main">
                                        <span class="o_ix_list__name" t-esc="l.name"/>
                                        <span class="o_ix_list__sub" t-esc="l.property or 'Sin propiedad de interés'"/>
                                    </span>
                                    <span class="o_ix_list__meta" t-esc="l.temperature_label"/>
                                </li>
                            </ul>
                            <p t-else="" class="o_ix_empty">Ningún lead caliente pendiente. ¡Bien!</p>
                        </article>

                        <!-- Recordatorios -->
                        <article class="o_ix_panel">
                            <h2 class="o_ix_panel__title"><i class="fa fa-bell-o"/>Recordatorios</h2>
                            <ul t-if="state.data.recordatorios.length" class="o_ix_list">
                                <li t-foreach="state.data.recordatorios" t-as="r" t-key="r.id" t-on-click="() =&gt; this.openRecord('estate.reminder', r.id)">
                                    <span class="o_ix_list__time" t-esc="r.date"/>
                                    <span class="o_ix_list__main">
                                        <span class="o_ix_list__name" t-esc="r.name"/>
                                        <span class="o_ix_list__sub" t-esc="r.client"/>
                                    </span>
                                    <span t-attf-class="o_ix_pill o_ix_pill--{{ r.urgency }}" t-esc="reminderWhen(r)"/>
                                </li>
                            </ul>
                            <p t-else="" class="o_ix_empty">Sin recordatorios para esta semana.</p>
                        </article>

                        <!-- Actividades -->
                        <article class="o_ix_panel">
                            <h2 class="o_ix_panel__title"><i class="fa fa-check-square-o"/>Actividades para hoy</h2>
                            <ul t-if="state.data.actividades.length" class="o_ix_list">
                                <li t-foreach="state.data.actividades" t-as="a" t-key="a.id" t-on-click="() =&gt; this.openRecord(a.model, a.res_id)">
                                    <span t-attf-class="o_ix_dot {{ a.late ? 'o_ix_dot--boiling' : 'o_ix_dot--warm' }}"/>
                                    <span class="o_ix_list__main">
                                        <span class="o_ix_list__name" t-esc="a.summary"/>
                                        <span class="o_ix_list__sub" t-esc="a.record"/>
                                    </span>
                                    <span class="o_ix_list__meta" t-esc="a.late ? 'Atrasada' : 'Hoy'"/>
                                </li>
                            </ul>
                            <p t-else="" class="o_ix_empty">Estás al día con tus actividades.</p>
                        </article>
                    </section>
                </t>
            </div>
        </div>
    </t>
</templates>
