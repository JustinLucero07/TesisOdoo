<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== FORM VIEW INHERIT ==================== -->
    <record id="view_calendar_event_form_inherit_estate" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.estate</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_right oe_button_box" name="visit_buttons" invisible="property_id == False">
                    <button name="action_done_visit" string=" Visita Realizada" type="object" class="oe_stat_button" icon="fa-check" invisible="visit_state != 'scheduled'"/>
                    <button name="action_send_whatsapp_followup" string=" WhatsApp Seguimiento" type="object" class="oe_stat_button" icon="fa-whatsapp" invisible="visit_state != 'done' or whatsapp_sent == True"/>
                    <button name="action_send_survey_whatsapp" string=" Encuesta Satisfacción" type="object" class="oe_stat_button" icon="fa-star" invisible="visit_state != 'done' or survey_sent == True" title="Envía encuesta de 1-5 estrellas al cliente por WhatsApp"/>
                    <button name="action_cancel_visit" string=" Cancelar Visita" type="object" class="oe_stat_button" icon="fa-times" invisible="visit_state != 'scheduled'" confirm="¿Está seguro de cancelar esta visita?"/>
                    <button name="action_schedule_visit" string=" Re-programar" type="object" class="oe_stat_button" icon="fa-refresh" invisible="visit_state == 'scheduled'"/>
                </div>
                <field name="visit_state" widget="statusbar" statusbar_visible="scheduled,done" invisible="property_id == False"/>
            </xpath>

            <xpath expr="//field[@name='location']" position="after">
                <field name="appointment_type" widget="radio" options="{'horizontal': true}"/>
                <field name="property_id" options="{'no_create': True}"/>
                <field name="partner_id" options="{'no_create': True}"/>
                <field name="lead_id" domain="[('type','=','opportunity')]"
                       options="{'no_create': True}"
                       placeholder="Lead CRM relacionado (opcional)"/>

                <!-- Datos clave: sin necesidad de abrir la propiedad o el contacto -->
                <group string="Datos Clave" invisible="property_id == False">
                    <group string="Propiedad">
                        <field name="property_price" widget="monetary" readonly="1"
                               string="Precio de venta"/>
                        <field name="property_type_name" readonly="1"
                               string="Tipo"/>
                        <field name="property_owner_name" readonly="1"
                               string="Propietario"/>
                        <field name="property_owner_phone" readonly="1" widget="phone"
                               string="Tel. Propietario"/>
                    </group>
                    <group string="Cliente" invisible="partner_id == False">
                        <field name="client_phone" readonly="1" widget="phone"
                               string="Teléfono"/>
                        <field name="client_mobile" readonly="1" widget="phone"
                               string="Celular"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string=" Resultado de la Visita" invisible="visit_state != 'done' or property_id == False">
                    <group>
                        <field name="visit_result" widget="radio"/>
                    </group>
                    <group>
                        <field name="visit_rating" widget="priority"/>
                    </group>
                    <field name="visit_notes" placeholder="Observaciones de la visita..."/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- ==================== QUICK CREATE VIEW INHERIT ==================== -->
    <record id="view_calendar_event_form_quick_create_inherit_estate" model="ir.ui.view">
        <field name="name">calendar.event.form.quick_create.inherit.estate</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='allday']" position="after">
                <field name="appointment_type" widget="radio" options="{'horizontal': true}"/>
                <field name="property_id" options="{'no_create': True}" placeholder="Seleccionar Propiedad..."/>
                <field name="partner_id" options="{'no_create': True}" placeholder="Seleccionar Cliente..."/>
            </xpath>
        </field>
    </record>

    <!-- ==================== CALENDAR VIEW INHERIT ==================== -->
    <record id="view_calendar_event_calendar_inherit_estate" model="ir.ui.view">
        <field name="name">calendar.event.calendar.inherit.estate</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="color">visit_color</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_ids']" position="after">
                <field name="property_id" filters="1"/>
                <field name="visit_state" filters="1" invisible="1"/>
                <field name="appointment_type" filters="1" invisible="1"/>
                <field name="visit_color" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- ==================== TREE VIEW INHERIT ==================== -->
    <record id="view_calendar_event_tree_inherit_estate" model="ir.ui.view">
        <field name="name">calendar.event.tree.inherit.estate</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="appointment_type" widget="badge"
                       decoration-info="appointment_type == 'visit'"
                       decoration-warning="appointment_type == 'call'"
                       decoration-success="appointment_type == 'signing'"
                       optional="show"/>
                <field name="property_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="visit_state" widget="badge"
                       decoration-success="visit_state == 'done'"
                       decoration-info="visit_state == 'scheduled'"
                       decoration-danger="visit_state == 'cancelled'"
                       invisible="property_id == False" optional="show"/>
                <field name="visit_result" widget="badge"
                       decoration-success="visit_result == 'offer_made'"
                       decoration-info="visit_result == 'interested'"
                       decoration-warning="visit_result == 'follow_up'"
                       decoration-danger="visit_result == 'not_interested'"
                       optional="hide"/>
                <field name="visit_rating" widget="priority" optional="hide"/>
                <field name="visit_color" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW INHERIT ==================== -->
    <record id="view_calendar_event_search_inherit_estate" model="ir.ui.view">
        <field name="name">calendar.event.search.inherit.estate</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='mymeetings']" position="after">
                <separator/>
                <filter name="filter_visits" string="Visitas Inmobiliarias" domain="[('property_id', '!=', False)]"/>
                <filter name="filter_visits_done" string="Visitas Realizadas" domain="[('property_id', '!=', False), ('visit_state', '=', 'done')]"/>
                <filter name="filter_visits_scheduled" string="Visitas Programadas" domain="[('property_id', '!=', False), ('visit_state', '=', 'scheduled')]"/>
                <separator/>
                <filter name="filter_today" string="Hoy" domain="[('start', '&gt;=', context_today().strftime('%Y-%m-%d')), ('start', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_week" string="Esta Semana" domain="[('start', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('start', '&lt;', (context_today() + relativedelta(days=7 - context_today().weekday())).strftime('%Y-%m-%d'))]"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <separator/>
                <filter name="group_by_state" string="Estado de Visita" context="{'group_by': 'visit_state'}"/>
                <filter name="group_by_type" string="Tipo de Cita" context="{'group_by': 'appointment_type'}"/>
                <filter name="group_by_property" string="Propiedad" context="{'group_by': 'property_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- ==================== SPECIALIZED TREE VIEW FOR VISITS ==================== -->
    <record id="view_calendar_event_tree_visits" model="ir.ui.view">
        <field name="name">calendar.event.tree.visits</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list string="Visitas Realizadas" decoration-success="visit_state == 'done'" create="false">
                <field name="visit_state" column_invisible="True"/>
                <field name="name" string="Asunto"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="start" string="Fecha"/>
                <field name="appointment_type" widget="badge"/>
                <field name="visit_result" widget="badge" decoration-success="visit_result == 'offer_made'" decoration-info="visit_result == 'interested'" decoration-warning="visit_result == 'follow_up'" decoration-danger="visit_result == 'not_interested'"/>
                <field name="visit_rating" widget="priority"/>
            </list>
        </field>
    </record>

    <!-- ==================== KANBAN VIEW FOR VISITS ==================== -->
    <record id="view_calendar_event_kanban_visits" model="ir.ui.view">
        <field name="name">calendar.event.kanban.visits</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <kanban default_group_by="visit_state" class="o_kanban_small_column"
                    group_create="false" group_delete="false">
                <field name="visit_state"/>
                <field name="visit_color"/>
                <field name="appointment_type"/>
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="visit_result"/>
                <field name="visit_rating"/>
                <progressbar field="visit_result"
                    colors='{"offer_made": "success", "interested": "info", "follow_up": "warning", "not_interested": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <!-- Top: time + type badge -->
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <small class="text-muted fw-semibold">
                                    <t t-esc="record.start.value ? record.start.value.substr(11,5) : '—'"/>
                                    <t t-if="record.stop.value"> – <t t-esc="record.stop.value.substr(11,5)"/></t>
                                </small>
                                <span t-if="record.appointment_type.value"
                                      class="badge"
                                      t-attf-class="badge #{record.appointment_type.raw_value == 'visit' ? 'text-bg-primary' : record.appointment_type.raw_value == 'signing' ? 'text-bg-success' : record.appointment_type.raw_value == 'call' ? 'text-bg-warning' : 'text-bg-secondary'}">
                                    <t t-esc="record.appointment_type.value"/>
                                </span>
                            </div>
                            <!-- Property -->
                            <div class="fw-bold text-truncate mb-1" t-if="record.property_id.value">
                                <i class="fa fa-home me-1 text-primary"/>
                                <t t-esc="record.property_id.value"/>
                            </div>
                            <!-- Client -->
                            <div class="text-truncate mb-2" t-if="record.partner_id.value">
                                <i class="fa fa-user me-1 text-muted"/>
                                <t t-esc="record.partner_id.value"/>
                            </div>
                            <!-- Bottom: advisor + rating -->
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="fa fa-user-tie me-1"/>
                                    <t t-esc="record.user_id.value or '—'"/>
                                </small>
                                <div t-if="record.visit_rating.raw_value">
                                    <t t-foreach="[1,2,3,4,5]" t-as="s">
                                        <i t-att-class="'fa fa-star' + (s &lt;= record.visit_rating.raw_value ? ' text-warning' : ' text-muted')" t-att-title="'Calificación ' + s"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== ACTIONS ==================== -->
    <!-- Restaurar acción base pero con filtros extra opcionales -->
    <record id="calendar.action_calendar_event" model="ir.actions.act_window">
        <field name="context">{'search_default_mymeetings': 1}</field>
    </record>

    <!-- Acción específica para Visitas Realizadas -->
    <record id="estate_appointment_done_action" model="ir.actions.act_window">
        <field name="name">Visitas Realizadas</field>
        <field name="res_model" >calendar.event</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="domain">[('property_id', '!=', False), ('visit_state', '=', 'done')]</field>
        <field name="view_id" ref="view_calendar_event_tree_visits"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay visitas inmobiliarias marcadas como realizadas aún.
            </p>
        </field>
    </record>

    <!-- Acción Pipeline de Visitas (Kanban) -->
    <record id="estate_visit_pipeline_action" model="ir.actions.act_window">
        <field name="name">Pipeline de Visitas</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">kanban,list,calendar,form</field>
        <field name="domain">[('property_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_visits': 1}</field>
        <field name="views" eval="[
            (ref('view_calendar_event_kanban_visits'), 'kanban'),
            (ref('view_calendar_event_tree_visits'), 'list'),
            (False, 'calendar'),
            (False, 'form'),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay visitas inmobiliarias registradas.
            </p>
            <p>Crea una visita desde el Calendario o desde el CRM.</p>
        </field>
    </record>
</odoo>
