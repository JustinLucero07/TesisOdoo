<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== LIST ==================== -->
    <record id="estate_reminder_view_tree" model="ir.ui.view">
        <field name="name">estate.reminder.list</field>
        <field name="model">estate.reminder</field>
        <field name="arch" type="xml">
            <list string="Recordatorios"
                  decoration-danger="urgency == 'overdue'"
                  decoration-warning="urgency in ('today', 'soon')"
                  decoration-muted="state != 'pending'">
                <field name="date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="reminder_type"/>
                <field name="property_id" optional="hide"/>
                <field name="days_before" optional="hide"/>
                <field name="notify_date" optional="show" string="Avisa el"/>
                <field name="days_left" string="Días" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="advance_notified" optional="hide" widget="boolean"/>
                <field name="urgency" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"
                       decoration-info="state == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM ==================== -->
    <record id="estate_reminder_view_form" model="ir.ui.view">
        <field name="name">estate.reminder.form</field>
        <field name="model">estate.reminder</field>
        <field name="arch" type="xml">
            <form string="Recordatorio">
                <header>
                    <button name="action_done" string="Marcar como hecho" type="object"
                            class="btn-success" icon="fa-check"
                            invisible="state != 'pending'"/>
                    <button name="action_notify_now" string="Avisar ahora" type="object"
                            class="btn-secondary" icon="fa-bell"
                            invisible="state != 'pending'"
                            help="Envía el aviso de inmediato, sin esperar al cron."/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state != 'pending'"/>
                    <button name="action_reset" string="Reabrir" type="object"
                            invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="VENCIDO" bg_color="text-bg-danger"
                            invisible="urgency != 'overdue'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej: Vence la póliza de incendios"/></h1>
                    </div>
                    <group>
                        <group string="¿A quién y de qué?">
                            <field name="partner_id"
                                   placeholder="Buscar cliente..."
                                   options="{'no_create_edit': True}"/>
                            <field name="reminder_type"/>
                            <field name="property_id" placeholder="Opcional"/>
                            <field name="lead_id" placeholder="Opcional"/>
                        </group>
                        <group string="¿Cuándo avisar?">
                            <field name="date"/>
                            <field name="days_before"/>
                            <field name="notify_date" readonly="1"/>
                            <field name="days_left" readonly="1"/>
                            <field name="urgency" invisible="1"/>
                        </group>
                        <group string="Responsable">
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="notify_push"/>
                            <field name="notify_activity"/>
                        </group>
                        <group string="Seguimiento">
                            <field name="advance_notified" readonly="1"/>
                            <field name="due_notified" readonly="1"/>
                            <field name="last_notified_on" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="note" placeholder="Detalles, número de póliza, contacto de la aseguradora..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== CALENDAR ==================== -->
    <record id="estate_reminder_view_calendar" model="ir.ui.view">
        <field name="name">estate.reminder.calendar</field>
        <field name="model">estate.reminder</field>
        <field name="arch" type="xml">
            <calendar string="Recordatorios" date_start="date" color="reminder_type"
                      mode="month" quick_create="0">
                <field name="partner_id"/>
                <field name="user_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- ==================== SEARCH ==================== -->
    <record id="estate_reminder_view_search" model="ir.ui.view">
        <field name="name">estate.reminder.search</field>
        <field name="model">estate.reminder</field>
        <field name="arch" type="xml">
            <search string="Buscar recordatorios">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="property_id"/>
                <filter name="filter_mine" string="Míos"
                        domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_pending" string="Pendientes"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="filter_overdue" string="Vencidos"
                        domain="[('state', '=', 'pending'), ('date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_soon" string="Por avisar"
                        domain="[('state', '=', 'pending'), ('notify_date', '&lt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_done" string="Hechos" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'reminder_type'}"/>
                    <filter name="group_user" string="Responsable" context="{'group_by': 'user_id'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== ACCIÓN ==================== -->
    <record id="action_estate_reminder" model="ir.actions.act_window">
        <field name="name">Recordatorios de Clientes</field>
        <field name="res_model">estate.reminder</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="estate_reminder_view_search"/>
        <field name="context">{'search_default_filter_pending': 1, 'search_default_filter_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer recordatorio</p>
            <p>Vencimientos de pólizas, cuotas, renovaciones de contrato o cualquier
               fecha de un cliente. Odoo te avisa con la anticipación que definas,
               en la campanita y en tu celular.</p>
        </field>
    </record>

    <menuitem id="estate_menu_reminders"
              name="Recordatorios de Clientes"
              parent="estate_management.estate_menu_planning_root"
              action="action_estate_reminder"
              sequence="25"/>

    <!-- ==================== BOTÓN EN EL CLIENTE ==================== -->
    <record id="view_partner_form_inherit_reminders" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.estate.reminders</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_reminders" type="object"
                        class="oe_stat_button" icon="fa-bell-o">
                    <field name="reminder_count" string="Recordatorios" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
