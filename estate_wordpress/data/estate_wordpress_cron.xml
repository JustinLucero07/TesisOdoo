<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Re-sincroniza con WordPress las propiedades publicadas que cambiaron.
         Solo actúa si "Re-sincronización automática" está activa en Ajustes. -->
    <record id="cron_wp_resync" model="ir.cron">
        <field name="name">WordPress: re-sincronizar propiedades con cambios</field>
        <field name="model_id" ref="estate_management.model_estate_property"/>
        <field name="state">code</field>
        <field name="code">model._cron_wp_resync()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Limpieza y verificación periódica: despublica propiedades vendidas, arrendadas, canceladas o inactivas de WordPress -->
    <record id="cron_wp_unpublish_sold" model="ir.cron">
        <field name="name">WordPress: despublicar propiedades vendidas/retiradas pendientes</field>
        <field name="model_id" ref="estate_management.model_estate_property"/>
        <field name="state">code</field>
        <field name="code">model._cron_unpublish_sold_properties()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
