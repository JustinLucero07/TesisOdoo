<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de reporte: Recibo de Nómina (PDF) -->
    <record id="action_report_estate_payroll" model="ir.actions.report">
        <field name="name">Recibo de Nómina</field>
        <field name="model">estate.payroll.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate_payroll.report_payroll_slip</field>
        <field name="report_file">estate_payroll.report_payroll_slip</field>
        <field name="binding_model_id" ref="model_estate_payroll_line"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Recibo - %s' % (object.name or '')</field>
    </record>

    <!-- Plantilla del recibo -->
    <template id="report_payroll_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="mt-2">Recibo de Nómina</h2>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Asesor:</strong> <span t-field="o.user_id.name"/><br/>
                                <strong>Empleado:</strong> <span t-field="o.employee_id.name"/><br/>
                                <strong>Documento:</strong> <span t-field="o.name"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Período:</strong>
                                <span t-esc="dict(o._fields['period_month'].selection).get(o.period_month, o.period_month)"/>
                                / <span t-field="o.period_year"/><br/>
                                <strong>Estado:</strong>
                                <span t-esc="dict(o._fields['state'].selection).get(o.state, o.state)"/>
                            </div>
                        </div>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Concepto</th>
                                    <th class="text-end">Ingresos</th>
                                    <th class="text-end">Deducciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Sueldo Base</td>
                                    <td class="text-end"><span t-field="o.base_salary"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td/>
                                </tr>
                                <tr>
                                    <td>Bono de Comisiones</td>
                                    <td class="text-end"><span t-field="o.commission_bonus"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td/>
                                </tr>
                                <tr>
                                    <td>Subsidio de Transporte</td>
                                    <td class="text-end"><span t-field="o.transport_allowance"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td/>
                                </tr>
                                <tr>
                                    <td>Otros Ingresos</td>
                                    <td class="text-end"><span t-field="o.other_income"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                    <td/>
                                </tr>
                                <tr>
                                    <td>Aporte IESS (personal)</td>
                                    <td/>
                                    <td class="text-end"><span t-field="o.iess_personal"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>Anticipo / Préstamo</td>
                                    <td/>
                                    <td class="text-end"><span t-field="o.advance_deduction"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>Otras Deducciones</td>
                                    <td/>
                                    <td class="text-end"><span t-field="o.other_deduction"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="border-top:2px solid #000;">
                                    <td><strong>Totales</strong></td>
                                    <td class="text-end"><strong><span t-field="o.gross_salary"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td>
                                    <td class="text-end"><strong><span t-field="o.total_deductions"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-3">
                            <div class="col-6 offset-6 text-end">
                                <h4>Neto a Pagar:
                                    <span t-field="o.net_salary"
                                        t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </h4>
                            </div>
                        </div>

                        <p t-if="o.notes" class="mt-3"><strong>Notas:</strong> <span t-field="o.notes"/></p>

                        <div class="row mt-5">
                            <div class="col-6 text-center">
                                <br/><br/>______________________________<br/>
                                <span t-field="o.user_id.name"/><br/>Recibí conforme
                            </div>
                            <div class="col-6 text-center">
                                <br/><br/>______________________________<br/>
                                <span t-field="o.company_id.name"/><br/>Empleador
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
