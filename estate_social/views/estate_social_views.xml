<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Botones de redes sociales en el formulario de propiedad -->
    <record id="estate_property_social_buttons" model="ir.ui.view">
        <field name="name">estate.property.social.buttons</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate_management.estate_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Redes Sociales" name="social">

                    <group string="Publicar en Redes Sociales">
                        <div class="o_field_widget text-center py-3">
                            <h5 class="text-muted mb-2">Publicación automática vía API</h5>
                            <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                                <button name="action_publish_facebook"
                                        string="Publicar en Facebook"
                                        type="object" class="btn btn-primary"
                                        confirm="¿Publicar esta propiedad en tu página de Facebook?"
                                        invisible="fb_published"/>
                                <button name="action_publish_facebook"
                                        string="Re-publicar en Facebook"
                                        type="object" class="btn btn-outline-primary"
                                        confirm="¿Crear una nueva publicación en Facebook? La publicación anterior seguirá en tu página."
                                        invisible="not fb_published"/>
                                <button name="action_unpublish_facebook"
                                        string="Eliminar de Facebook"
                                        type="object" class="btn btn-outline-danger"
                                        confirm="¿Eliminar el post de Facebook?"
                                        invisible="not fb_published"/>
                                <button name="action_publish_instagram"
                                        string="Publicar en Instagram"
                                        type="object" class="btn btn-warning"
                                        confirm="¿Publicar esta propiedad en Instagram Business?"
                                        invisible="ig_published"/>
                            </div>
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <field name="fb_published" widget="boolean_toggle" nolabel="1"/>
                                <span class="text-muted small me-3">Facebook</span>
                                <field name="ig_published" widget="boolean_toggle" nolabel="1"/>
                                <span class="text-muted small">Instagram</span>
                            </div>
                        </div>
                    </group>

                    <group string="Compartir manualmente">
                        <div class="o_field_widget text-center py-3">
                            <div class="d-flex flex-wrap justify-content-center gap-2">
                                <button name="action_share_facebook"
                                        string="Compartir en Facebook"
                                        type="object" class="btn btn-outline-primary"/>
                                <button name="action_share_whatsapp"
                                        string="WhatsApp (difusión)"
                                        type="object" class="btn btn-outline-success"/>
                                <button name="action_whatsapp_business_contact"
                                        string="WhatsApp Business"
                                        type="object" class="btn btn-outline-success"/>
                                <button name="action_share_instagram"
                                        string="Copiar caption Instagram"
                                        type="object" class="btn btn-outline-warning"/>
                                <button name="action_share_twitter"
                                        string="Twitter/X"
                                        type="object" class="btn btn-outline-info"/>
                            </div>
                        </div>
                    </group>

                    <!-- Registro de publicaciones personales de asesores -->
                    <group string="Publicaciones Personales de Asesores (Facebook e Instagram)">
                        <div class="px-2 pb-2">
                            <p class="text-muted small mb-2">
                                Registra cada vez que publiques esta propiedad en tu
                                <strong>perfil personal</strong> de Facebook o Instagram.
                                El sistema lleva el conteo por asesor y plataforma.
                            </p>
                            <!-- Botones de registro rápido con un solo clic -->
                            <div class="d-flex gap-2 mb-3">
                                <button name="action_log_personal_post_fb"
                                        type="object"
                                        class="btn btn-sm btn-primary"
                                        title="Registra que publicaste ahora en tu Facebook personal">
                                    <i class="fa fa-facebook-square" title="Facebook"/> Publiqué en Facebook
                                </button>
                                <button name="action_log_personal_post_ig"
                                        type="object"
                                        class="btn btn-sm"
                                        style="background:#E4405F;color:white;border:none"
                                        title="Registra que publicaste ahora en tu Instagram personal">
                                    <i class="fa fa-instagram" title="Instagram"/> Publiqué en Instagram
                                </button>
                            </div>
                            <field name="advisor_fb_post_ids" nolabel="1">
                                <list editable="bottom" string="Historial de publicaciones">
                                    <field name="platform" widget="badge"
                                           decoration-primary="platform == 'facebook'"
                                           decoration-danger="platform == 'instagram'"/>
                                    <field name="published_date"/>
                                    <field name="user_id" readonly="1"/>
                                    <field name="url" widget="url" placeholder="https://..."/>
                                    <field name="notes" placeholder="Alcance, me gustas, comentarios..."/>
                                </list>
                            </field>
                        </div>
                    </group>

                    <!-- Enlaces para el Bot (n8n) -->
                    <group string="Enlaces del Bot (n8n)">
                        <div class="px-2 pb-2">
                            <p class="text-muted small mb-2">
                                Agrega aquí los enlaces de las publicaciones para que el Bot (n8n) pueda buscarlos y encontrar esta propiedad automáticamente.
                            </p>
                            <field name="bot_link_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="url" widget="url"/>
                                </list>
                            </field>
                        </div>
                    </group>

                </page>
            </xpath>
        </field>
    </record>
</odoo>
