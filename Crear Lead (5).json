        "url": "=http://{{ $('Preparar Datos').item.json.odoo_host }}:8069/jsonrpc",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\n      \"{{ $('Preparar Datos').item.json.odoo_db }}\",\n      {{ $json.uid }},\n      \"{{ $('Preparar Datos').item.json.odoo_login }}\",\n      \"crm.lead\",\n      \"create\",\n      [{{ JSON.stringify($json.vals) }}]\n    ]\n  },\n  \"id\": 2\n}",
        "options": {}
      },
