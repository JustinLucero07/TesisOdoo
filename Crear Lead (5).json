            }
          ]
        },
        "options": {}
      },
      "id": "910ed169-23ee-482f-a0f0-c23e03cbba41",
      "name": "Extraer UID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        3552,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const datos = $('Preparar Datos').item.json;\nconst uid   = $('Extraer UID').item.json.uid;\n\n// Si se encontró la propiedad por WP ID, obtenemos su ID interno de Odoo\nlet targetPropertyId = (datos.property_id > 0 && datos.property_id < 10000) ? Number(datos.property_id) : 0;\ntry {\n  // Si llegamos desde el nodo Postgres ('Execute a SQL query'), el id llega en $input.item.json.id\n  if ($input.item.json && $input.item.json.id) {\n    targetPropertyId = Number($input.item.json.id);\n  } else if ($input.item.json && $input.item.json.result && Array.isArray($input.item.json.result) && $input.item.json.result.length > 0 && $input.item.json.result[0].id) {\n    targetPropertyId = Number($input.item.json.result[0].id);\n  }\n} catch(e) {}\n\n// Construir vals del lead (IMPORTANTE: no enviamos 'lead_source' como string ya que la columna fue borrada en la base de datos)\nconst vals = {\n  name:             `WhatsApp: ${datos.nombre}`,\n  contact_name:     datos.nombre,\n  phone:            datos.telefono,\n  type:             'opportunity',\n  stage_id:         32,          // 1. Nuevo / Contacto Inicial\n  client_budget:    datos.presupuesto || 0,\n  preferred_city:   datos.ciudad || '',\n  client_needs:     datos.necesidades || ''\n};\n\n// Asignar el catálogo de fuente de lead (lead_source_id)\nif (datos.lead_source_id > 0) {\n  vals.lead_source_id = datos.lead_source_id;\n} else {\n  // Si no pasaron lead_source_id explícito, pasamos el ID por defecto para WhatsApp (ej. 3)\n  vals.lead_source_id = 3;\n}\n\n// Asignar asesor solo si se pasó\nif (datos.user_id > 0) vals.user_id = datos.user_id;\n\n// Asociar propiedad objetivo con el ID interno real de Odoo obtenido\nif (targetPropertyId > 0) vals.target_property_id = targetPropertyId;\n\nreturn [{ json: { uid, vals, datos, targetPropertyId } }];"
      },
      "id": "c2a785e2-421d-49d6-96c9-23ea36efe094",
      "name": "Construir Vals Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4032,
        704
      ]
    },
    {
