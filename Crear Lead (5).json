        3152,
        704
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://{{ $('Preparar Datos').item.json.odoo_host }}:8069/jsonrpc",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"common\",\n    \"method\": \"authenticate\",\n    \"args\": [\"{{ $('Preparar Datos').item.json.odoo_db }}\", \"{{ $('Preparar Datos').item.json.odoo_login }}\", \"{{ $('Preparar Datos').item.json.odoo_api_key }}\", {}]\n  },\n  \"id\": 1\n}",
        "options": {}
      },
      "id": "5af669a1-8ae0-4b8a-a57b-a58c8d74de77",
      "name": "Autenticar Odoo",
