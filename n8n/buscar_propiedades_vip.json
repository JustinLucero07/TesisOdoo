      "id": "dcefc9ad-c1ae-460a-9bf4-51fcb0a3c608",
      "name": "Preparar Parametros",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [224, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    p.id,\n    p.name AS referencia,\n    p.title AS titulo,\n    p.price AS precio,\n    p.area AS metros_cuadrados,\n    p.bedrooms AS habitaciones,\n    p.bathrooms AS banos,\n    p.parking_spaces AS parqueaderos,\n    p.street AS direccion_zona,\n    p.city AS ciudad,\n    COALESCE(t.name, 'Propiedad') AS tipo_propiedad,\n    CASE p.offer_type WHEN 'sale' THEN 'Venta' ELSE 'Arriendo' END AS oferta,\n    CASE WHEN p.wp_post_id IS NOT NULL AND p.wp_post_id > 0 THEN 'https://inmobi.com.ec/?p=' || p.wp_post_id ELSE NULL END AS link_propiedad,\n    p.wp_post_id\nFROM estate_property p\nLEFT JOIN estate_property_type t ON p.property_type_id = t.id\nWHERE p.state = 'available' AND p.active = true AND p.price > 0\n  AND p.price <= ({{ $json.presupuesto_max || 999999999 }} * 1.15)\n  AND (\n    lower(translate(coalesce(p.title,''),'áéíóúñÁÉÍÓÚÑ','aeiounAEIOUN')) ILIKE '%vip%'\n    OR lower(translate(coalesce(p.title,''),'áéíóúñÁÉÍÓÚÑ','aeiounAEIOUN')) ILIKE '%credito vip%'\n    OR lower(translate(COALESCE(p.description,''),'áéíóúñÁÉÍÓÚÑ','aeiounAEIOUN')) ILIKE '%vip%'\n    OR lower(translate(COALESCE(p.description,''),'áéíóúñÁÉÍÓÚÑ','aeiounAEIOUN')) ILIKE '%credito vip%'\n    OR lower(translate(COALESCE(p.sector_keywords,''),'áéíóúñÁÉÍÓÚÑ','aeiounAEIOUN')) ILIKE '%vip%'\n  )\n  AND (\n    '{{ $json.ubicacion_norm || \"\" }}' = ''\n    OR EXISTS (\n      SELECT 1 FROM unnest(string_to_array('{{ $json.ubicacion_norm }}', ' ')) AS word\n      WHERE word != '' AND length(word) >= 3\n        AND lower(translate(coalesce(p.title,'') || ' ' || coalesce(p.street,'') || ' ' || coalesce(p.city,'') || ' ' || COALESCE(p.sector_keywords,''),'áéíóúñÁÉÍÓÚÑ','aeiounAEIOUN'))\n            ILIKE '%' || lower(translate(word,'áéíóúñÁÉÍÓÚÑ','aeiounAEIOUN')) || '%'\n    )\n  )\nORDER BY p.property_score DESC NULLS LAST, p.price ASC\nLIMIT 8;",
        "options": {}
      },
