<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_contract_view_form_inherit_ai" model="ir.ui.view">
        <field name="name">estate.contract.form.inherit.ai</field>
        <field name="model">estate.contract</field>
        <field name="inherit_id" ref="estate_management.estate_contract_view_form"/>
        <field name="arch" type="xml">
            <!-- Un ÚNICO botón de IA, en la pestaña Notas, con la acción coherente
                 (genera o mejora). Se quitó el botón duplicado del encabezado. -->
            <xpath expr="//button[@name='action_ai_draft_clauses']" position="replace">
                <button name="action_generate_contract_ai" type="object"
                        class="btn btn-info" icon="fa-magic"
                        string="Redactar / Mejorar con IA"
                        invisible="state in ('cancelled', 'expired')"
                        confirm="La IA redactará el contrato (o mejorará el borrador actual) según los datos. Puede tardar ~30 segundos. ¿Continuar?"/>
            </xpath>
        </field>
    </record>
</odoo>
