<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista de feedback -->
    <record id="estate_ai_feedback_view_list" model="ir.ui.view">
        <field name="name">estate.ai.feedback.list</field>
        <field name="model">estate.ai.feedback</field>
        <field name="arch" type="xml">
            <list string="Feedback IA" create="false"
                  decoration-success="vote == 'up'" decoration-danger="vote == 'down'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="vote" widget="badge"
                       decoration-success="vote == 'up'" decoration-danger="vote == 'down'"/>
                <field name="page_context"/>
                <field name="question"/>
                <field name="answer" optional="hide"/>
                <field name="session_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="estate_ai_feedback_view_form" model="ir.ui.view">
        <field name="name">estate.ai.feedback.form</field>
        <field name="model">estate.ai.feedback</field>
        <field name="arch" type="xml">
            <form string="Feedback IA" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="vote" widget="badge"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="page_context"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <group string="Pregunta">
                        <field name="question" nolabel="1"/>
                    </group>
                    <group string="Respuesta de la IA">
                        <field name="answer" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Búsqueda + agrupar -->
    <record id="estate_ai_feedback_view_search" model="ir.ui.view">
        <field name="name">estate.ai.feedback.search</field>
        <field name="model">estate.ai.feedback</field>
        <field name="arch" type="xml">
            <search>
                <field name="question"/>
                <field name="user_id"/>
                <filter name="up" string="Útiles" domain="[('vote','=','up')]"/>
                <filter name="down" string="No útiles" domain="[('vote','=','down')]"/>
                <separator/>
                <filter name="g_vote" string="Valoración" context="{'group_by':'vote'}"/>
                <filter name="g_user" string="Usuario" context="{'group_by':'user_id'}"/>
                <filter name="g_ctx" string="Contexto" context="{'group_by':'page_context'}"/>
            </search>
        </field>
    </record>

    <record id="estate_ai_feedback_action" model="ir.actions.act_window">
        <field name="name">Feedback IA</field>
        <field name="res_model">estate.ai.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="estate_ai_feedback_view_search"/>
        <field name="context">{'search_default_down': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">Aún no hay feedback registrado.</p>
<p>Cuando los usuarios valoren las respuestas del asistente con / , aparecerán aquí.</p>        </field>
    </record>

    <menuitem id="estate_menu_ai_feedback"
              name="Feedback de Respuestas"
              parent="estate_menu_ai_root"
              action="estate_ai_feedback_action"
              sequence="40"
              groups="estate_management.estate_group_manager"/>
</odoo>
