<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Config Settings View (inherit) -->
    <record id="estate_ai_config_settings_view" model="ir.ui.view">
        <field name="name">estate.ai.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Agente IA Inmobiliario" string="Agente IA Inmobiliario" name="estate_ai_agent">
                    <block title="Configuración del Agente Inteligente" name="estate_ai_settings">
                        <setting string="Activar Agente IA" help="Habilitar o deshabilitar el agente conversacional">
                            <field name="ai_active"/>
                        </setting>
                        <setting string="Proveedor de IA" help="Proveedor activo. El otro se usa como respaldo automático si tiene su API Key configurada.">
                            <field name="ai_provider" widget="radio"/>
                        </setting>
                        <setting string="API Key OpenAI (ChatGPT)" help="Clave de ChatGPT. Se conserva aunque cambies de proveedor.">
                            <field name="ai_openai_api_key" password="True"/>
                        </setting>
                        <setting string="Modelo OpenAI" help="Ej.: gpt-4o-mini, gpt-4o">
                            <field name="ai_openai_model"/>
                        </setting>
                        <setting string="API Key Google Gemini" help="Clave de Gemini. Se conserva aunque cambies de proveedor.">
                            <field name="ai_gemini_api_key" password="True"/>
                        </setting>
                        <setting string="Modelo Gemini" help="Ej.: gemini-2.5-flash, gemini-2.5-pro">
                            <field name="ai_gemini_model"/>
                        </setting>
                        <setting string="Temperatura" help="Controla la creatividad de las respuestas (0-1)">
                            <field name="ai_temperature"/>
                        </setting>
                        <setting string="Máximo de Tokens" help="Límite de longitud de las respuestas">
                            <field name="ai_max_tokens"/>
                        </setting>
                        <setting string="Prompt del Sistema" help="Instrucciones base para el agente IA">
                            <field name="ai_system_prompt"/>
                        </setting>
                        <setting string="Estilo de Descripciones" help="Tono e instrucciones para las descripciones comerciales generadas por IA. Editable sin tocar código.">
                            <field name="ai_desc_instructions"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
