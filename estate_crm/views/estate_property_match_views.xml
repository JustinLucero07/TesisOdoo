<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stat button en el formulario de propiedad -->
    <record id="estate_property_view_form_inherit_crm_match" model="ir.ui.view">
        <field name="name">estate.property.form.inherit.crm.match</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate_management.estate_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_price_history']" position="after">
                <button name="action_view_lead_matches" type="object"
                        class="oe_stat_button" icon="fa-users">
                    <field name="crm_match_count" string="Leads Interesados" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Lista de cruce inmuebles-clientes -->
    <record id="estate_property_view_tree_match" model="ir.ui.view">
        <field name="name">estate.property.tree.match</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Cruce Inmuebles - Clientes" create="false" edit="false">
                <field name="name" string="Referencia"/>
                <field name="title"/>
                <field name="city"/>
                <field name="price" widget="monetary"/>
                <field name="state" widget="badge" decoration-success="state == 'available'"/>
                <field name="crm_match_count" string="Clientes Posibles"/>

                <button name="action_view_lead_matches" type="object"
                        string="Hay Coincidencias"
                        class="btn-warning text-uppercase font-weight-bold"
                        invisible="crm_match_count == 0"/>

                <button name="action_view_lead_matches" type="object"
                        string="Sin Coincidencias"
                        class="btn-secondary text-uppercase"
                        invisible="crm_match_count &gt; 0"/>
            </list>
        </field>
    </record>

    <!-- Badge "Aliado" en la tarjeta kanban de propiedades -->
    <record id="estate_property_view_kanban_inherit_crm_ally" model="ir.ui.view">
        <field name="name">estate.property.kanban.inherit.crm.ally</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate_management.estate_property_view_kanban"/>
        <field name="arch" type="xml">
            <!-- Declarar los campos usados abajo: sin esto, Odoo no los carga en el
                 kanban y record.is_allied_property/.allied_agency_id quedan undefined. -->
            <xpath expr="//kanban" position="inside">
                <field name="is_allied_property"/>
                <field name="allied_agency_id"/>
            </xpath>
            <xpath expr="//div[hasclass('o_kanban_tags_section')]" position="after">
                <div t-if="record.is_allied_property.raw_value" class="mt-1">
                    <span class="badge text-bg-info">
                        <i class="fa fa-handshake-o me-1"/>Aliado<t t-if="record.allied_agency_id.value">: <t t-esc="record.allied_agency_id.value"/></t>
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Columna "Aliado" en la lista de propiedades -->
    <record id="estate_property_view_tree_inherit_crm_ally" model="ir.ui.view">
        <field name="name">estate.property.tree.inherit.crm.ally</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate_management.estate_property_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_type_id']" position="after">
                <field name="is_allied_property" widget="boolean" optional="show" string="Aliado"/>
            </xpath>
        </field>
    </record>
</odoo>
