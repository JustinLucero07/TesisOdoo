<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_lead_source_list" model="ir.ui.view">
        <field name="name">estate.crm.lead.source.list</field>
        <field name="model">estate.crm.lead.source</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="lead_count" string="Leads vinculados" optional="show"/>
                <field name="code" optional="hide" groups="base.group_no_one"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_edit_source" type="object" icon="fa-pencil" title="Editar" class="text-primary"/>
                <button name="action_delete_source" type="object" icon="fa-trash" title="Eliminar" class="text-danger"
                        confirm="¿Estás seguro de que deseas eliminar esta fuente de lead? Si tiene prospectos asociados, se reasignarán automáticamente a 'Otro'."/>
            </list>
        </field>
    </record>

    <record id="view_estate_lead_source_form" model="ir.ui.view">
        <field name="name">estate.crm.lead.source.form</field>
        <field name="model">estate.crm.lead.source</field>
        <field name="arch" type="xml">
            <form string="Fuente del Lead">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_leads" type="object" class="oe_stat_button" icon="fa-users"
                                invisible="lead_count == 0">
                            <field name="lead_count" widget="statinfo" string="Leads"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nombre de la Fuente"/>
                        <h1><field name="name" placeholder="Ej. TikTok, Feria Inmobiliaria..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="code" groups="base.group_no_one"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_estate_lead_source" model="ir.actions.act_window">
        <field name="name">Fuentes de Lead</field>
        <field name="res_model">estate.crm.lead.source</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea una nueva fuente de lead</p>
            <p>Puedes editar los nombres directamente en la lista, reordenarlas arrastrando desde el icono, archivarlas o eliminarlas.</p>
        </field>
    </record>

    <!-- Colgaba de CRM > Configuration, que Odoo reserva al grupo
         "Sales / Administrator": el menú declaraba acceso para asesores pero el
         padre los dejaba fuera y nadie salvo un administrador de ventas podía
         llegar a editar o borrar las fuentes. Se mueve a una sección propia
         dentro de la app CRM. -->
    <menuitem id="estate_menu_crm_ajustes_root"
              name="Ajustes del CRM"
              parent="crm.crm_menu_root"
              sequence="90"
              groups="estate_management.estate_group_agent"/>

    <menuitem id="menu_estate_lead_source"
              name="Fuentes de Lead"
              parent="estate_menu_crm_ajustes_root"
              action="action_estate_lead_source"
              groups="estate_management.estate_group_agent"
              sequence="10"/>
</odoo>
