<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredar Form View -->
    <record id="crm_lead_view_form_inherit_estate" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.estate</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='probability']" position="after">
                <!-- El Match se muestra una sola vez (barra en "Operación Inmobiliaria"). -->
                <field name="lead_score" widget="priority" invisible="type == 'lead'"/>
            </xpath>
            <xpath expr="//div[@id='probability']" position="after">
                <div class="col-auto ms-4 border-start ps-4" invisible="type == 'lead'">
                    <label for="lead_temperature" class="d-block text-muted small mb-0">Temperatura</label>
                    <field name="lead_temperature" widget="label_selection" options="{'classes': {'cold': 'info', 'warm': 'success', 'hot': 'warning', 'boiling': 'danger'}}" class="h5 mb-0 fw-bold"/>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="GOLDEN" bg_color="bg-warning" invisible="not is_golden_opportunity" />
                <!-- Barra de accesos inmobiliarios: fila propia bajo el título,
                     como botones espaciados (no apretados). -->
                <div class="d-flex flex-wrap gap-2 mb-3 mt-2" name="button_box_estate" invisible="type == 'lead'">
                    <button name="action_schedule_meeting" type="object"
                        class="btn btn-outline-primary" invisible="not target_property_id">
                        <i class="fa fa-calendar me-1"/>Agendar Visita
                    </button>
                    <button name="action_view_lead_offers" type="object"
                        class="btn btn-outline-secondary"
                        invisible="offer_count == 0 and not target_property_id">
                        <i class="fa fa-handshake-o me-1"/>Ofertas
                        <span class="badge text-bg-secondary ms-1"><field name="offer_count"/></span>
                    </button>
                    <button name="action_view_lead_contracts" type="object"
                        class="btn btn-outline-secondary">
                        <i class="fa fa-file-text me-1"/>Contratos
                        <span class="badge text-bg-secondary ms-1"><field name="contract_count"/></span>
                    </button>
                    <button name="action_view_documents" type="object"
                        class="btn btn-outline-secondary"
                        invisible="estate_document_count == 0">
                        <i class="fa fa-folder-open-o me-1"/>Documentos
                        <span class="badge text-bg-secondary ms-1"><field name="estate_document_count"/></span>
                    </button>
                    <button name="action_view_lead_interactions" type="object"
                        class="btn btn-outline-secondary">
                        <i class="fa fa-comments-o me-1"/>Interacciones
                        <span class="badge text-bg-secondary ms-1"><field name="interaction_count"/></span>
                    </button>
                </div>
            </xpath>
            <!-- Ocultar "Nueva cotización" estándar: redundante con "Nueva Oferta" -->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- El botón inteligente "Orders" (junto a Cotizaciones) viene en inglés
                 y sin traducción propia — se relabela a "Venta". Se activa solo
                 cuando ya existe una orden de venta (sale.order) vinculada a este
                 lead como origen, y entra directo a esa orden. -->
            <xpath expr="//button[@name='action_view_sale_order']/div/span[hasclass('o_stat_text')]" position="replace">
                <span class="o_stat_text"> Venta</span>
            </xpath>
            <!-- Botones contextuales por ETAPA del embudo:
                 1-2 Captación · 3-4 Negociación · 5+ Cierre -->
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <field name="gate_capture" invisible="1"/>
                <field name="gate_offer" invisible="1"/>
                <field name="gate_reserve" invisible="1"/>
                <field name="gate_contract" invisible="1"/>
                <field name="gate_postventa_comision" invisible="1"/>
                <field name="gate_cierre_venta" invisible="1"/>

                <!-- CAPTACIÓN: buscar propiedad y registrar necesidad -->
                <button name="action_ai_matchmaker" string=" AI Matchmaker" type="object"
                    class="oe_highlight btn-info" icon="fa-magic"
                    invisible="not gate_capture or type == 'lead'"/>
                <button name="action_mark_pending_need" string="Marcar Con Necesidad" type="object"
                    class="btn-warning" icon="fa-bookmark"
                    invisible="not gate_capture or pending_needs_active or type == 'lead'"/>
                <button name="action_clear_pending_need" string="Resolver Necesidad" type="object"
                    class="btn-outline-success" icon="fa-check-circle"
                    invisible="not pending_needs_active"/>

                <!-- NEGOCIACIÓN (Visita Realizada / Seguimiento): ofertar.
                     Se muestra por ETAPA aunque falte la propiedad; al hacer clic
                     la acción guía a asignar la Propiedad de Interés. -->
                <button name="action_create_offer_from_lead" string="Nueva Oferta" type="object"
                    class="btn-warning" icon="fa-handshake-o"
                    invisible="not gate_offer or type == 'lead'"/>

                <!-- Reservar: desde la Visita en adelante -->
                <button name="action_reserve_property_from_lead" string="Reservar Propiedad" type="object"
                    class="btn-secondary" icon="fa-lock"
                    invisible="not gate_reserve or type == 'lead'"/>

                <!-- CIERRE (embudo comercial): marcar la propiedad vendida. Solo
                     Gerente/Administrador/Marketing (implica a los dos anteriores). -->
                <button name="action_mark_sold_and_pay_commission" string="Marcar Venta" type="object"
                    class="btn-success oe_highlight" icon="fa-check-circle"
                    groups="estate_management.estate_group_manager"
                    invisible="not gate_cierre_venta or not target_property_id or type == 'lead'"
                    confirm="¿Confirmas marcar la propiedad como vendida en el precio acordado con el cliente?"/>

                <!-- POSTVENTA - COMISIÓN: aprobar la comisión ya registrada al marcar la venta -->
                <button name="action_mark_commission" string="Marcar Comisión" type="object"
                    class="btn-success oe_highlight" icon="fa-dollar"
                    invisible="not gate_postventa_comision or not target_property_id or type == 'lead'"
                    confirm="¿Confirmas aprobar el pago de la comisión de este negocio?"/>

                <!-- Comunicación: siempre disponible -->
                <button name="action_send_whatsapp" string=" WhatsApp" type="object"
                    class="btn-success" icon="fa-whatsapp"/>
            </xpath>
            <!-- Pestañas: Ubicación GPS y Documentos Internos -->
            <xpath expr="//notebook" position="inside">
                <page string="Ubicación GPS" name="page_gps"
                      invisible="not target_property_id">
                    <group>
                        <group string="Coordenadas de la Propiedad">
                            <field name="property_latitude" string="Latitud" readonly="1"/>
                            <field name="property_longitude" string="Longitud" readonly="1"/>
                            <field name="property_map_url" string="Ver en Google Maps" widget="url" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page string="Timeline de Interacciones" name="page_timeline">
                    <field name="interaction_ids" nolabel="1"
                           context="{'default_lead_id': id, 'default_partner_id': partner_id, 'default_property_id': target_property_id}">
                        <list string="Interacciones" editable="bottom" default_order="date desc">
                            <field name="date"/>
                            <field name="interaction_type" widget="badge"/>
                            <field name="summary"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="property_id"/>
                        </list>
                    </field>
                </page>
                <!-- "Documentos Internos" se eliminó: era duplicada de "Documentos". -->
                <page string="Búsqueda del Cliente" name="page_search">
                    <group>
                        <group name="preferred_property" string="Propiedad Buscada">
                            <field name="preferred_property_type_id" placeholder="Ej. Casa, Apartamento..."/>
                            <field name="preferred_city" placeholder="Ej. Cuenca, Quito..."/>
                            <field name="preferred_bedrooms"/>
                            <field name="preferred_min_area" string="Área Mín. (m²)"/>
                            <field name="preferred_max_area" string="Área Máx. (m²)"/>
                            <field name="client_needs" placeholder="Ej. Cerca de parques, crédito pre-aprobado..."/>
                        </group>
                        <group string="Necesidad Pendiente">
                            <field name="pending_needs_active" widget="boolean_toggle"/>
                            <field name="pending_needs_last_check" invisible="not pending_needs_active"/>
                            <field name="pending_needs_notified_property_ids" widget="many2many_tags" invisible="not pending_needs_active"/>
                        </group>
                    </group>
                </page>
                <page string="Negociación y Cierre" name="page_closing">
                    <group>
                        <group name="closing_details" string="Forma de Cierre">
                            <field name="closing_payment_type" widget="radio" options="{'horizontal': true}"/>
                            <field name="mortgage_time_estimated" invisible="closing_payment_type != 'credit'"/>
                            <field name="promissory_note_time" placeholder="Ej. 90 días..."/>
                        </group>
                        <group name="commercial_intel" string="Inteligencia Comercial">
                            <field name="expected_commission" widget="monetary" decoration-bf="1" decoration-success="expected_commission &gt; 5000"/>
                            <field name="lead_velocity_days" readonly="1" decoration-danger="lead_velocity_days &gt; 14" decoration-warning="lead_velocity_days &gt; 7"/>
                            <field name="closing_difficulty" widget="badge" decoration-success="closing_difficulty == 'easy'" decoration-warning="closing_difficulty == 'moderate'" decoration-danger="closing_difficulty == 'hard'"/>
                            <field name="smart_negotiation_tips" decoration-info="1" invisible="not smart_negotiation_tips"/>
                            <field name="is_golden_opportunity" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- En la vista principal queda SOLO lo esencial (la operación);
                 el resto se movió a las pestañas para no saturar. -->
            <xpath expr="//group" position="after">
                <group name="elite_crm_intelligence" string="Operación Inmobiliaria">
                    <field name="target_property_id"
                        placeholder="Asigna la propiedad de interés (necesaria para ofertar/contratar)..."/>
                    <field name="client_budget" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                    <field name="match_percentage" widget="progressbar"/>
                    <field name="lead_source_code" invisible="1"/>
                    <field name="lead_source_id" options="{'no_quick_create': False}"/>
                    <field name="referral_partner_id" placeholder="¿Quién lo refirió?" invisible="lead_source_code != 'referral'"/>
                </group>
            </xpath>
            <!-- "Propiedades" nativas de Odoo (campos personalizados por equipo, campo
                 lead_properties): no se usan en este proyecto y su nombre en español
                 confunde con "Propiedad" inmobiliaria. Se oculta del formulario. -->
            <xpath expr="//field[@name='lead_properties']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Heredar Formulario de Creación Rápida -->
    <record id="crm_lead_view_form_quick_create_inherit_estate" model="ir.ui.view">
        <field name="name">crm.lead.form.quick.create.inherit.estate</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="after">
                <field name="client_budget" string="Presupuesto" widget="monetary" options="{'currency_field': 'company_currency'}"/>
                <field name="city" placeholder="Ciudad Deseada..."/>
            </xpath>
        </field>
    </record>

    <!-- Heredar Kanban View para mostrar el Match % -->
    <record id="crm_case_kanban_view_leads_inherit_estate" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.estate</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="is_golden_opportunity"/>
                <field name="lead_temperature"/>
                <field name="lead_source_id"/>
                <field name="match_percentage"/>
                <field name="expected_commission"/>
                <field name="lead_velocity_days"/>
                <field name="pending_needs_active"/>
                <field name="lead_velocity_days"/>
            </xpath>
            <xpath expr="//footer" position="before">
                <div class="o_kanban_record_subtitle mt-1 mb-1">
                    <field name="lead_score" widget="badge" decoration-danger="lead_score == 'high'" decoration-warning="lead_score == 'medium'" decoration-info="lead_score == 'low'"/>
                    <span class="ms-2 fw-bold text-primary" t-if="record.expected_revenue.raw_value > 0">
                        <i class="fa fa-money" title="Ingreso esperado"/> $<field name="expected_revenue"/>
                    </span>
                    <span class="ms-2 badge text-bg-secondary small" t-if="record.lead_source_id.value">
                        <field name="lead_source_id"/>
                    </span>
                </div>
                <div t-if="record.match_percentage.raw_value > 0" class="mt-1">
                    <span class="badge rounded-pill text-bg-success" t-if="record.match_percentage.raw_value &gt;= 80">
                        <i class="fa fa-star" title="Match alto"/> Match: <field name="match_percentage"/>%
                    </span>
                    <span class="badge rounded-pill text-bg-warning" t-if="record.match_percentage.raw_value &lt; 80 and record.match_percentage.raw_value &gt;= 50">
                        <i class="fa fa-star-half-o" title="Match medio"/> Match: <field name="match_percentage"/>%
                    </span>
                    <span class="badge rounded-pill text-bg-danger" t-if="record.match_percentage.raw_value &lt; 50">
                        <i class="fa fa-star-o" title="Match bajo"/> Match: <field name="match_percentage"/>%
                    </span>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Reportes CRM Fase 3 -->
    <record id="estate_crm_lead_view_pivot_general" model="ir.ui.view">
        <field name="name">estate.crm.lead.pivot.general</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Análisis por Fuentes" sample="1">
                <field name="lead_source_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="expected_revenue" type="measure"/>
                <field name="expected_commission" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="estate_crm_lead_view_graph_general" model="ir.ui.view">
        <field name="name">estate.crm.lead.graph.general</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Fuentes de Mayor Rentabilidad" type="bar" sample="1">
                <field name="lead_source_id"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="estate_crm_lead_view_pivot_deals" model="ir.ui.view">
        <field name="name">estate.crm.lead.pivot.deals</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Promedio y Total de Ventas por Asesor" sample="1" display_quantity="true">
                <field name="user_id" type="row"/>
                <field name="closing_payment_type" type="col"/>
                <field name="expected_revenue" type="measure"/>
                <field name="client_budget" type="measure"/>
                <field name="expected_commission" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="estate_crm_lead_view_graph_deals" model="ir.ui.view">
        <field name="name">estate.crm.lead.graph.deals</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Ventas Promedio por Asesor" type="bar" sample="1">
                <field name="user_id"/>
                <field name="client_budget" type="measure"/>
                <field name="expected_commission" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Reporte: Ventas por Fuente -->
    <record id="estate_crm_lead_view_pivot_sources" model="ir.ui.view">
        <field name="name">estate.crm.lead.pivot.sources</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <pivot string="Ventas por Fuente de Captación" sample="1" display_quantity="true">
                <field name="lead_source_id" type="row"/>
                <field name="closing_payment_type" type="col"/>
                <field name="client_budget" type="measure"/>
                <field name="expected_revenue" type="measure"/>
                <field name="expected_commission" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="estate_crm_lead_view_graph_sources" model="ir.ui.view">
        <field name="name">estate.crm.lead.graph.sources</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <graph string="Mejores Fuentes de Ventas" type="pie" sample="1">
                <field name="lead_source_id"/>
                <field name="client_budget" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Heredar list view del CRM para añadir decoraciones de temperatura -->
    <record id="crm_lead_view_tree_inherit_estate" model="ir.ui.view">
        <field name="name">crm.lead.tree.inherit.estate</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">lead_temperature == 'boiling'</attribute>
                <attribute name="decoration-warning">lead_temperature == 'hot'</attribute>
                <attribute name="decoration-info">lead_temperature == 'warm'</attribute>
                <attribute name="decoration-muted">lead_temperature == 'cold'</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="lead_temperature" optional="show"
                       widget="badge"
                       decoration-danger="lead_temperature == 'boiling'"
                       decoration-warning="lead_temperature == 'hot'"
                       decoration-info="lead_temperature == 'warm'"/>
                <field name="match_percentage" optional="hide" widget="progressbar"/>
                <field name="lead_score" optional="hide" widget="badge"
                       decoration-danger="lead_score == 'high'"
                       decoration-warning="lead_score == 'medium'"/>
            </xpath>
        </field>
    </record>

</odoo>
