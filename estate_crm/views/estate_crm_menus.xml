<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==============================================
         CRM INMOBILIARIO — todo dentro de la app "Inmobiliaria"
         (consolidación de navegación: una sola app operativa)
         ============================================== -->

    <!-- 1. Menús adicionales de Propiedades -->
    <menuitem id="estate_menu_property_allied"
              name="Inmuebles de mis aliados"
              parent="estate_management.estate_menu_property_root"
              action="action_crm_allied_properties"
              sequence="14"
              groups="estate_management.estate_group_agent"/>

    <menuitem id="estate_menu_property_match"
              name="Cruce inmuebles - clientes"
              parent="estate_management.estate_menu_property_root"
              action="action_crm_match_properties_window"
              sequence="16"
              groups="estate_management.estate_group_agent"/>

    <!-- 2. Clientes — sección dentro de la app CRM NATIVA de Odoo -->
    <menuitem id="estate_menu_crm_directorio_root"
              name="Clientes"
              parent="crm.crm_menu_root"
              sequence="10"/>

        <menuitem id="estate_menu_crm_clientes_lista"
                  name="Directorio de clientes"
                  parent="estate_menu_crm_directorio_root"
                  action="base.action_partner_form"
                  sequence="10"/>

        <menuitem id="estate_menu_crm_new_client"
                  name="Nuevo cliente"
                  parent="estate_menu_crm_directorio_root"
                  action="action_crm_new_client"
                  sequence="15"/>

        <menuitem id="estate_menu_crm_gestiones"
                  name="Gestiones realizadas"
                  parent="estate_menu_crm_directorio_root"
                  action="estate_interaction_action"
                  sequence="20"/>

        <menuitem id="estate_menu_crm_pendientes"
                  name="Clientes Pendientes"
                  parent="estate_menu_crm_directorio_root"
                  action="action_crm_pending_needs"
                  sequence="25"/>

        <menuitem id="estate_menu_crm_red_alianzas"
                  name="Red de Aliados"
                  parent="estate_menu_crm_directorio_root"
                  action="action_crm_alliances"
                  sequence="40"/>

    <!-- 3. Reactivar la app CRM nativa de Odoo (la habíamos ocultado) -->
    <record id="crm.crm_menu_root" model="ir.ui.menu">
        <field name="active" eval="True"/>
    </record>
    <record id="crm.crm_menu_report" model="ir.ui.menu">
        <field name="active" eval="True"/>
    </record>

    <!-- 4. Reportes CRM — bajo la app Reportes (análisis) -->
    <menuitem id="estate_menu_reportes_crm_root"
              name="CRM y Leads"
              parent="estate_management.estate_menu_intel_root"
              sequence="50"
              groups="estate_management.estate_group_manager"/>

        <menuitem id="estate_menu_crm_reports_general"
                  name="Pipeline de Clientes"
                  parent="estate_menu_reportes_crm_root"
                  action="action_crm_reports_general"
                  sequence="10"
                  groups="estate_management.estate_group_manager"/>

        <menuitem id="estate_menu_crm_reports_deals"
                  name="Negocios Realizados"
                  parent="estate_menu_reportes_crm_root"
                  action="action_crm_reports_deals"
                  sequence="20"
                  groups="estate_management.estate_group_manager"/>

        <menuitem id="estate_menu_crm_reports_sources"
                  name="Fuentes de Captación"
                  parent="estate_menu_reportes_crm_root"
                  action="action_crm_reports_sources"
                  sequence="30"
                  groups="estate_management.estate_group_manager"/>

        <menuitem id="estate_menu_crm_reports_visits"
                  name="Visitas por Inmueble"
                  parent="estate_menu_reportes_crm_root"
                  action="action_report_property_visits"
                  sequence="40"
                  groups="estate_management.estate_group_manager"/>
</odoo>
