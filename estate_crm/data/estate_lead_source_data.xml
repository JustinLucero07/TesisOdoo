        <field name="code">whatsapp</field>
        <field name="sequence">30</field>
    </record>
    <record id="lead_source_instagram" model="estate.crm.lead.source">
        <field name="name">Instagram</field>
        <field name="code">instagram</field>
        <field name="sequence">40</field>
    </record>
    <record id="lead_source_facebook" model="estate.crm.lead.source">
        <field name="name">Facebook</field>
        <field name="code">facebook</field>
        <field name="sequence">50</field>
    </record>
    <record id="lead_source_google" model="estate.crm.lead.source">
        <field name="name">Google Business</field>
