<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Fuentes de lead iniciales, equivalentes a la lista fija anterior.
         El código técnico (code) lo usan las integraciones automáticas;
         las fuentes que el usuario cree a mano no necesitan tener uno. -->
    <record id="lead_source_website" model="estate.crm.lead.source">
        <field name="name">Sitio Web</field>
        <field name="code">website</field>
        <field name="sequence">10</field>
    </record>
    <record id="lead_source_wordpress" model="estate.crm.lead.source">
        <field name="name">WordPress/Houzez</field>
        <field name="code">wordpress</field>
        <field name="sequence">20</field>
    </record>
    <record id="lead_source_whatsapp" model="estate.crm.lead.source">
