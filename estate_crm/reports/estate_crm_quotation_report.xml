<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         REPORTE: Cotización Inmobiliaria desde Lead CRM
    ============================================================ -->
    <record id="action_report_crm_quotation" model="ir.actions.report">
        <field name="name">Cotización Inmobiliaria</field>
        <field name="model">crm.lead</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate_crm.report_crm_quotation_template</field>
        <field name="report_file">estate_crm.report_crm_quotation_template</field>
        <field name="paperformat_id" ref="estate_management.paperformat_estate_a4"/>
    </record>

    <template id="report_crm_quotation_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="lead">
                <t t-set="prop" t-value="lead.target_property_id"/>
                <t t-set="company" t-value="lead.company_id or env.company"/>
                    <div class="article" style="font-family:Arial,Helvetica,sans-serif; color:#222; font-size:11px;">

                        <!-- ══ ENCABEZADO ══════════════════════════════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; background:#004274; margin-bottom:12px;">
                            <tr>
                                <td style="padding:10px 16px; vertical-align:middle; width:60%;">
                                    <t t-if="company.logo">
                                        <img t-att-src="image_data_uri(company.logo)" style="height:28px; max-width:110px;"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font-size:15px; font-weight:900; color:white;"><t t-esc="company.name"/></span>
                                    </t>
                                </td>
                                <td style="padding:10px 16px; vertical-align:middle; text-align:right; width:40%;">
                                    <div style="font-size:13px; font-weight:900; color:white; text-transform:uppercase; letter-spacing:2px;">Cotizaci&#243;n Inmobiliaria</div>
                                    <div style="font-size:9px; color:#a8bcdb; margin-top:3px;">
                                        <t t-esc="lead.name"/> &#183; <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ TÍTULO ═══════════════════════════════════════════════════ -->
                        <div style="border-left:4px solid #C8102E; padding:8px 14px; background:#F8F9FB; border-top:1px solid #E0E4EC; border-right:1px solid #E0E4EC; border-bottom:1px solid #E0E4EC; margin-bottom:14px;">
                            <div style="font-size:7px; color:#C8102E; text-transform:uppercase; letter-spacing:2px; font-weight:700; margin-bottom:4px;">Propuesta para el cliente</div>
                            <div style="font-size:15px; font-weight:900; color:#004274;">
                                <t t-esc="prop.title if prop else lead.name"/>
                            </div>
                            <div style="font-size:9px; color:#666; margin-top:3px;">
                                Para: <t t-esc="lead.partner_id.name if lead.partner_id else lead.contact_name or '&#8212;'"/>
                                &#160;&#183;&#160; Ref: <t t-esc="lead.name"/>
                                &#160;&#183;&#160; V&#225;lida 30 d&#237;as
                            </div>
                        </div>

                        <!-- ══ DOS COLUMNAS: propiedad + precios ══════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; margin-bottom:14px;">
                            <tr>
                                <!-- Columna izquierda: foto + detalle propiedad -->
                                <td style="width:52%; vertical-align:top; padding-right:6px;">
                                    <t t-if="prop">
                                        <t t-if="prop.image_main">
                                            <img t-att-src="image_data_uri(prop.image_main)" style="width:100%; height:52mm; object-fit:cover; border:1px solid #D8DCE5; margin-bottom:8px; display:block;"/>
                                        </t>
                                        <t t-else="">
                                            <div style="width:100%; height:52mm; background:#F0F3F8; border:1px solid #D8DCE5; text-align:center; padding-top:18mm; margin-bottom:8px; font-size:9px; color:#aaa;">
                                                Foto no disponible
                                            </div>
                                        </t>
                                        <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                                            Detalle de la propiedad
                                        </div>
                                        <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none;">
                                            <tr>
                                                <td style="width:38%; background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">C&#243;digo</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.name"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Tipo</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.property_type_id.name or '&#8212;'"/></td>
                                            </tr>
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Ubicaci&#243;n</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;">
                                                    <t t-esc="prop.street or ''"/>
                                                    <t t-if="prop.city">, <t t-esc="prop.city"/></t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Superficie</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="'{:,.0f}'.format(prop.area or 0)"/> m&#178;</td>
                                            </tr>
                                            <t t-if="prop.bedrooms">
                                                <tr>
                                                    <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Distribuci&#243;n</td>
                                                    <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;">
                                                        <t t-esc="prop.bedrooms"/> dorm.
                                                        <t t-if="prop.bathrooms"> &#183; <t t-esc="prop.bathrooms"/> ba&#241;os</t>
                                                        <t t-if="prop.parking_spaces"> &#183; <t t-esc="prop.parking_spaces"/> parqueos</t>
                                                    </td>
                                                </tr>
                                            </t>
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; color:#555; font-weight:600;">Operaci&#243;n</td>
                                                <td style="padding:5px 10px;"><t t-esc="dict([('sale','Venta'),('rent','Arriendo'),('both','Venta o Arriendo')]).get(prop.offer_type, '&#8212;')"/></td>
                                            </tr>
                                        </table>
                                    </t>
                                    <t t-else="">
                                        <div style="background:#FFF8F0; border:1px solid #F5A623; padding:14px; font-size:12px; color:#555;">
                                            No se ha seleccionado una propiedad espec&#237;fica. Se coordinar&#225; la selecci&#243;n seg&#250;n las necesidades del cliente.
                                        </div>
                                    </t>
                                </td>

                                <!-- Columna derecha: precios + perfil -->
                                <td style="width:48%; vertical-align:top; padding-left:6px;">
                                    <!-- Precio principal (accent) -->
                                    <div style="background:#004274; padding:14px; margin-bottom:8px; text-align:center;">
                                        <div style="font-size:8px; color:rgba(255,255,255,0.6); text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Precio publicado</div>
                                        <div style="font-size:24px; font-weight:900; color:white; line-height:1;">
                                            <t t-if="prop">$<t t-esc="'{:,.0f}'.format(prop.price or 0)"/></t>
                                            <t t-else="">&#8212;</t>
                                        </div>
                                        <t t-if="prop and prop.avm_estimated_price">
                                            <div style="font-size:8px; color:rgba(255,255,255,0.5); margin-top:4px;">
                                                AVM: $<t t-esc="'{:,.0f}'.format(prop.avm_estimated_price)"/>
                                                &#160;
                                                <t t-if="prop.avm_status == 'fair'">(Precio justo)</t>
                                                <t t-elif="prop.avm_status == 'high'">(Sobre el mercado)</t>
                                                <t t-elif="prop.avm_status == 'low'">(Oportunidad)</t>
                                            </div>
                                        </t>
                                    </div>

                                    <!-- Presupuesto + compatibilidad -->
                                    <table style="width:100%; border-collapse:collapse; margin-bottom:8px;">
                                        <tr>
                                            <td style="width:50%; background:#F8F9FB; border:1px solid #D8DCE5; padding:10px; text-align:center; vertical-align:middle; border-right:none;">
                                                <div style="font-size:8px; color:#888; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Presupuesto cliente</div>
                                                <div style="font-size:14px; font-weight:700; color:#C8102E;">
                                                    <t t-if="lead.client_budget">$<t t-esc="'{:,.0f}'.format(lead.client_budget)"/></t>
                                                    <t t-else="">&#8212;</t>
                                                </div>
                                            </td>
                                            <td style="width:50%; background:#F8F9FB; border:1px solid #D8DCE5; padding:10px; text-align:center; vertical-align:middle;">
                                                <div style="font-size:8px; color:#888; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Compatibilidad</div>
                                                <div style="font-size:14px; font-weight:700; color:#004274;">
                                                    <t t-if="prop and lead.match_percentage"><t t-esc="lead.match_percentage"/>%</t>
                                                    <t t-else="">&#8212;</t>
                                                </div>
                                            </td>
                                        </tr>
                                    </table>

                                    <!-- Perfil del comprador -->
                                    <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px; margin-top:10px;">
                                        Perfil del comprador
                                    </div>
                                    <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none;">
                                        <t t-if="lead.partner_id">
                                            <tr>
                                                <td style="width:40%; background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Cliente</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5; font-weight:700;"><t t-esc="lead.partner_id.name"/></td>
                                            </tr>
                                            <t t-if="lead.partner_id.email">
                                                <tr>
                                                    <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Email</td>
                                                    <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="lead.partner_id.email"/></td>
                                                </tr>
                                            </t>
                                            <t t-if="lead.partner_id.phone or lead.partner_id.mobile">
                                                <tr>
                                                    <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Tel&#233;fono</td>
                                                    <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="lead.partner_id.phone or lead.partner_id.mobile"/></td>
                                                </tr>
                                            </t>
                                        </t>
                                        <t t-if="lead.preferred_property_type_id">
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Tipo buscado</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="lead.preferred_property_type_id.name"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="lead.preferred_city">
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Ciudad preferida</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="lead.preferred_city"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="lead.preferred_min_area or lead.preferred_max_area">
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Rango &#225;rea</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;">
                                                    <t t-if="lead.preferred_min_area"><t t-esc="'{:,.0f}'.format(lead.preferred_min_area)"/> m&#178;</t>
                                                    <t t-if="lead.preferred_min_area and lead.preferred_max_area"> &#8212; </t>
                                                    <t t-if="lead.preferred_max_area"><t t-esc="'{:,.0f}'.format(lead.preferred_max_area)"/> m&#178;</t>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="lead.preferred_bedrooms">
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; color:#555; font-weight:600;">Dormitorios m&#237;n.</td>
                                                <td style="padding:5px 10px;"><t t-esc="lead.preferred_bedrooms"/>+</td>
                                            </tr>
                                        </t>
                                    </table>

                                    <!-- Asesor -->
                                    <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px; margin-top:10px;">
                                        Asesor Inmobiliario
                                    </div>
                                    <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none;">
                                        <tr>
                                            <td style="width:40%; background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Nombre</td>
                                            <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5; font-weight:700; color:#004274;"><t t-esc="lead.user_id.name or '&#8212;'"/></td>
                                        </tr>
                                        <t t-if="lead.user_id.email">
                                            <tr>
                                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Email</td>
                                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="lead.user_id.email"/></td>
                                            </tr>
                                        </t>
                                        <tr>
                                            <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; color:#555; font-weight:600;">Empresa</td>
                                            <td style="padding:5px 10px;"><t t-esc="company.name"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ CONDICIONES ══════════════════════════════════════════════ -->
                        <div style="background:#F8F9FB; border:1px solid #D8DCE5; padding:10px 14px; font-size:10px; color:#555; margin-bottom:14px;">
                            <strong>Condiciones:</strong> Esta cotizaci&#243;n es v&#225;lida por 30 d&#237;as a partir de su fecha de emisi&#243;n.
                            Los precios est&#225;n sujetos a disponibilidad y variaciones del mercado.
                            Para m&#225;s informaci&#243;n, contacte a su asesor inmobiliario.
                        </div>

                        <!-- ══ FIRMAS ════════════════════════════════════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; margin-top:40px;">
                            <tr>
                                <td style="width:45%; text-align:center; vertical-align:top; padding-top:8px; border-top:1px solid #333; font-size:11px;">
                                    Firma del Cliente<br/>
                                    <strong><t t-esc="lead.partner_id.name if lead.partner_id else lead.contact_name or '____________________'"/></strong>
                                </td>
                                <td style="width:10%;"/>
                                <td style="width:45%; text-align:center; vertical-align:top; padding-top:8px; border-top:1px solid #333; font-size:11px;">
                                    Asesor Inmobiliario<br/>
                                    <strong><t t-esc="lead.user_id.name or '____________________'"/></strong>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ PIE ═══════════════════════════════════════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; border-top:3px solid #004274; margin-top:14px; font-size:8px; color:#888;">
                            <tr>
                                <td style="padding:5px 0; width:50%;">
                                    <t t-if="company.street"><strong><t t-esc="company.street"/></strong></t>
                                    <t t-if="company.city"> &#183; <t t-esc="company.city"/></t>
                                    <t t-if="company.email"> &#183; <t t-esc="company.email"/></t>
                                    <t t-if="company.phone"> &#183; <t t-esc="company.phone"/></t>
                                </td>
                                <td style="padding:5px 0; width:20%; text-align:center; font-weight:700; color:#004274; font-size:9px;">
                                    <t t-esc="company.name"/>
                                </td>
                                <td style="padding:5px 0; width:30%; text-align:right; color:#004274; font-weight:600;">
                                    <t t-esc="lead.name"/> &#183; Emitido <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                </td>
                            </tr>
                        </table>

                    </div>
            </t>
        </t>
    </template>

</odoo>
