<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_commission_payout_wizard_form" model="ir.ui.view">
        <field name="name">estate.commission.payout.wizard.form</field>
        <field name="model">estate.commission.payout.wizard</field>
        <field name="arch" type="xml">
            <form string="Pagar a los asesores">
                <field name="company_currency" invisible="1"/>
                <field name="advisor_count" invisible="1"/>
                <group>
                    <group>
                        <field name="commission_id" string="Comisión"/>
                    </group>
                    <group>
                        <field name="mode" string="Tipo de pago"/>
                    </group>
                </group>

                <separator string="Asesores a pagar: indica cómo se le paga a cada uno"/>
                <field name="line_ids" widget="estate_payout_cards" nolabel="1" colspan="2">
                    <list editable="bottom" create="0" delete="0">
                        <field name="user_id"/>
                        <field name="roles"/>
                        <field name="amount_base"/>
                        <field name="invoice"/>
                        <field name="payment_method"/>
                        <field name="payment_date"/>
                        <field name="payment_reference"/>
                        <field name="amount_vat"/>
                        <field name="amount_total"/>
                        <field name="company_currency"/>
                    </list>
                </field>

                <group class="oe_subtotal_footer">
                    <field name="amount_base_total" widget="monetary"/>
                    <field name="amount_vat_total" widget="monetary"/>
                    <field name="amount_to_pay" widget="monetary" class="oe_subtotal_footer_separator fw-bold fs-5"/>
                </group>

                <p class="text-muted small">
                    <b>Con factura 15%:</b> se suma el 15% de IVA y se registra la factura de proveedor del asesor, ya pagada.<br/>
                    <b>Con factura 0%:</b> se registra la factura del asesor con IVA 0%, ya pagada.<br/>
                    <b>Sin factura:</b> se paga el monto neto, sin factura; el pago igual queda en Facturación.<br/>
                    Después del pago puedes imprimir el <b>comprobante</b> para que el asesor lo firme.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar y Pagar" icon="fa-check"
                            class="btn-success"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
