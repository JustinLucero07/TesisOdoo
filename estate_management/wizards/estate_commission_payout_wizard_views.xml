<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_commission_payout_wizard_form" model="ir.ui.view">
        <field name="name">estate.commission.payout.wizard.form</field>
        <field name="model">estate.commission.payout.wizard</field>
        <field name="arch" type="xml">
            <form string="Pagar a los asesores">
                <group>
                    <group>
                        <field name="commission_id" string="Comisión"/>
                        <field name="mode" string="Qué se hace"/>
                        <field name="advisors"/>
                        <field name="company_currency" invisible="1"/>
                        <field name="amount_to_pay" widget="monetary"/>
                    </group>
                    <group>
                        <field name="payment_method" widget="radio"/>
                        <field name="payment_date"/>
                        <field name="payment_reference" placeholder="Nº transferencia, recibo, cheque..."/>
                    </group>
                </group>
                <p class="text-muted small">
                    A cada asesor se le genera su factura de proveedor y se registra el pago con
                    estos datos.
                </p>
                <footer>
                    <button name="action_confirm" type="object" string="Pagar" icon="fa-check"
                            class="btn-success"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
