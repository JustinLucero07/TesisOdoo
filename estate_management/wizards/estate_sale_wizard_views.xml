<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_estate_sale_wizard_form" model="ir.ui.view">
        <field name="name">estate.sale.wizard.form</field>
        <field name="model">estate.sale.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrar / Modificar Venta">
                <field name="is_edit_mode" invisible="1"/>
                <sheet>
                    <div class="oe_title">
                        <h2 invisible="is_edit_mode">Confirmar Venta de Propiedad</h2>
                        <h2 invisible="not is_edit_mode" class="text-primary"><i class="fa fa-pencil-square-o" title="Editar" aria-label="Editar"/> Actualizar Datos del Negocio Cerrado</h2>
                        <h3 class="text-muted">
                            <field name="property_id" readonly="1"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Comprador">
                            <field name="lead_id" placeholder="Elige un lead del CRM para llenar los datos..."/>
                            <field name="buyer_id" options="{'no_create': False}"/>
                        </group>
                        <group string="Fecha y Cierre">
                            <field name="date_sold"/>
                            <field name="sold_by"/>
                            <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <group>
                        <group string="Precio de Venta">
                            <field name="sale_price" widget="monetary"/>
                            <field name="deal_earnest_amount" widget="monetary"/>
                        </group>
                        <group string="Comisión">
                            <field name="commission_pct"/>
                            <field name="commission_amount" widget="monetary" readonly="1"/>
                            <field name="apply_vat" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <field name="invoice_mode" invisible="1"/>

                    <group string="Detalles de la Seña" invisible="not deal_earnest_amount">
                        <group>
                            <field name="deal_earnest_received_by" widget="radio"/>
                        </group>
                        <group>
                            <field name="deal_earnest_payment_method" widget="radio"/>
                            <field name="deal_earnest_payment_other"
                                   invisible="deal_earnest_payment_method != 'other'"
                                   placeholder="Ej: Cheque, criptomoneda..."/>
                        </group>
                    </group>

                    <group string="Datos del Negocio Cerrado">
                        <group>
                            <field name="buyer_proxy_id" options="{'no_create': False}"/>
                            <field name="deal_deadline"/>
                            <field name="deal_payment_type"/>
                        </group>
                        <group>
                            <field name="deal_credit_institution"
                                   invisible="deal_payment_type not in ('mortgage','mixed')"/>
                            <field name="deal_credit_advisor"
                                   invisible="deal_payment_type not in ('mortgage','mixed')"/>
                            <field name="deal_credit_advisor_phone"
                                   invisible="deal_payment_type not in ('mortgage','mixed')"/>
                        </group>
                    </group>
                    <group>
                        <field name="deal_payment_details"
                               placeholder="Ej: Contado $5.000 directo al vendedor. Saldo de contado esperando Poder y actualización de la construcción para la escritura definitiva."/>
                        <field name="deal_observations" placeholder="Observaciones adicionales del negocio..."/>
                    </group>

                    <div class="alert alert-success" role="alert" style="font-size:0.9em" invisible="is_edit_mode">
                        <i class="fa fa-check-circle" title="Confirmación" aria-label="Confirmación"/> Al confirmar, automáticamente se:
                        <ol class="mb-0 mt-1">
                            <li>Crea y <strong>confirma la Orden de Venta</strong> (módulo Ventas)</li>
                            <li>Genera y <strong>contabiliza la Factura</strong> (módulo Facturación)</li>
                            <li>Marca la propiedad como <strong>Vendida</strong></li>
                            <li>Registra la <strong>comisión</strong> del asesor</li>
                        </ol>
                    </div>
                    <div class="alert alert-info" role="alert" style="font-size:0.9em" invisible="not is_edit_mode">
                        <i class="fa fa-info-circle" title="Información" aria-label="Información"/> <strong>Modo Edición:</strong> Al hacer clic en <em>Actualizar Cambios</em>, se actualizará instantáneamente la ficha de la propiedad, la orden de venta y los reportes de cierre sin alterar la facturación previa ni duplicar registros contables.
                    </div>
                </sheet>
                <footer>
                    <button name="action_confirm_sale" string="Confirmar Venta"
                            type="object" class="btn-success oe_highlight" icon="fa-check"
                            invisible="is_edit_mode"/>
                    <button name="action_confirm_sale" string="Actualizar Cambios"
                            type="object" class="btn-primary oe_highlight" icon="fa-save"
                            invisible="not is_edit_mode"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_estate_sale_wizard" model="ir.actions.act_window">
        <field name="name">Vender Propiedad</field>
        <field name="res_model">estate.sale.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
