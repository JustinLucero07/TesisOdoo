<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_estate_third_payment_wizard_form" model="ir.ui.view">
        <field name="name">estate.third.payment.wizard.form</field>
        <field name="model">estate.third.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar pago a tercero">
                <field name="currency_id" invisible="1"/>
                <p class="text-muted">
                    Para alguien que ayudó en este negocio (colaborador, referido, otra agencia).
                    Se descuenta de la ganancia de la oficina y queda en Facturación con su comprobante.
                </p>
                <group>
                    <group>
                        <field name="order_id"/>
                        <field name="property_id"/>
                        <field name="partner_id" placeholder="Persona o empresa..."/>
                        <field name="concept"/>
                        <field name="amount"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="method" widget="radio"/>
                        <field name="reference" placeholder="Nº transferencia, recibo..."/>
                        <field name="bank_from" placeholder="Ej. Banco Pichincha" invisible="method == 'cash'"/>
                        <field name="bank_to" placeholder="Ej. Banco Guayaquil" invisible="method == 'cash'"/>
                        <field name="invoice_number" placeholder="Si entregó factura"/>
                    </group>
                </group>
                <group>
                    <field name="note" placeholder="Observaciones..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Registrar e imprimir comprobante"
                            class="btn-primary" icon="fa-check"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
