<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_comparator_wizard_view_form" model="ir.ui.view">
        <field name="name">estate.property.comparator.wizard.form</field>
        <field name="model">estate.property.comparator.wizard</field>
        <field name="arch" type="xml">
            <form string="Comparar Propiedades">
                <div class="alert alert-info mb-3" role="alert">
                    <i class="fa fa-info-circle"/> Selecciona entre <strong>2 y 4 propiedades</strong> para generar un reporte comparativo en PDF.
                </div>
                <group>
                    <field name="property_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"
                           domain="[('state', '!=', 'cancelled')]"
                           string="Propiedades"/>
                </group>
                <footer>
                    <button name="action_print_comparison" string="Generar PDF Comparativo"
                            type="object" class="btn-primary" icon="fa-file-pdf-o"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="estate_property_comparator_wizard_action" model="ir.actions.act_window">
        <field name="name">Comparar Propiedades</field>
        <field name="res_model">estate.property.comparator.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Reporte PDF de comparación -->
    <record id="action_report_property_comparison" model="ir.actions.report">
        <field name="name">Comparativa de Propiedades</field>
        <field name="model">estate.property.comparator.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate_management.report_property_comparison_template</field>
        <field name="report_file">estate_management.report_property_comparison_template</field>
        <field name="paperformat_id" ref="estate_management.paperformat_estate_a4"/>
    </record>

    <template id="report_property_comparison_template">
        <t t-call="web.html_container">
                <t t-set="props" t-value="env['estate.property'].browse(data.get('form', {}).get('property_ids', []))"/>
                    <div class="article" style="font-family:Arial,Helvetica,sans-serif; color:#222; font-size:11px;">

                        <!-- ══ ENCABEZADO ══════════════════════════════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; background:#1C2B4A; margin-bottom:12px;">
                            <tr>
                                <td style="padding:10px 16px; vertical-align:middle; width:60%;">
                                    <t t-if="env.company.logo">
                                        <img t-att-src="image_data_uri(env.company.logo)" style="height:28px; max-width:110px;"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font-size:15px; font-weight:900; color:white;"><t t-esc="env.company.name"/></span>
                                    </t>
                                </td>
                                <td style="padding:10px 16px; vertical-align:middle; text-align:right; width:40%;">
                                    <div style="font-size:13px; font-weight:900; color:white; text-transform:uppercase; letter-spacing:2px;">Comparativa de Propiedades</div>
                                    <div style="font-size:9px; color:#a8bcdb; margin-top:3px;">
                                        <t t-esc="len(props)"/> propiedades &#183; <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ TÍTULO ═══════════════════════════════════════════════════ -->
                        <div style="border-left:4px solid #C8102E; padding:8px 14px; background:#F8F9FB; border-top:1px solid #E0E4EC; border-right:1px solid #E0E4EC; border-bottom:1px solid #E0E4EC; margin-bottom:14px;">
                            <div style="font-size:7px; color:#C8102E; text-transform:uppercase; letter-spacing:2px; font-weight:700; margin-bottom:4px;">An&#225;lisis Comparativo</div>
                            <div style="font-size:15px; font-weight:900; color:#1C2B4A;">Tabla Comparativa de Propiedades</div>
                            <div style="font-size:9px; color:#666; margin-top:3px;">
                                Generado por <t t-esc="env.user.name"/> &#183; <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                            </div>
                        </div>

                        <!-- ══ TABLA COMPARATIVA ═══════════════════════════════════════ -->
                        <div style="background:#1C2B4A; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                            Comparaci&#243;n detallada
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none; margin-bottom:14px;">
                            <thead>
                                <tr style="background:#263d61; color:white;">
                                    <th style="padding:9px 12px; text-align:left; width:22%; font-weight:700; border-right:1px solid rgba(255,255,255,0.15);">Caracter&#237;stica</th>
                                    <t t-foreach="props" t-as="prop">
                                        <th style="padding:9px 12px; text-align:center; font-weight:700; border-right:1px solid rgba(255,255,255,0.15);">
                                            <t t-esc="prop.title or prop.name"/>
                                        </th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Precio -->
                                <tr style="background:#EEF2F8;">
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:700; color:#1C2B4A;">Precio</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center; font-weight:900; font-size:13px; color:#1C2B4A;">
                                            $<t t-esc="'{:,.0f}'.format(prop.price)"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Valor AVM -->
                                <tr>
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Valor Mercado (AVM)</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-if="prop.avm_estimated_price">
                                                $<t t-esc="'{:,.0f}'.format(prop.avm_estimated_price)"/>
                                                <br/>
                                                <span t-if="prop.avm_status == 'fair'"  style="color:#15803d; font-size:9px; font-weight:600;">Precio justo</span>
                                                <span t-elif="prop.avm_status == 'high'" style="color:#C8102E; font-size:9px; font-weight:600;">Sobre mercado</span>
                                                <span t-elif="prop.avm_status == 'low'"  style="color:#b45309; font-size:9px; font-weight:600;">Oportunidad</span>
                                            </t>
                                            <t t-else=""><span style="color:#aaa;">&#8212;</span></t>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Precio/m2 -->
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Precio / m&#178;</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-if="prop.area and prop.area > 0">
                                                $<t t-esc="'{:,.0f}'.format(prop.price / prop.area)"/>
                                            </t>
                                            <t t-else=""><span style="color:#aaa;">&#8212;</span></t>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Tipo -->
                                <tr>
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Tipo de Propiedad</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-esc="prop.property_type_id.name or '&#8212;'"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Operación -->
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Operaci&#243;n</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-esc="dict([('sale','Venta'),('rent','Arriendo'),('both','Venta/Arriendo')]).get(prop.offer_type,'&#8212;')"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Área total -->
                                <tr>
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">&#193;rea Total (m&#178;)</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center; font-weight:600;">
                                            <t t-esc="'{:,.0f}'.format(prop.area or 0)"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Dormitorios -->
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Dormitorios</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-esc="prop.bedrooms or '&#8212;'"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Baños -->
                                <tr>
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Ba&#241;os</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-esc="prop.bathrooms or '&#8212;'"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Parqueaderos -->
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Parqueaderos</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-esc="prop.parking_spaces or '&#8212;'"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Ciudad -->
                                <tr>
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Ciudad</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-esc="prop.city or '&#8212;'"/>
                                        </td>
                                    </t>
                                </tr>
                                <!-- Días en mercado -->
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">D&#237;as en Mercado</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <t t-esc="prop.days_on_market or 0"/> d&#237;as
                                        </td>
                                    </t>
                                </tr>
                                <!-- Score -->
                                <tr>
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Score Propiedad</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center; font-weight:700; color:#1C2B4A;">
                                            <t t-esc="prop.property_score or 0"/>/100
                                        </td>
                                    </t>
                                </tr>
                                <!-- Estado -->
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:8px 12px; border:1px solid #D8DCE5; font-weight:600; color:#555;">Estado</td>
                                    <t t-foreach="props" t-as="prop">
                                        <td style="padding:8px 12px; border:1px solid #D8DCE5; text-align:center;">
                                            <span t-if="prop.state == 'available'" style="color:#15803d; font-weight:700;">Disponible</span>
                                            <span t-elif="prop.state == 'reserved'" style="color:#b45309; font-weight:700;">Reservada</span>
                                            <span t-elif="prop.state == 'sold'" style="color:#666;">Vendida</span>
                                            <span t-else="" style="color:#1C2B4A;">Arrendada</span>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Nota -->
                        <div style="background:#F8F9FB; border:1px solid #D8DCE5; padding:10px 14px; font-size:10px; color:#555; margin-bottom:14px;">
                            Los precios y datos son informativos y est&#225;n sujetos a verificaci&#243;n. Reporte generado autom&#225;ticamente por el Sistema de Gesti&#243;n Inmobiliaria.
                        </div>

                        <!-- ══ PIE ═══════════════════════════════════════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; border-top:1px solid #D8DCE5; margin-top:12px; font-size:8px; color:#888;">
                            <tr>
                                <td style="padding:6px 0; width:60%;">
                                    <strong><t t-esc="env.company.name"/></strong>
                                    <t t-if="env.company.street"> &#183; <t t-esc="env.company.street"/></t>
                                    <t t-if="env.company.email"> &#183; <t t-esc="env.company.email"/></t>
                                </td>
                                <td style="text-align:right; padding:6px 0; width:40%; color:#1C2B4A; font-weight:600;">
                                    Emitido <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                </td>
                            </tr>
                        </table>

                    </div>
        </t>
    </template>

</odoo>
