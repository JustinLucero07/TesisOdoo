<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="estate_management.GalleryDropField">
        <div t-attf-class="o_gallery_drop {{ props.className ? props.className : '' }} {{ dragging ? 'o_gallery_drop_active' : '' }}"
             t-on-dragenter="onDragEnter" t-on-dragover="onDragOver"
             t-on-dragleave="onDragLeave" t-on-drop="onDrop" aria-atomic="true">

            <FileInput t-if="!props.readonly"
                acceptedFileExtensions="props.acceptedFileExtensions"
                multiUpload="true"
                onUpload.bind="onFileUploaded"
                resModel="props.record.resModel"
                resId="props.record.resId or 0">
                <div class="o_gallery_drop_zone" role="button" tabindex="0"
                     aria-label="Subir fotos y videos">
                    <div class="o_gallery_drop_icon">
                        <i t-attf-class="fa {{ dragging ? 'fa-arrow-down' : 'fa-cloud-upload' }}"/>
                    </div>
                    <div class="o_gallery_drop_text">
                        <div class="o_gallery_drop_title">
                            <t t-if="dragging">Suelta aquí tus fotos y videos</t>
                            <t t-else="">Arrastra fotos y videos aquí</t>
                        </div>
                        <div class="o_gallery_drop_subtitle">
                            o <span class="o_gallery_drop_link">haz clic para elegirlos</span>
                            desde tu computadora o tu celular
                        </div>
                        <div class="o_gallery_drop_formats">
                            <span><i class="fa fa-picture-o"/> JPG · PNG · WEBP</span>
                            <span class="o_gallery_drop_format_video"><i class="fa fa-film"/> MP4 · MOV · WEBM</span>
                        </div>
                    </div>
                </div>
            </FileInput>

            <div t-if="files.length" class="o_gallery_drop_pending">
                <div class="o_gallery_drop_pending_head">
                    <i class="fa fa-clock-o"/>
                    <span><b t-esc="pendingSummary"/> listos · se agregarán a la galería al <b>Guardar</b></span>
                </div>
                <div class="o_attachments o_gallery_drop_grid">
                    <t t-foreach="files" t-as="file" t-key="file_index">
                        <t t-call="web.Many2ManyBinaryField.attachment_preview"/>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
