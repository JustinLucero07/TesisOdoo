<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="estate_management.PayoutCardsField">
        <div class="o_estate_payout_cards">
            <div t-foreach="records" t-as="rec" t-key="rec.id" class="o_estate_payout_card">
                <div class="o_estate_payout_head">
                    <img t-if="userId(rec)" class="rounded-circle o_estate_payout_avatar"
                         t-attf-src="/web/image/res.users/{{ userId(rec) }}/avatar_128" alt=""/>
                    <div class="flex-grow-1">
                        <div class="fw-semibold" t-esc="userName(rec)"/>
                        <div class="text-muted small" t-esc="rec.data.roles"/>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small">Total a pagar</div>
                        <div class="fs-5 fw-semibold" t-esc="money(rec, rec.data.amount_total)"/>
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <div class="o_estate_payout_label">¿Cómo se le paga?</div>
                        <div t-foreach="options(rec, 'payment_method')" t-as="opt" t-key="opt[0]" class="form-check">
                            <input class="form-check-input" type="radio"
                                   t-att-name="'pm_' + rec.id" t-att-id="'pm_' + rec.id + opt[0]"
                                   t-att-checked="rec.data.payment_method === opt[0]"
                                   t-att-disabled="readonly"
                                   t-on-change="() => this.set(rec, 'payment_method', opt[0])"/>
                            <label class="form-check-label" t-att-for="'pm_' + rec.id + opt[0]" t-esc="opt[1]"/>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="o_estate_payout_label">¿Factura?</div>
                        <div t-foreach="options(rec, 'invoice')" t-as="opt" t-key="opt[0]" class="form-check">
                            <input class="form-check-input" type="radio"
                                   t-att-name="'inv_' + rec.id" t-att-id="'inv_' + rec.id + opt[0]"
                                   t-att-checked="rec.data.invoice === opt[0]"
                                   t-att-disabled="readonly"
                                   t-on-change="() => this.set(rec, 'invoice', opt[0])"/>
                            <label class="form-check-label" t-att-for="'inv_' + rec.id + opt[0]" t-esc="opt[1]"/>
                        </div>
                        <div class="o_estate_payout_label mt-3">Fecha de pago</div>
                        <input type="date" class="form-control form-control-sm"
                               t-att-value="dateValue(rec)" t-att-disabled="readonly"
                               t-on-change="(ev) => this.onDate(rec, ev)"/>
                    </div>
                    <div class="col-md-4">
                        <div class="o_estate_payout_label">Comprobante / Referencia</div>
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Nº transferencia, recibo, cheque..."
                               t-att-value="rec.data.payment_reference or ''" t-att-disabled="readonly"
                               t-on-change="(ev) => this.set(rec, 'payment_reference', ev.target.value)"/>
                        <t t-if="rec.data.payment_method !== 'cash'">
                            <div class="o_estate_payout_label mt-2">Banco de origen</div>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Desde qué banco paga la oficina"
                                   t-att-value="rec.data.payment_bank_from or ''" t-att-disabled="readonly"
                                   t-on-change="(ev) => this.set(rec, 'payment_bank_from', ev.target.value)"/>
                            <div class="o_estate_payout_label mt-2">Banco de destino</div>
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Banco del asesor"
                                   t-att-value="rec.data.payment_bank_to or ''" t-att-disabled="readonly"
                                   t-on-change="(ev) => this.set(rec, 'payment_bank_to', ev.target.value)"/>
                        </t>
                        <table class="o_estate_payout_sum mt-3">
                            <tr><td>Monto base</td><td t-esc="money(rec, rec.data.amount_base)"/></tr>
                            <tr><td>IVA</td><td t-esc="money(rec, rec.data.amount_vat)"/></tr>
                            <tr class="fw-semibold"><td>Total</td><td t-esc="money(rec, rec.data.amount_total)"/></tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
