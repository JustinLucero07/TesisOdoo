<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aparece en el menú "Acciones" al marcar filas en la lista de la galería. -->
    <record id="action_download_selected_images" model="ir.actions.server">
        <field name="name">Descargar seleccionadas (ZIP)</field>
        <field name="model_id" ref="model_estate_property_image"/>
        <field name="binding_model_id" ref="model_estate_property_image"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_download_selection()</field>
    </record>
</odoo>
