<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El menú de ventas se ha consolidado en estate_menus.xml -->


    <!-- Heredar la vista de pedidos para inyectar propiedad -->
    <record id="view_order_form_inherit_estate" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.estate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(estate_management.action_report_estate_contract)d" string=" Generar Contrato AI" type="action" class="btn-primary"/>
                <button name="action_estate_mark_collected" type="object"
                        string="Marcar comisión cobrada" icon="fa-check-circle"
                        invisible="not property_id or state != 'sale' or estate_commission_collected"/>
                <button name="action_estate_unmark_collected" type="object"
                        string="Quitar cobro manual" icon="fa-undo"
                        invisible="not estate_collected_manual"
                        confirm="¿Quitar la marca de comisión cobrada? Se anula el cobro registrado en Facturación."/>
                <button name="action_estate_print_collection" type="object"
                        string="Imprimir recibo de cobro" icon="fa-print"
                        invisible="not estate_commission_collected"/>
                <button name="%(estate_management.action_estate_payment_correct_wizard)d" type="action"
                        string="Corregir cobro" icon="fa-pencil"
                        invisible="not estate_commission_collected"
                        context="{'default_kind': 'collection'}"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <widget name="web_ribbon" title="Cobrada" bg_color="text-bg-success"
                        invisible="not estate_commission_collected"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-home" type="object"
                        name="action_estate_view_property" invisible="not property_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Propiedad</span>
                    </div>
                </button>
                <button class="oe_stat_button" icon="fa-percent" type="object"
                        name="action_estate_open_commission" invisible="not property_id">
                    <field name="estate_link_commission_count" string="Comisión" widget="statinfo"/>
                </button>
                <button class="oe_stat_button" icon="fa-download" type="object"
                        name="action_estate_view_collection"
                        invisible="estate_link_collection_count == 0 and not estate_commission_collected">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Cobro</span>
                        <span class="o_stat_value">
                            <field name="estate_collection_state" readonly="1"/>
                        </span>
                    </div>
                </button>
                <button class="oe_stat_button" icon="fa-upload" type="object"
                        name="action_estate_view_advisor_payments"
                        invisible="estate_link_advisor_payment_count == 0">
                    <field name="estate_link_advisor_payment_count" string="Pagos a asesores" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Cliente (Propietario)</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="property_id"/>
                <field name="estate_transaction_type"/>
                <field name="lead_id"/>
                <field name="estate_collected_manual" invisible="1"/>
                <field name="estate_commission_collected" invisible="not property_id"/>
                <field name="estate_collected_date" invisible="not estate_commission_collected"/>
                <field name="estate_collected_manual_date" string="Fecha de cobro (editar)"
                       invisible="not estate_collected_manual"/>
            </xpath>
            <!-- El negocio en orden: venta → cobro → pago a asesores -->
            <xpath expr="//page[@name='order_lines']" position="before">
                <page string="Proceso de la venta" name="page_estate_deal"
                      invisible="not property_id or state != 'sale'">
                    <field name="estate_deal_stage" widget="statusbar" class="mb-3"/>
                    <group>
                        <group string="① Venta">
                            <field name="estate_date_sold" string="Fecha"/>
                            <field name="estate_buyer_id" string="Comprador"/>
                            <field name="estate_sale_price" string="Valor" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="amount_total" string="Comisión" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group string="② Cobro de la comisión al propietario">
                            <field name="estate_collection_state" string="Estado" widget="badge"
                                   decoration-success="estate_collection_state == 'collected'"
                                   decoration-warning="estate_collection_state == 'pending'"/>
                            <field name="estate_collected_date" invisible="not estate_commission_collected"/>
                            <field name="estate_collected_method" invisible="not estate_commission_collected"/>
                            <field name="estate_collected_invoice" invisible="not estate_commission_collected"/>
                            <field name="estate_collected_reference" invisible="not estate_collected_reference"/>
                            <field name="estate_collected_bank_from" string="Banco de origen" invisible="not estate_collected_bank_from"/>
                            <field name="estate_collected_bank_to" string="Banco de destino" invisible="not estate_collected_bank_to"/>
                            <div colspan="2" invisible="not estate_commission_collected">
                                <button name="action_estate_view_collection" type="object"
                                        string="Ver cobro" icon="fa-money"
                                        class="btn-secondary btn-sm me-2"/>
                                <button name="action_estate_print_collection" type="object"
                                        string="Imprimir recibo" icon="fa-print"
                                        class="btn-secondary btn-sm"/>
                            </div>
                            <div colspan="2" invisible="estate_commission_collected">
                                <button name="action_estate_mark_collected" type="object"
                                        string="Marcar comisión cobrada" icon="fa-check-circle"
                                        class="btn-primary btn-sm"/>
                            </div>
                        </group>
                        <group string="③ Pago a los asesores">
                            <field name="estate_advisors_state" string="Estado" widget="badge"
                                   decoration-success="estate_advisors_state == 'paid'"
                                   decoration-warning="estate_advisors_state == 'pending'"/>
                            <field name="estate_advisor_roles" string="Asesores"/>
                            <div colspan="2" invisible="estate_advisors_state == 'paid'">
                                <button name="action_estate_open_commission" type="object"
                                        string="Repartir y pagar" icon="fa-users"
                                        class="btn-secondary btn-sm"/>
                                <span class="text-muted small ms-2" invisible="estate_commission_collected">
                                    El pago se habilita cuando la comisión esté cobrada.
                                </span>
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- Firma digital del cliente inmobiliario -->
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Firma Inmobiliaria" name="page_estate_signature">
                    <group>
                        <group string="Firma Digital del Cliente">
                            <field name="customer_signature" widget="signature"
                                   string="Firma del Cliente"
                                   readonly="state in ('sale', 'done', 'cancel')"/>
                            <field name="signature_date" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="customer_signature">
                        <i class="fa fa-info-circle" title="Información"/>
                        El cliente puede firmar directamente sobre este campo.
                        La firma queda registrada con fecha y hora automáticamente.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Heredar la vista de lista de pedidos para inyectar propiedad -->
    <record id="view_order_tree_inherit_estate" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.estate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_estate_wrap_list</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Cliente (Propietario)</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="estate_buyer_id" optional="show"/>
                <field name="estate_buyer_phones" optional="show" width="125px"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="estate_owner_phones" optional="show" width="125px"/>
                <field name="property_id" string="Propiedad Vinculada" optional="show"/>
                <field name="estate_transaction_type" optional="hide"/>
                <field name="property_sold_by" optional="hide"/>
                <field name="estate_source" optional="show"/>
                <field name="estate_advisor_roles" optional="show"/>
                <field name="estate_date_sold" optional="show"/>
                <field name="estate_sale_price" sum="Total vendido" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Heredar la vista de Cotizaciones para inyectar propiedad -->
    <record id="view_quotation_tree_with_onboarding_inherit_estate" model="ir.ui.view">
        <field name="name">sale.quotation.tree.inherit.estate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_date']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//list" position="attributes">
                <attribute name="class">o_estate_wrap_list</attribute>
            </xpath>
            <xpath expr="//field[@name='activity_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="string">Cliente (Propietario)</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="estate_buyer_id" optional="show"/>
                <field name="estate_buyer_phones" optional="show" width="125px"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="estate_owner_phones" optional="show" width="125px"/>
                <field name="property_id" string="Propiedad Vinculada" optional="show"/>
                <field name="estate_transaction_type" optional="hide"/>
                <field name="property_sold_by" optional="hide"/>
                <field name="estate_source" optional="show"/>
                <field name="estate_advisor_roles" optional="show"/>
                <field name="estate_date_sold" optional="show"/>
                <field name="estate_sale_price" sum="Total vendido" optional="show"/>
            </xpath>
        </field>
    </record>
    <!-- Buscar y filtrar por quién cerró la venta -->
    <record id="view_sales_order_filter_inherit_estate" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.estate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_type_id']" position="after">
                <field name="property_id" string="Propiedad Vinculada"/>
                <field name="property_sold_by" string="Cerrado por"/>
                <field name="estate_buyer_id" string="Comprador"/>
                <field name="estate_source" string="Difusión"/>
                <field name="partner_id" string="Teléfono"
                       filter_domain="['|', '|', '|',
                                       ('partner_id.phone', 'ilike', self),
                                       ('partner_id.mobile', 'ilike', self),
                                       ('estate_buyer_id.phone', 'ilike', self),
                                       ('estate_buyer_id.mobile', 'ilike', self)]"/>
            </xpath>
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="estate_closed_agency" string="Cerrado por: Agencia"
                        domain="[('property_sold_by', '=', 'agency')]"/>
                <filter name="estate_closed_owner" string="Cerrado por: Propietario"
                        domain="[('property_sold_by', '=', 'owner')]"/>
                <filter name="estate_closed_external" string="Cerrado por: Externo"
                        domain="[('property_sold_by', '=', 'external')]"/>
                <separator/>
                <filter name="estate_not_cancelled" string="Sin canceladas"
                        domain="[('state', '!=', 'cancel')]"/>
                <separator/>
                <filter name="estate_collected" string="Comisión cobrada"
                        domain="[('estate_commission_collected', '=', True)]"/>
                <filter name="estate_not_collected" string="Comisión por cobrar"
                        domain="[('estate_commission_collected', '=', False), ('state', '=', 'sale')]"/>
                <separator/>
                <filter name="estate_date_sold_filter" string="Fecha de venta"
                        date="estate_date_sold"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="estate_group_sold_by" string="Cerrado por"
                        context="{'group_by': 'property_sold_by'}"/>
                <filter name="estate_group_source" string="Difusión"
                        context="{'group_by': 'estate_source'}"/>
                <filter name="estate_group_buyer" string="Comprador"
                        context="{'group_by': 'estate_buyer_id'}"/>
                <filter name="estate_group_date_sold" string="Fecha de venta"
                        context="{'group_by': 'estate_date_sold:month'}"/>
                <filter name="estate_group_collected_method" string="Forma de cobro"
                        context="{'group_by': 'estate_collected_method'}"/>
                <filter name="estate_group_collected_invoice" string="Con / sin factura"
                        context="{'group_by': 'estate_collected_invoice'}"/>
                <filter name="estate_group_collected_date" string="Fecha de cobro"
                        context="{'group_by': 'estate_collected_date:month'}"/>
            </xpath>
        </field>
    </record>

    <!-- Ventas cobradas: la misma hoja que se llevaba en Excel -->
    <record id="view_sale_order_estate_collected_list" model="ir.ui.view">
        <field name="name">sale.order.list.estate.collected</field>
        <field name="model">sale.order</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Ventas y comisiones cobradas" class="o_estate_wrap_list" create="0" default_order="estate_date_sold desc"
                  decoration-muted="not estate_commission_collected">
                <field name="estate_date_sold" string="Fecha"/>
                <field name="estate_buyer_id" string="Comprador"/>
                <field name="partner_id" string="Vendedor (Propietario)" width="190px"/>
                <field name="property_id" string="Propiedad"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" string="Comisión" sum="Total comisión"
                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estate_capture_initials"/>
                <field name="estate_reception_initials"/>
                <field name="estate_visit_initials"/>
                <field name="estate_closing_initials"/>
                <field name="estate_sale_price" string="Valor de venta" sum="Total vendido" optional="hide"/>
                <field name="estate_source" optional="hide"/>
                <field name="name" string="Orden" optional="hide"/>
                <field name="estate_commission_collected" column_invisible="1"/>
                <field name="estate_collection_state" widget="badge"
                       decoration-success="estate_collection_state == 'collected'"
                       decoration-warning="estate_collection_state == 'pending'"/>
                <field name="estate_collected_date" optional="show"/>
                <field name="estate_collected_method" optional="show"/>
                <field name="estate_collected_invoice" optional="hide"/>
                <field name="estate_collected_reference" optional="hide"/>
                <button name="action_estate_mark_collected" type="object" icon="fa-check-circle"
                        title="Marcar comisión cobrada" string="Marcar cobrada"
                        invisible="estate_commission_collected"/>
                <field name="estate_advisors_state" widget="badge"
                       decoration-success="estate_advisors_state == 'paid'"
                       decoration-warning="estate_advisors_state == 'pending'"
                       decoration-muted="estate_advisors_state == 'none'"/>
                <button name="action_estate_open_commission" type="object" icon="fa-users"
                        title="Repartir y pagar la comisión a los asesores" string="Pagar asesores"
                        invisible="not estate_commission_collected or estate_advisors_state == 'paid'"/>
                <button name="action_estate_open_commission" type="object" icon="fa-sitemap"
                        title="Anotar quién hizo captación, recepción, visita y cierre (sin pagar)"
                        string="Reparto"
                        invisible="estate_commission_collected or estate_advisors_state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="action_sale_order_estate_collected" model="ir.actions.act_window">
        <field name="name">Ventas cobradas</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="view_id" ref="view_sale_order_estate_collected_list"/>
        <field name="domain">[('property_id', '!=', False), ('state', '=', 'sale'), ('amount_total', '>', 0)]</field>
        <field name="context">{'search_default_estate_collected': 1, 'search_default_estate_group_date_sold': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay ventas con la comisión cobrada.</p>
            <p>Una venta pasa aquí cuando la marcas con "Marcar cobrada" en
               Comisiones por cobrar, con la fecha y la forma de pago reales.</p>
        </field>
    </record>

    <record id="action_sale_order_estate_to_collect" model="ir.actions.act_window">
        <field name="name">Comisiones por cobrar</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="view_id" ref="view_sale_order_estate_collected_list"/>
        <field name="domain">[('property_id', '!=', False), ('state', '=', 'sale'), ('amount_total', '>', 0)]</field>
        <field name="context">{'search_default_estate_not_collected': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay comisiones pendientes de cobro.</p>
            <p>Cuando el propietario te pague, usa "Marcar cobrada" (o selecciona varias y
               Acciones → Marcar comisión cobrada) y pon la fecha real del cobro.</p>
        </field>
    </record>



    <!-- Las ventas abren sin las órdenes canceladas -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="context">{'search_default_estate_not_cancelled': 1}</field>
    </record>
    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="context">{'search_default_estate_not_cancelled': 1}</field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="context">{'search_default_sales': 1}</field>
    </record>

    <!-- Ganancias de la oficina: solo ventas con la comisión ya cobrada -->
    <record id="view_sale_order_estate_office_list" model="ir.ui.view">
        <field name="name">sale.order.list.estate.office</field>
        <field name="model">sale.order</field>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <list string="Ganancias de la oficina" class="o_estate_wrap_list" create="0"
                  default_order="estate_collected_date desc">
                <field name="estate_collected_date" string="Cobrada el"/>
                <field name="name" string="Orden" optional="hide"/>
                <field name="property_id" string="Propiedad"/>
                <field name="partner_id" string="Propietario" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="estate_sale_price" string="Venta" optional="show"/>
                <field name="amount_untaxed" string="Honorarios cobrados" sum="Honorarios"
                       widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="estate_advisors_amount" sum="A asesores" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="estate_advisors_pct" optional="show"/>
                <field name="estate_office_amount" sum="Ganancia neta" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       decoration-success="estate_office_amount &gt; 0"/>
                <field name="estate_advisors_state" widget="badge"
                       decoration-success="estate_advisors_state == 'paid'"
                       decoration-warning="estate_advisors_state == 'pending'"
                       decoration-muted="estate_advisors_state == 'none'"/>
                <field name="estate_collected_method" optional="show"/>
                <field name="estate_collected_invoice" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_estate_office_pivot" model="ir.ui.view">
        <field name="name">sale.order.pivot.estate.office</field>
        <field name="model">sale.order</field>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <pivot string="Ganancias de la oficina" sample="1">
                <field name="estate_collected_date" interval="month" type="row"/>
                <field name="amount_untaxed" type="measure" string="Honorarios cobrados"/>
                <field name="estate_advisors_amount" type="measure"/>
                <field name="estate_office_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sale_order_estate_office_graph" model="ir.ui.view">
        <field name="name">sale.order.graph.estate.office</field>
        <field name="model">sale.order</field>
        <field name="priority">91</field>
        <field name="arch" type="xml">
            <graph string="Ganancias de la oficina" type="bar" sample="1">
                <field name="estate_collected_date" interval="month"/>
                <field name="estate_office_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_estate_commission_office" model="ir.actions.act_window">
        <field name="name">Ganancias de la Oficina</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="domain">[('property_id', '!=', False), ('state', '=', 'sale'), ('amount_total', '>', 0), ('estate_commission_collected', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_sale_order_estate_office_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_sale_order_estate_office_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_sale_order_estate_office_graph')})]"/>
        <field name="context">{'search_default_estate_group_collected_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay ventas cobradas.</p>
            <p>Lo que le queda a la inmobiliaria de cada venta <b>ya cobrada</b>: los honorarios
               que pagó el propietario menos lo que va a los asesores.</p>
        </field>
    </record>
</odoo>