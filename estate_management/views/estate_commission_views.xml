<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         GRÁFICO — Rendimiento de Asesores
    ============================================================ -->
    <record id="estate_commission_view_graph" model="ir.ui.view">
        <field name="name">estate.commission.graph</field>
        <field name="model">estate.commission</field>
        <field name="arch" type="xml">
            <graph string="Rendimiento de Asesores" type="bar" sample="1">
                <field name="user_id" type="row"/>
                <field name="type" type="col"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============================================================
         PIVOT — Análisis 360 de Comisiones
    ============================================================ -->
    <record id="estate_commission_view_pivot" model="ir.ui.view">
        <field name="name">estate.commission.pivot</field>
        <field name="model">estate.commission</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Comisiones" display_quantity="true" sample="1">
                <field name="user_id" type="row"/>
                <field name="type" type="col"/>
                <field name="amount" type="measure"/>
                <field name="date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ============================================================
         LISTA
    ============================================================ -->
    <record id="estate_commission_view_tree" model="ir.ui.view">
        <field name="name">estate.commission.tree</field>
        <field name="model">estate.commission</field>
        <field name="arch" type="xml">
            <list string="Comisiones"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'paid'"
                  decoration-warning="state == 'approved'"
                  decoration-danger="state == 'cancelled'">
                <field name="date"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="role" optional="show"/>
                <field name="role_pct" string="% del rol" optional="show"/>
                <field name="deal_total_amount" string="Comisión del negocio" widget="monetary"
                       options="{'currency_field': 'company_currency'}" optional="show"/>
                <field name="lead_id" optional="show"/>
                <field name="property_id"/>
                <field name="type" widget="badge"
                       decoration-info="type == 'rental'"
                       decoration-success="type == 'sale'"
                       decoration-warning="type == 'bonus'"/>
                <field name="sale_amount" widget="monetary" string="Venta"
                       options="{'currency_field': 'company_currency'}" optional="show"/>
                <field name="commission_pct" string="% s/venta" optional="hide"/>
                <field name="parent_commission_id" string="Reparto de" optional="hide"/>
                <field name="amount" sum="Total Comisiones" widget="monetary"
                       options="{'currency_field': 'company_currency'}"/>
                <field name="company_currency" column_invisible="1"/>
                <field name="invoice_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'approved'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         FORMULARIO
    ============================================================ -->
    <record id="estate_commission_view_form" model="ir.ui.view">
        <field name="name">estate.commission.form</field>
        <field name="model">estate.commission</field>
        <field name="arch" type="xml">
            <form string="Comisión Inmobiliaria">
                <header>
                    <button name="action_approve" string="Aprobar" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_invoice"
                            string="Generar Factura" type="object"
                            invisible="1"/>
                    <button name="action_view_invoice" string="Ver Factura" type="object"
                            invisible="not invoice_id"/>
                    <button name="action_generate_split" string="Preparar reparto"
                            type="object" class="btn-secondary" icon="fa-users"
                            invisible="state in ('paid', 'cancelled', 'split') or split_count &gt; 0 or parent_commission_id"
                            help="Carga los cuatro pasos del negocio con sus porcentajes para asignar quién hizo cada uno."/>
                    <button name="action_split_into_commissions" string="Generar comisiones por asesor"
                            type="object" class="btn-primary" icon="fa-share-alt"
                            invisible="state in ('paid', 'cancelled', 'split') or split_count == 0"
                            confirm="Se creará una comisión aprobada por cada asesor del reparto y esta quedará como el total del negocio. ¿Continuar?"/>
                    <button name="action_pay_all_children" string="Pagar a todos los asesores"
                            type="object" class="btn-success" icon="fa-check-circle"
                            invisible="state != 'split'"
                            confirm="Se generará la factura de proveedor de cada asesor y se registrará su pago. ¿Continuar?"/>
                    <button name="action_undo_split" string="Deshacer reparto"
                            type="object" invisible="state != 'split'"
                            confirm="Se borrarán las comisiones por asesor generadas. ¿Continuar?"/>
                    <button name="action_register_payment" string="Pagar Comisión y Facturar"
                            type="object" class="btn-success" icon="fa-check-circle"
                            invisible="state not in ('draft', 'approved') or split_count &gt; 0"
                            confirm="Se generará/confirmará la factura de comisión y se registrará su pago contable en un solo paso. ¿Continuar?"/>
                    <button name="action_reset_to_approved" string="Revertir Pago" type="object"
                            invisible="state != 'paid'"
                            confirm="¿Revertir el pago registrado? La comisión volverá a Aprobada."/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('paid', 'cancelled')"
                            confirm="¿Está seguro de cancelar esta comisión?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,paid"/>
                    <field name="split_count" invisible="1"/>
                    <field name="child_count" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-file-text-o"
                                type="object" name="action_view_invoice"
                                invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Factura</span>
                                <span class="o_stat_value">
                                    <field name="invoice_state" readonly="1"/>
                                </span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-users"
                                type="object" name="action_view_children"
                                invisible="child_count == 0">
                            <field name="child_count" string="Asesores" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="REPARTIDA" bg_color="text-bg-info"
                            invisible="state != 'split'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Comisión">
                            <field name="lead_id" placeholder="Seleccionar Oportunidad / Lead..."/>
                            <field name="property_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="role" invisible="not parent_commission_id"/>
                            <field name="role_pct" invisible="not parent_commission_id"/>
                            <field name="deal_total_amount" widget="monetary"
                                   options="{'currency_field': 'company_currency'}"
                                   invisible="not parent_commission_id"/>
                            <field name="parent_commission_id" readonly="1"
                                   invisible="not parent_commission_id"/>
                            <field name="type"/>
                            <field name="date"/>
                        </group>
                        <group string="Cálculo de Comisión">
                            <field name="sale_amount" widget="monetary"
                                   options="{'currency_field': 'company_currency'}"/>
                            <field name="commission_pct"/>
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'company_currency'}"/>
                            <field name="company_currency"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook invisible="parent_commission_id">
                        <page string="Reparto entre asesores" name="split">
                            <p class="text-muted">
                                Qui&#233;n hizo cada paso de <b>este</b> negocio. Var&#237;a de una venta a
                                otra: uno recibe el contacto, otro hace la visita, otro cierra y la
                                captaci&#243;n puede ser de un cuarto. Los porcentajes vienen de
                                Configuraci&#243;n &gt; Ajustes y se pueden ajustar aqu&#237; caso por caso.
                            </p>
                            <field name="split_line_ids" readonly="state in ('paid', 'split', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="role"/>
                                    <field name="user_id" widget="many2one_avatar_user"
                                           placeholder="Asignar asesor..."/>
                                    <field name="percentage"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'company_currency'}"/>
                                    <field name="note" placeholder="Observaci&#243;n"/>
                                    <field name="company_currency" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="pct_assigned" string="% repartido"/>
                                <field name="amount_assigned" widget="monetary"
                                       options="{'currency_field': 'company_currency'}"/>
                                <field name="amount_office" widget="monetary"
                                       options="{'currency_field': 'company_currency'}"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Comisiones por asesor" name="children"
                              invisible="child_count == 0">
                            <field name="child_commission_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="role_pct"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'company_currency'}"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-info="state == 'approved'"/>
                                    <field name="company_currency" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Pago al Asesor (Constancia)" name="payment_proof"
                           invisible="state == 'split' and child_count == 0">
                        <group>
                            <field name="payment_method"
                                   readonly="state == 'paid'"
                                   required="state == 'paid'"/>
                            <field name="payment_reference" readonly="state == 'paid'"
                                   placeholder="Nº transferencia, recibo, cheque..."/>
                        </group>
                        <group>
                            <field name="payment_date" readonly="state == 'paid'"/>
                            <field name="paid_by_id" invisible="state != 'paid'"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================
         BÚSQUEDA
    ============================================================ -->
    <record id="estate_commission_view_search" model="ir.ui.view">
        <field name="name">estate.commission.search</field>
        <field name="model">estate.commission</field>
        <field name="arch" type="xml">
            <search string="Buscar Comisiones">
                <field name="name"/>
                <field name="user_id"/>
                <field name="lead_id"/>
                <field name="property_id"/>
                <filter string="Borrador" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Aprobada" name="approved" domain="[('state','=','approved')]"/>
                <filter string="Pagada" name="paid" domain="[('state','=','paid')]"/>
                <separator/>
                <filter string="Venta" name="type_sale" domain="[('type','=','sale')]"/>
                <filter string="Alquiler" name="type_rental" domain="[('type','=','rental')]"/>
                <filter string="Bono" name="type_bonus" domain="[('type','=','bonus')]"/>
                <separator/>
                <filter string="Sin Factura" name="no_invoice" domain="[('invoice_id','=',False)]"/>
                <separator/>
                <filter string="Solo comisiones por asesor" name="only_children"
                        domain="[('state','!=','split')]"
                        help="Oculta el total del negocio y deja lo que cobra cada asesor."/>
                <filter string="Solo totales repartidos" name="only_parents"
                        domain="[('state','=','split')]"/>
                <separator/>
                <filter string="Agrupar por Asesor" name="group_user"
                        context="{'group_by': 'user_id'}"/>
                <filter string="Agrupar por Propiedad" name="group_property"
                        context="{'group_by': 'property_id'}"/>
                <filter string="Agrupar por Rol" name="group_role"
                        context="{'group_by': 'role'}"/>
                <filter string="Agrupar por Tipo" name="group_type"
                        context="{'group_by': 'type'}"/>
                <filter string="Agrupar por Mes" name="group_month"
                        context="{'group_by': 'date:month'}"/>
                <filter string="Agrupar por Estado" name="group_state"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================
         ACCIÓN
    ============================================================ -->
    <record id="action_estate_commission_dashboard" model="ir.actions.act_window">
        <field name="name">Inteligencia de Comisiones</field>
        <field name="res_model">estate.commission</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Centro de Inteligencia Financiera.
            </p>
            <p>Aquí verás el rendimiento real de tus asesores y la salud financiera de tus cierres.</p>
        </field>
    </record>

    <!-- Estado de pago: devengado (borrador/aprobada) vs pagado, de un vistazo -->
    <record id="action_estate_commission_payment_status" model="ir.actions.act_window">
        <field name="name">Estado de Pago de Comisiones</field>
        <field name="res_model">estate.commission</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin comisiones registradas.</p>
            <p>Agrupadas por estado: ve cuánto está <b>devengado</b> (borrador/aprobada) y cuánto ya <b>pagado</b>. Cada grupo suma el total.</p>
        </field>
    </record>

</odoo>
