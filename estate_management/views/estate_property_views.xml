<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acceso directo en el menú "Acción": crear un contrato de la propiedad -->
    <record id="action_property_new_contract" model="ir.actions.server">
        <field name="name">Nuevo Contrato</field>
        <field name="model_id" ref="estate_management.model_estate_property"/>
        <field name="binding_model_id" ref="estate_management.model_estate_property"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_new_contract()</field>
    </record>

    <!-- ==================== TREE VIEW ==================== -->
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Propiedades" decoration-muted="state == 'draft'" decoration-success="state == 'available'" decoration-danger="state == 'sold'" decoration-warning="state == 'reserved'">
                <field name="image_main" widget="image" options="{'size': [150, 150]}" />
                <field name="name"/>
                <field name="title"/>
                <field name="property_type_id"/>

                <field name="city"/>
                <field name="price" widget="monetary"/>
                <field name="area"/>
                <field name="bedrooms"/>
                <field name="days_on_market" optional="show"
                       decoration-warning="days_on_market &gt; 60"
                       decoration-danger="days_on_market &gt; 120"/>
                <field name="avm_status" optional="hide" widget="badge"
                       decoration-success="avm_status == 'fair'"
                       decoration-warning="avm_status == 'high'"
                       decoration-danger="avm_status == 'low'"/>
                <field name="sold_by" optional="hide"/>
                <field name="contract_end_date" optional="hide"/>
                <field name="wp_published" string="WP" optional="show" widget="boolean"
                       decoration-success="wp_published == True"/>
                <field name="state" widget="badge" decoration-muted="state == 'draft'" decoration-success="state == 'available'" decoration-danger="state == 'sold'" decoration-warning="state == 'reserved'"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Propiedad">
                <header>
                    <!-- Borrador: acción principal = Publicar -->
                    <button name="action_publish" string="Publicar en Mercado" type="object"
                            class="btn-primary oe_highlight" icon="fa-rocket"
                            invisible="state != 'draft'"
                            confirm="¿Confirmas publicar esta propiedad en el mercado?"/>
                    <button name="action_set_draft" string="Volver a Borrador" type="object"
                            class="btn-secondary"
                            invisible="state not in ('available', 'reserved')"
                            confirm="¿Retirar del mercado y guardar como borrador?"/>

                    <!-- Disponible → Reservado → Vendido / Arrendado -->
                    <button name="action_set_available" string="Disponible" type="object"
                            class="oe_highlight" invisible="state != 'reserved'"
                            confirm="¿Marcar esta propiedad como disponible nuevamente?"/>
                    <button name="action_set_reserved" string="Reservar" type="object"
                            invisible="state != 'available'"
                            confirm="¿Reservar esta propiedad? Quedará bloqueada para otros compradores."/>
                    <button name="action_open_sale_wizard" string="Vender Propiedad" type="object"
                            class="btn-success oe_highlight" icon="fa-handshake-o"
                            invisible="state not in ('available', 'reserved') or offer_type == 'rent'"
                            confirm="¿Iniciar el proceso de venta para esta propiedad?"/>
                    <button name="action_set_rented" string="Arrendar Propiedad" type="object"
                            class="btn-success oe_highlight" icon="fa-key"
                            invisible="state not in ('available', 'reserved') or offer_type == 'sale'"
                            confirm="¿Confirmar arriendo? Se registrará la comisión del primer mes."/>
                    <button name="action_relist" string="Re-listar en Mercado" type="object"
                            class="btn-warning"
                            invisible="state not in ('sold', 'rented')"
                            confirm="¿Confirmas re-listar esta propiedad? Se borrarán los datos anteriores."/>
                    <button name="action_edit_deal" string="Modificar Cierre / Observaciones" type="object"
                            class="btn-secondary" icon="fa-pencil-square-o"
                            invisible="state != 'sold'"
                            title="Modificar los detalles del negocio cerrado, forma de pago y observaciones"/>
                    <button name="action_cancel_sale" string="Anular Venta" type="object"
                            class="btn-danger" icon="fa-ban"
                            groups="estate_management.estate_group_manager"
                            invisible="state != 'sold'"
                            confirm="¿Confirmas ANULAR esta venta? Se cancelará la orden de venta, la factura y la comisión asociadas, y la propiedad volverá a estar Disponible. Esta acción no se puede deshacer."/>

                    <!-- Acciones secundarias (solo cuando no es borrador) -->
                    <button name="action_open_map" string="Ver en Mapa" type="object"
                            class="btn-info" invisible="not map_url"/>
                    <button name="action_calculate_avm" string="Calcular AVM" type="object"
                            class="btn-warning" invisible="state in ('draft', 'sold', 'rented')"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,available,reserved,sold,rented"/>
                </header>
                <sheet>
                    <!-- Sellos de estado visibles en la esquina superior -->
                    <widget name="web_ribbon" title="VENDIDO" bg_color="text-bg-danger"
                            invisible="state != 'sold'"/>
                    <widget name="web_ribbon" title="ARRENDADO" bg_color="text-bg-success"
                            invisible="state != 'rented'"/>
                    <widget name="web_ribbon" title="BORRADOR" bg_color="text-bg-secondary"
                            invisible="state != 'draft'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Título de la propiedad"/>
                        </h1>
                        <h3>
                            <field name="name" readonly="1"/>
                        </h3>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_meetings" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="meeting_count" string="Citas" widget="statinfo"/>
                        </button>
                        <button name="action_view_offers" type="object" class="oe_stat_button" icon="fa-handshake-o"
                                invisible="offer_count == 0">
                            <field name="offer_count" string="Ofertas" widget="statinfo"/>
                        </button>
                        <button name="action_view_expenses" type="object" class="oe_stat_button" icon="fa-wrench"
                                invisible="expense_count == 0">
                            <field name="expense_count" string="Gastos" widget="statinfo"/>
                        </button>
                        <button name="action_view_appraisals" type="object" class="oe_stat_button" icon="fa-balance-scale"
                                invisible="appraisal_count == 0">
                            <field name="appraisal_count" string="Tasaciones" widget="statinfo"/>
                        </button>
                        <button name="action_view_price_history" type="object" class="oe_stat_button" icon="fa-line-chart"
                                invisible="price_history_count == 0">
                            <field name="price_history_count" string="Cambios Precio" widget="statinfo"/>
                        </button>
                        <button name="action_view_property_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="property_invoice_count == 0">
                            <field name="property_invoice_count" string="Facturas" widget="statinfo"/>
                        </button>
                        <button name="action_view_commissions" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="commission_count == 0">
                            <field name="commission_count" string="Comisiones" widget="statinfo"/>
                        </button>
                        <button name="action_view_personal_posts" type="object" class="oe_stat_button" icon="fa-share-alt">
                            <field name="advisor_fb_post_count" string="Posts Personales" widget="statinfo"/>
                        </button>
                        <button name="action_open_contracts" type="object" class="oe_stat_button" icon="fa-file-text"
                                invisible="contract_count == 0">
                            <field name="contract_count" string="Contratos" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="map_url" invisible="1"/>
                    <!-- Barra de progreso del expediente -->
                    <div class="alert alert-success mb-2 py-2 px-3" role="alert"
                         style="border-radius:8px; font-size:0.88em;"
                         invisible="property_score == 0 or property_score &lt; 80">
                        <i class="fa fa-check-circle" title="Completo"/> <strong>Expediente completo</strong> —
                        <field name="property_score" readonly="1"/>% (<field name="property_score_label" readonly="1"/>)
                        <field name="avm_status" widget="badge" class="ms-2"/>
                    </div>
                    <div class="alert alert-warning mb-2 py-2 px-3" role="alert"
                         style="border-radius:8px; font-size:0.88em;"
                         invisible="property_score == 0 or property_score &lt; 60 or property_score &gt;= 80">
                        <i class="fa fa-exclamation-circle" title="Incompleto"/> <strong>Expediente incompleto</strong> —
                        <field name="property_score" readonly="1"/>% (<field name="property_score_label" readonly="1"/>)
                        — Agrega imágenes y descripción para mejorar el puntaje.
                    </div>
                    <div class="alert alert-danger mb-2 py-2 px-3" role="alert"
                         style="border-radius:8px; font-size:0.88em;"
                         invisible="property_score == 0 or property_score &gt;= 60">
                        <i class="fa fa-times-circle" title="Débil"/> <strong>Expediente débil</strong> —
                        <field name="property_score" readonly="1"/>% (<field name="property_score_label" readonly="1"/>)
                        — Completa descripción, imágenes y precio AVM para publicar con mejor alcance.
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="property_type_id" readonly="state == 'sold'"/>
                            <field name="offer_type" invisible="1"/>
                            <field name="price" widget="monetary" readonly="state == 'sold'"
                                   placeholder="Ej: 125000"/>
                            <field name="bottom_price" widget="monetary" readonly="state == 'sold'"
                                   placeholder="Precio mínimo aceptable"
                                   groups="estate_management.estate_group_manager"/>
                            <field name="commission_percentage" readonly="state == 'sold'"/>
                            <field name="commission_amount" widget="monetary" readonly="state == 'sold'"/>
                            <field name="area" readonly="state == 'sold'" placeholder="m²"/>
                            <field name="owner_id" readonly="state == 'sold'"
                                   placeholder="Buscar propietario..."/>
                            <field name="proxy_id" readonly="state == 'sold'"
                                   placeholder="Buscar apoderado..."/>
                            <field name="buyer_id" readonly="state == 'sold'"
                                   placeholder="Se asigna al vender"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="co_user_id" widget="many2one_avatar_user"/>
                            <field name="commission_split_pct" invisible="not co_user_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Captación y Exclusividad">
                            <field name="capture_is_pdf" invisible="1"/>
                            <field name="capture_sheet" filename="capture_sheet_filename"/>
                            <button name="action_view_capture_sheet" type="object" colspan="2"
                                    class="btn btn-link p-0" icon="fa-eye"
                                    invisible="not capture_sheet or not capture_is_pdf"
                                    string="Ver en pantalla grande"/>
                            <field name="is_no_contract" widget="boolean_toggle"/>
                            <field name="is_allied_property" widget="boolean_toggle"/>
                            <field name="allied_agency_id" invisible="not is_allied_property"
                                   options="{'no_create_edit': True}"/>
                            <field name="allied_split_pct" invisible="not is_allied_property"/>
                            <field name="is_exclusive" widget="boolean_toggle"/>
                            <field name="exclusive_user_id" widget="many2one_avatar_user" invisible="not is_exclusive"/>
                        </group>
                        <field name="is_land_type" invisible="1"/>
                        <group string="Terreno / Solar" invisible="not is_land_type">
                            <field name="has_iprus" widget="boolean_toggle"
                                   string="Tiene IPRUS"
                                   help="Informe de Regulación Metropolitana emitido por el municipio"/>
                            <field name="iprus_number"
                                   invisible="not has_iprus"
                                   placeholder="Ej: IPRUS-2024-001234"/>
                        </group>
                    </group>

                    <!-- Características físicas — fila de 5 tarjetas con iconos -->
                    <div class="o_horizontal_separator mt-2 mb-0 px-0 fw-bold small text-uppercase text-muted"
                         style="letter-spacing:.06em;font-size:0.7rem;padding:4px 12px;">
                        Características Físicas
                    </div>
                    <div class="row g-0 mx-0 mb-3 border rounded overflow-hidden">
                        <div class="col text-center py-3 border-end">
                            <i class="fa fa-bed fa-lg text-primary d-block mb-1" title="Habitaciones"/>
                            <div class="small text-muted" style="font-size:0.72rem;">Habitaciones</div>
                            <div class="fw-bold fs-5 lh-1 mt-1">
                                <field name="bedrooms" nolabel="1" readonly="state == 'sold'"/>
                            </div>
                        </div>
                        <div class="col text-center py-3 border-end">
                            <i class="fa fa-bath fa-lg text-primary d-block mb-1" title="Baños"/>
                            <div class="small text-muted" style="font-size:0.72rem;">Baños</div>
                            <div class="fw-bold fs-5 lh-1 mt-1">
                                <field name="bathrooms" nolabel="1" readonly="state == 'sold'" options="{'digits': [16, 0]}"/>
                            </div>
                        </div>
                        <div class="col text-center py-3 border-end">
                            <i class="fa fa-car fa-lg text-primary d-block mb-1" title="Parqueaderos"/>
                            <div class="small text-muted" style="font-size:0.72rem;">Parqueaderos</div>
                            <div class="fw-bold fs-5 lh-1 mt-1">
                                <field name="parking_spaces" nolabel="1" readonly="state == 'sold'"/>
                            </div>
                        </div>
                        <div class="col text-center py-3 border-end">
                            <i class="fa fa-building-o fa-lg text-primary d-block mb-1" title="Piso / Planta"/>
                            <div class="small text-muted" style="font-size:0.72rem;">Piso / Planta</div>
                            <div class="fw-bold fs-5 lh-1 mt-1">
                                <field name="floor" nolabel="1"/>
                            </div>
                        </div>
                        <div class="col text-center py-3">
                            <i class="fa fa-calendar-o fa-lg text-primary d-block mb-1" title="Año Construcción"/>
                            <div class="small text-muted" style="font-size:0.72rem;">Año Construcción</div>
                            <div class="fw-bold fs-5 lh-1 mt-1">
                                <field name="year_built" nolabel="1"/>
                            </div>
                        </div>
                    </div>
                    <group string="Ubicación">
                        <group string="Dirección">
                            <field name="street" placeholder="Ej: Av. 12 de Octubre y Tarqui"/>
                            <field name="street_number" placeholder="Ej: 4-56 ó S/N"/>
                            <field name="sector" placeholder="Ej: El Valle / Yanuncay"/>
                            <field name="city" placeholder="Cuenca"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Detalles y Catastro">
                            <field name="cadastral_code" placeholder="Ej: 010101010101"/>
                            <field name="zip_code" placeholder="010101"/>
                            <field name="sector_keywords" placeholder="Ej: Paccha, El Valle, Ricaurte"/>
                            <field name="wp_publish_location" widget="boolean_toggle"/>
                            <div class="o_field_widget mt-2" colspan="2"
                                 invisible="latitude and longitude">
                                <button name="action_geocode_address"
                                        string="Ubicar en Mapa automáticamente"
                                        type="object"
                                        class="btn btn-primary"
                                        icon="fa-map-marker"
                                        title="Busca la dirección exacta y actualiza el mapa"/>
                            </div>
                        </group>
                        <group string="Coordenadas GPS (auto)" col="4"
                               invisible="not latitude and not longitude">
                            <field name="latitude" readonly="1" string="Latitud"/>
                            <field name="longitude" readonly="1" string="Longitud"/>
                        </group>
                    </group>
                    <div invisible="not latitude and not longitude" class="mb-2">
                        <field name="map_iframe" nolabel="1" widget="html" readonly="1"/>
                    </div>
                    <div invisible="latitude or longitude"
                         class="text-center py-3 text-muted"
                         style="border:1px dashed #cbd5e1;border-radius:8px;margin-bottom:8px;">
                        <i class="fa fa-map-marker fa-2x mb-2 d-block text-primary" title="Sin ubicación en mapa"/>
                        <strong>Sin ubicación en mapa</strong><br/>
                        <small>Ingresa la dirección y ciudad, luego haz clic en
                            <em>Ubicar en Mapa automáticamente</em></small>
                    </div>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Multimedia" name="images">
                            <div class="row g-4 mb-3">
                                <!-- Portada -->
                                <div class="col-lg-4">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="fa fa-star text-warning" title="Portada"/>
                                        <span class="fw-bold">Imagen Principal (portada)</span>
                                    </div>
                                    <field name="image_main" widget="image" class="w-100"
                                           options="{'size': [400, 300]}"/>
                                    <small class="text-muted d-block mt-1">
                                        Esta es la foto destacada que se publica en portales y redes.
                                    </small>
                                </div>

                                <!-- Carga múltiple -->
                                <div class="col-lg-8">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="fa fa-cloud-upload text-primary" title="Subir varias"/>
                                        <span class="fw-bold">Subir varias imágenes a la vez</span>
                                    </div>
                                    <div class="p-3 rounded" style="background:#f8f9fa;border:1px dashed #b9c5d6;">
                                        <field name="gallery_ids" widget="gallery_drop"
                                               options="{'accepted_file_extensions': 'image/*'}"/>
                                        <small class="text-muted d-block mt-2">
                                            <i class="fa fa-info-circle" title="Info"/>
                                            Selecciona o arrastra <strong>varias imágenes desde tu computadora</strong>
                                            a la vez. Al <strong>guardar</strong>, se agregarán automáticamente a la
                                            galería de abajo y quedarán listas para publicar.
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Galería existente -->
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="fa fa-picture-o text-primary" title="Galería"/>
                                <span class="fw-bold">Galería de la propiedad</span>
                                <small class="text-muted">— arrastra para reordenar</small>
                            </div>
                            <field name="image_ids" mode="kanban">
                                <kanban create="false" group_create="false">
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="sequence" widget="handle"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="oe_kanban_global_click position-relative">
                                                <div class="o_kanban_image_fill_left"
                                                     style="height:140px;background-size:cover;background-position:center;border-radius:6px;"
                                                     t-attf-style="background-image:url('/web/image/estate.property.image/#{record.id.raw_value}/image');height:140px;background-size:cover;background-position:center;border-radius:6px;"/>
                                                <div class="p-1 text-center text-truncate small text-muted">
                                                    <field name="name"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                                <list create="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image" widget="image" options="{'size': [100, 100]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                            <div class="text-center text-muted py-4" invisible="image_ids">
                                <i class="fa fa-picture-o fa-2x mb-2 d-block" title="Sin imágenes"/>
                                <small>Aún no hay imágenes en la galería. Usa la zona de carga de arriba.</small>
                            </div>

                            <!-- Tour Virtual 360° -->
                            <separator string="Tour Virtual 360°"/>
                            <group>
                                <group>
                                    <field name="tour_360_active"/>
                                    <field name="tour_360_url" placeholder="https://ejemplo.com/tour.jpg (imagen equirectangular) o URL de Matterport"/>
                                </group>
                            </group>
                            <div invisible="not tour_360_url or not tour_360_active" class="mt-2">
                                <p class="text-muted"><i class="fa fa-info-circle" title="Información"/> El tour 360° se mostrará automáticamente en el portal de propietarios cuando esté activo.</p>
                            </div>

                            <!-- Código QR -->
                            <separator string="Código QR"/>
                            <group>
                                <field name="qr_image" widget="image" class="oe_avatar" readonly="1"/>
                            </group>
                            <p class="text-muted">Escanee este código para ver los datos rápidos de la propiedad.</p>
                        </page>

                        <page string="Financiero" name="mortgage">
                            <group string="Simulador de Crédito Hipotecario">
                                <group string="Parámetros">
                                    <field name="mortgage_down_payment_pct"/>
                                    <field name="mortgage_rate"/>
                                    <field name="mortgage_term_years"/>
                                </group>
                                <group string="Resultado (calculado automáticamente)">
                                    <field name="mortgage_down_payment" widget="monetary" readonly="1"/>
                                    <field name="mortgage_loan_amount" widget="monetary" readonly="1"/>
                                    <field name="mortgage_monthly_payment" widget="monetary" readonly="1"
                                           decoration-bf="1"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                <i class="fa fa-info-circle" title="Información"/> Cálculo referencial basado en sistema francés de amortización.
                                Tasas referenciales Ecuador: BIESS 8.69%, bancos privados 9-11%.
                            </p>
                        </page>
                        <page string="Comercial" name="sales_metrics">
                            <!-- Grupo geo_ai conservado (sin anclas externas pero por compatibilidad) -->
                            <group name="geo_ai" invisible="1"/>

                            <separator string="Ofertas"/>
                            <field name="offer_ids">
                                <list decoration-success="state == 'accepted'"
                                      decoration-danger="state in ('rejected','expired')"
                                      decoration-warning="state == 'countered'">
                                    <field name="name" readonly="1"/>
                                    <field name="partner_id"/>
                                    <field name="offer_amount" widget="monetary"/>
                                    <field name="discount_pct" string="Dto%"/>
                                    <field name="counteroffer_amount" widget="monetary" optional="show"/>
                                    <field name="financing_type" widget="badge"/>
                                    <field name="date"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>

                            <separator string="Historial de Precios"/>
                            <field name="price_history_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="old_price" widget="monetary"/>
                                    <field name="new_price" widget="monetary"/>
                                    <field name="change_pct" string="Variación %"
                                           decoration-danger="change_pct &lt; 0"
                                           decoration-success="change_pct &gt; 0"/>
                                    <field name="change_reason" widget="badge"/>
                                    <field name="user_id" readonly="1"/>
                                </list>
                            </field>

                            <separator string="Negocio Cerrado" invisible="state != 'sold'"/>
                            <group string="Negocio Cerrado" invisible="state != 'sold'">
                                <group>
                                    <field name="deal_deadline"/>
                                    <field name="deal_earnest_amount" widget="monetary"/>
                                    <field name="deal_earnest_received_by_agency"/>
                                    <field name="deal_earnest_received_by_owner"/>
                                    <field name="deal_earnest_received_by_proxy"/>
                                    <field name="deal_earnest_payment_cash"/>
                                    <field name="deal_earnest_payment_transfer"/>
                                    <field name="deal_earnest_payment_deposit"/>
                                    <field name="deal_earnest_payment_other_check"/>
                                    <field name="deal_earnest_payment_other"
                                           invisible="not deal_earnest_payment_transfer and not deal_earnest_payment_deposit and not deal_earnest_payment_other_check"/>
                                    <field name="deal_payment_type"/>
                                    <field name="proxy_id" string="Apoderado del Comprador"/>
                                </group>
                                <group>
                                    <field name="deal_credit_institution"
                                           invisible="deal_payment_type not in ('mortgage','mixed')"/>
                                    <field name="deal_credit_advisor"
                                           invisible="deal_payment_type not in ('mortgage','mixed')"/>
                                    <field name="deal_credit_advisor_phone"
                                           invisible="deal_payment_type not in ('mortgage','mixed')"/>
                                </group>
                                <group colspan="2">
                                    <field name="deal_payment_details"/>
                                    <field name="deal_observations"/>
                                </group>
                            </group>
                            <group>
                                <group string="Arriendo" invisible="offer_type != 'rent'">
                                    <field name="rental_price" widget="monetary"/>
                                    <field name="tenant_id"/>
                                    <field name="date_rented"/>
                                </group>
                                <group string="Métricas de Venta">
                                    <field name="date_listed"/>
                                    <field name="date_sold" invisible="state != 'sold'"/>
                                    <field name="days_on_market"/>
                                    <field name="predicted_days_on_market"/>
                                    <field name="sold_by" invisible="state != 'sold'"/>
                                </group>
                                <group string="Puntuación del Expediente">
                                    <field name="property_score"/>
                                    <field name="property_score_label"/>
                                </group>
                                <group string="Valoración Automatizada (AVM)">
                                    <field name="avm_estimated_price" widget="monetary"/>
                                    <field name="avm_status" widget="badge" decoration-success="avm_status == 'fair'" decoration-danger="avm_status == 'high'" decoration-info="avm_status == 'low'" decoration-warning="avm_status == 'insufficient'"/>
                                    <field name="avm_confidence" widget="badge" decoration-success="avm_confidence == 'high'" decoration-warning="avm_confidence == 'medium'" decoration-danger="avm_confidence in ('low','none')"/>
                                    <field name="avm_comparable_count"/>
                                    <field name="avm_price_trend" invisible="not avm_price_trend"/>
                                    <field name="avm_last_calculated"/>
                                    <button name="action_recalculate_avm" type="object" string="Recalcular AVM" class="btn-sm btn-secondary" icon="fa-refresh" title="Recalcula con comparables de los últimos 6 meses"/>
                                </group>
                                <group string="Contratos">
                                    <field name="contract_end_date"/>
                                    <field name="contract_reminder_days"/>
                                </group>
                            </group>
                            <!-- Mejora 13: Plusvalía para Inversores -->
                            <group string="Calculadora de Plusvalía (Inversores)">
                                <group string="Entradas">
                                    <field name="roi_appreciation_rate"/>
                                </group>
                                <group string="Resultado (calculado automáticamente)">
                                    <field name="roi_5year_value" widget="monetary" string="Valor Estimado a 5 Años"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                <i class="fa fa-info-circle" title="Información"/> Los recordatorios automáticos se generan cuando el contrato está próximo a vencer. Revise sus Actividades Planificadas.
                            </p>
                        </page>
                        <!-- Publicación (WordPress). estate_wordpress reemplaza esta página
                             con su versión completa; estate_ai_agent añade "Asistente IA" después. -->
                        <page string="Publicación" name="wordpress">
                            <group>
                                <field name="wp_published"/>
                                <field name="wp_post_id"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </chatter>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Buscar Propiedad">
                <field name="title"/>
                <field name="name"/>
                <field name="city"/>
                <field name="property_type_id"/>
                <filter name="filter_mine" string="Mis propiedades" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_available" string="Disponibles" domain="[('state', '=', 'available')]"/>
                <filter name="filter_reserved" string="Reservadas" domain="[('state', '=', 'reserved')]"/>
                <filter name="filter_sold" string="Vendidas" domain="[('state', '=', 'sold')]"/>
                <filter name="filter_rented" string="Arrendadas" domain="[('state', '=', 'rented')]"/>
                <filter name="filter_stagnant" string="Estancadas (+60 días)"
                        domain="[('state', '=', 'available'), ('date_listed', '&lt;=', (context_today() - datetime.timedelta(days=60)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_wp_linked" string="Enlazadas con WordPress" domain="[('wp_published', '=', True)]"/>
                <filter name="filter_wp_unlinked" string="Desvinculadas de WordPress" domain="[('wp_unlinked', '=', True)]"/>
                <filter name="filter_wp_never" string="Sin publicar en WordPress" domain="[('wp_published', '=', False), ('wp_unlinked', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Tipo" context="{'group_by': 'property_type_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_city" string="Ciudad" context="{'group_by': 'city'}"/>
                </group>
                <searchpanel>
                    <field name="state" string="Estado" icon="fa-home" select="one" enable_counters="1"/>
                    <field name="property_type_id" string="Tipo de Propiedad" icon="fa-building" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- ==================== KANBAN VIEW ==================== -->
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="title"/>
                <field name="price"/>
                <field name="city"/>
                <field name="property_type_id"/>
                <field name="state"/>
                <field name="image_main"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-attf-src="/web/image/estate.property/{{record.id.raw_value}}/image_main" alt="Propiedad" class="o_image_64_cover"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="title"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <field name="property_type_id"/>
                                </div>
                                <ul>
                                    <li><strong>Precio:</strong> $<field name="price"/></li>
                                    <li><strong>Ciudad:</strong> <field name="city"/></li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== PIVOT VIEW ==================== -->
    <record id="estate_property_view_pivot" model="ir.ui.view">
        <field name="name">estate.property.pivot</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Propiedades" sample="1" display_quantity="true">
                <field name="property_type_id" type="row"/>
                <field name="state" type="col"/>
                <field name="price" type="measure" string="Precio Promedio"/>
                <field name="area" type="measure" string="Área m²"/>
                <field name="days_on_market" type="measure" string="Días en Mercado"/>
            </pivot>
        </field>
    </record>

    <!-- ==================== GRAPH VIEW ==================== -->
    <record id="estate_property_view_graph" model="ir.ui.view">
        <field name="name">estate.property.graph</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <graph string="Propiedades por Tipo y Estado" type="bar" sample="1">
                <field name="property_type_id" string="Tipo"/>
                <field name="price" type="measure" string="Precio"/>
            </graph>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,kanban,pivot,graph,form</field>
        <field name="context">{'search_default_filter_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva propiedad
            </p>
            <p>Registre las propiedades de su inmobiliaria.</p>
        </field>
    </record>
</odoo>
