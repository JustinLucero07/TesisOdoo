<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_estate" model="ir.ui.view">
        <field name="name">res.config.settings.estate</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Inmobiliaria" name="estate_management" logo="/estate_management/static/description/icon.png">
                    <block title="Plantilla de Contrato (Word)" name="estate_contract_tpl">
                        <setting string="Plantilla Word (.docx)"
                                 help="Sube un documento Word con marcadores. El botón 'Generar desde Plantilla Word' del contrato los reemplaza con los datos reales.">
                            <field name="estate_docx_template" filename="estate_docx_template_name"/>
                            <field name="estate_docx_template_name" invisible="1"/>
                            <div class="text-muted mt-2">
                                <b>Marcadores disponibles</b> (escríbelos así en tu Word, con llaves dobles):
                                <div class="mt-1" style="font-family:monospace; font-size:12px;">
                                    {{empresa}} · {{contrato}} · {{tipo_contrato}} ·
                                    {{cliente}} · {{cedula_cliente}} ·
                                    {{propiedad}} · {{direccion}} · {{ciudad}} ·
                                    {{precio}} · {{fecha_inicio}} · {{fecha_fin}} ·
                                    {{vendedor}} · {{asesor}} · {{clausulas}}
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
