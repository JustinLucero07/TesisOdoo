<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ================================================================
        INTEGRACIÓN CON MÓDULOS ESTÁNDAR DE ODOO 19
        ================================================================
        Asigna grupos de Ventas, Contabilidad, RR.HH. y Asistencia
        a cada rol inmobiliario mediante implied_ids.

        No se agregan ir.rule aquí porque los módulos base de Odoo
        ya definen las restricciones correctas para cada grupo:

          sales_team.group_sale_salesman          → owns orders + own invoices (READ)
          sales_team.group_sale_salesman_all_leads → all orders + all outgoing invoices
          account.group_account_user               → full accounting (all move types)
          hr.group_hr_user                         → all employees (HR officer)
          hr_attendance.group_hr_attendance_user   → all attendance records

        MATRIZ DE ACCESO FINAL:
        ┌─────────────────────┬────────────────┬──────────────────┬───────────────────┐
        │ Módulo              │ Asesor         │ Gerente          │ Administrador     │
        ├─────────────────────┼────────────────┼──────────────────┼───────────────────┤
        │ CRM / Pipeline      │ Leads propios  │ Todos los leads  │ Admin + config    │
        │ Pedidos de venta    │ Los propios    │ Todos            │ Admin ventas      │
        │ Facturas cliente    │ Las propias    │ Todas            │ Config contable   │
        │ Contabilidad        │ Sin acceso     │ Completa         │ Config avanzada   │
        │ Empleados (RRHH)    │ Sin acceso     │ Ver/gestionar    │ Admin total       │
        │ Asistencia          │ Solo la suya*  │ Gestionar todas  │ Admin total       │
        └─────────────────────┴────────────────┴──────────────────┴───────────────────┘
        * base.group_user ya implica group_hr_attendance_own_reader
        ================================================================
    -->

    <!-- ── ASESOR ─────────────────────────────────────────────────────
         sales_team.group_sale_salesman proporciona automáticamente:
           • CRM: ver y crear leads/oportunidades asignadas a él
           • Ventas: crear/ver sus propios pedidos (user_id = me)
           • Facturas: READ de facturas salientes donde es responsable
             (via account_invoice_rule_see_personal del módulo sale)
         ──────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_agent" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
        ]"/>
    </record>

    <!-- ── MARKETING ──────────────────────────────────────────────────
         Igual que Asesor en ventas/CRM; sin acceso a finanzas ni RRHH.
         ──────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_marketing" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
        ]"/>
    </record>

    <!-- ── GERENTE ────────────────────────────────────────────────────
         Suma al Asesor los siguientes grupos:
           • group_sale_salesman_all_leads → todos los pedidos + todas
             las facturas salientes (sale_order_see_all / account rule)
           • group_sale_manager → admin de equipos, config CRM
           • account.group_account_user → contador completo: facturas,
             notas de crédito, pagos, diarios, conciliación, informes
             (no incluye config avanzada como periodos o planes de cta.)
           • hr.group_hr_user → oficial RRHH: ver/gestionar empleados,
             contratos, cargos, departamentos
           • hr_attendance.group_hr_attendance_user → ver/corregir
             asistencia de todos los empleados
         ──────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('estate_management.estate_group_agent')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('account.group_account_user')),
            (4, ref('hr.group_hr_user')),
            (4, ref('hr_attendance.group_hr_attendance_user')),
        ]"/>
    </record>

    <!-- ── ADMINISTRADOR ──────────────────────────────────────────────
         Suma al Gerente los siguientes grupos:
           • account.group_account_manager → contador senior: periodos
             contables, planes de cuentas, impuestos, cierre de año,
             toda la configuración contable
           • hr.group_hr_manager → admin total RRHH: estructura salarial,
             tipos de contrato, configuración, archivado de empleados
           • hr_attendance.group_hr_attendance_manager → admin asistencia:
             reglas de horas extra, kioscos, dispositivos IoT
         ──────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_admin" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('estate_management.estate_group_manager')),
            (4, ref('account.group_account_manager')),
            (4, ref('hr.group_hr_manager')),
            (4, ref('hr_attendance.group_hr_attendance_manager')),
        ]"/>
    </record>

</odoo>
