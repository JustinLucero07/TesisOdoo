<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ================================================================
        INTEGRACIÓN CON MÓDULOS ESTÁNDAR DE ODOO 19
        ================================================================
        CONCEPTO CLAVE: implied_ids = herencia de permisos
        ─────────────────────────────────────────────────────────────────
        Cuando un grupo estate hereda de un grupo estándar de Odoo,
        AUTOMÁTICAMENTE obtiene todos los permisos que ese grupo
        estándar tiene sobre sus modelos, sin necesitar CSV duplicados.

        Ejemplo:
          estate_group_manager → implica → hr.group_hr_user
                                               ↓ (automático)
                                 hr.employee, hr.contract, hr.department,
                                 hr.skill, hr.leave.type... TODO incluido

        MÓDULOS ESTÁNDAR INSTALADOS Y SU COBERTURA:
        ──────────────────────────────────────────────────────────────
        MÓDULO               GRUPO ESTÁNDAR              ROL QUE LO TIENE
        ────────────────     ─────────────────────────   ────────────────
        sales_team/crm       group_sale_salesman          Asesor+Marketing
        sales_team           group_sale_salesman_all_leads Gerente+Admin
        sales_team           group_sale_manager           Gerente+Admin
        crm                  group_use_lead               Asesor+Mktg+Gte
        crm                  group_use_recurring_revenues Gerente+Admin
        account              group_account_invoice        Marketing
        account              group_account_user           Gerente+Admin
        account              group_account_manager        Admin
        analytic             group_analytic_accounting    Gerente+Admin
        hr                   group_hr_user                Gerente+Admin
        hr                   group_hr_manager             Admin
        hr_attendance        group_hr_attendance_user     Gerente+Admin
        hr_attendance        group_hr_attendance_manager  Admin
        base                 group_partner_manager        Gerente+Admin
        spreadsheet          group_spreadsheet_user       Gerente+Admin

        ACCESO POR ROL (módulos estándar):
        ┌──────────────────────────┬──────────┬──────────┬──────────┬──────────┐
        │ Área                     │ Asesor   │ Mktg     │ Gerente  │ Admin    │
        ├──────────────────────────┼──────────┼──────────┼──────────┼──────────┤
        │ CRM / Pipeline           │ Propios  │ Todos    │ Todos    │ Config   │
        │ Pedidos de venta         │ Propios  │ Propios  │ Todos    │ Admin    │
        │ Facturas / Contabilidad  │ Propias  │ Solo lec │ Completa │ Config   │
        │ Analítica / Costos       │ Sin acc. │ Sin acc. │ Completa │ Completa │
        │ Contactos (res.partner)  │ Gestión  │ Gestión  │ Admin    │ Admin    │
        │ Empleados / RRHH         │ Sin acc. │ Sin acc. │ Oficial  │ Admin    │
        │ Asistencia               │ Solo suya│ Sin acc. │ Todas    │ Admin    │
        │ Spreadsheets/Dashboard   │ Sin acc. │ Sin acc. │ Acceso   │ Acceso   │
        │ Calendario               │ Gestión  │ Gestión  │ Gestión  │ Admin    │
        │ SMS / WhatsApp base      │ Envío    │ Envío    │ Gestión  │ Admin    │
        └──────────────────────────┴──────────┴──────────┴──────────┴──────────┘
        ================================================================
    -->

    <!-- ── ASESOR ──────────────────────────────────────────────────────
         Comercial de campo: gestiona sus propias propiedades y leads.
         • group_sale_salesman → CRM propios, pedidos propios, contactos
         • crm.group_use_lead  → pipeline de leads habilitado (ya en estate_crm_security)
         ─────────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_agent" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
        ]"/>
    </record>

    <!-- ── MARKETING ──────────────────────────────────────────────────
         Visibilidad total del pipeline CRM y publicación en canales.
         • group_sale_salesman_all_leads → ve todos los leads/oportunidades
           (necesario para analizar el pipeline completo)
         • group_account_invoice → puede ver facturas para reporting,
           sin acceso a configuración contable
         • group_partner_manager → gestión completa de contactos
         ─────────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_marketing" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('sales_team.group_sale_salesman')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('account.group_account_invoice')),
            (4, ref('base.group_partner_manager')),
        ]"/>
    </record>

    <!-- ── GERENTE ────────────────────────────────────────────────────
         Dirección operativa: ve y gestiona todo el negocio.
         • group_sale_salesman_all_leads → todos los pedidos y facturas
         • group_sale_manager → admin de equipos de venta, config CRM
         • group_account_user → contador completo: facturas, pagos,
           diarios, conciliación, informes (sin config avanzada)
         • group_analytic_accounting → centros de costo y analítica
         • group_partner_manager → admin completo de contactos
         • hr.group_hr_user → ver/gestionar empleados, contratos,
           departamentos, skills, org chart
         • hr_attendance.group_hr_attendance_user → ver/corregir
           asistencia de todos los empleados
         ─────────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('estate_management.estate_group_agent')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
            (4, ref('sales_team.group_sale_manager')),
            (4, ref('account.group_account_user')),
            (4, ref('analytic.group_analytic_accounting')),
            (4, ref('base.group_partner_manager')),
            (4, ref('hr.group_hr_user')),
            (4, ref('hr_attendance.group_hr_attendance_user')),
        ]"/>
    </record>

    <!-- ── ADMINISTRADOR ─────────────────────────────────────────────
         Control total del sistema incluyendo configuración avanzada.
         • account.group_account_manager → config contable: períodos,
           planes de cuentas, impuestos, cierre de año
         • hr.group_hr_manager → admin RRHH: estructura salarial,
           tipos de contrato, archivado de empleados
         • hr_attendance.group_hr_attendance_manager → admin asistencia:
           horas extra, kioscos, dispositivos IoT
         ─────────────────────────────────────────────────────────────── -->
    <record id="estate_management.estate_group_admin" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('estate_management.estate_group_manager')),
            (4, ref('account.group_account_manager')),
            (4, ref('hr.group_hr_manager')),
            (4, ref('hr_attendance.group_hr_attendance_manager')),
        ]"/>
    </record>

</odoo>
