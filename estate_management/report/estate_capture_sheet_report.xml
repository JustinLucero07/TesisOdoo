<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Acción: Hoja de Captación de Propiedad (PDF)
    ============================================================ -->
    <record id="action_report_estate_capture_sheet" model="ir.actions.report">
        <field name="name">Hoja de Captación</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate_management.report_capture_sheet_template</field>
        <field name="report_file">estate_management.report_capture_sheet_template</field>
        <field name="print_report_name">'Hoja_Captacion_' + (object.name or 'PROP')</field>
        <field name="binding_model_id" ref="estate_management.model_estate_property"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="estate_management.paperformat_estate_a4"/>
    </record>

    <!-- ============================================================
         Template QWeb: Hoja de Captación
    ============================================================ -->
    <template id="report_capture_sheet_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="prop">
                    <div class="article" style="font-family:Arial,Helvetica,sans-serif; color:#222; font-size:11px;">

                        <!-- ══ ENCABEZADO ══════════════════════════════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; background:#004274; margin-bottom:12px;">
                            <tr>
                                <td style="padding:10px 16px; vertical-align:middle; width:60%;">
                                    <t t-if="env.company.logo">
                                        <img t-att-src="image_data_uri(env.company.logo)" style="height:28px; max-width:110px;"/>
                                    </t>
                                    <t t-else="">
                                        <span style="font-size:15px; font-weight:900; color:white;"><t t-esc="env.company.name"/></span>
                                    </t>
                                </td>
                                <td style="padding:10px 16px; vertical-align:middle; text-align:right; width:40%;">
                                    <div style="font-size:13px; font-weight:900; color:white; text-transform:uppercase; letter-spacing:2px;">Hoja de Captaci&#243;n</div>
                                    <div style="font-size:9px; color:#a8bcdb; margin-top:3px;">
                                        <t t-esc="prop.name"/> &#183; <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ TÍTULO ═══════════════════════════════════════════════════ -->
                        <div style="border-left:4px solid #C8102E; padding:8px 14px; background:#F8F9FB; border-top:1px solid #E0E4EC; border-right:1px solid #E0E4EC; border-bottom:1px solid #E0E4EC; margin-bottom:14px;">
                            <div style="font-size:7px; color:#C8102E; text-transform:uppercase; letter-spacing:2px; font-weight:700; margin-bottom:4px;">Documento Interno &#183; Gesti&#243;n</div>
                            <div style="font-size:15px; font-weight:900; color:#004274;">
                                <t t-esc="prop.title or prop.name"/>
                            </div>
                            <div style="font-size:9px; color:#666; margin-top:3px;">
                                <t t-esc="prop.street or ''"/>
                                <t t-if="prop.city">, <t t-esc="prop.city"/></t>
                                <t t-if="prop.state_id">, <t t-esc="prop.state_id.name"/></t>
                                &#160;&#183;&#160;
                                <t t-if="prop.offer_type == 'sale'">Venta</t>
                                <t t-elif="prop.offer_type == 'rent'">Alquiler</t>
                                &#160;&#183;&#160;
                                <t t-if="prop.state == 'available'">Disponible</t>
                                <t t-elif="prop.state == 'reserved'">Reservado</t>
                                <t t-elif="prop.state == 'sold'">Vendido</t>
                            </div>
                        </div>

                        <!-- ══ 1. DATOS DEL PROPIETARIO ═══════════════════════════════ -->
                        <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                            1. Datos del Propietario
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none; margin-bottom:14px;">
                            <tr>
                                <td style="width:30%; background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Nombre completo</td>
                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5; font-weight:700;"><t t-esc="prop.owner_id.name if prop.owner_id else '&#8212;'"/></td>
                            </tr>
                            <t t-if="prop.owner_id">
                                <tr>
                                    <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Tel&#233;fono</td>
                                    <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.owner_id.phone or prop.owner_id.mobile or '&#8212;'"/></td>
                                </tr>
                                <tr>
                                    <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Email</td>
                                    <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.owner_id.email or '&#8212;'"/></td>
                                </tr>
                                <t t-if="prop.owner_id.street">
                                    <tr>
                                        <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Domicilio</td>
                                        <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.owner_id.street"/></td>
                                    </tr>
                                </t>
                            </t>
                        </table>

                        <!-- ══ 2. DATOS DEL INMUEBLE ═══════════════════════════════════ -->
                        <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                            2. Datos del Inmueble
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none; margin-bottom:14px;">
                            <tr>
                                <td style="width:30%; background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Direcci&#243;n</td>
                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;">
                                    <t t-esc="prop.street or ''"/>
                                    <t t-if="prop.city">, <t t-esc="prop.city"/></t>
                                    <t t-if="prop.state_id">, <t t-esc="prop.state_id.name"/></t>
                                </td>
                            </tr>
                            <tr>
                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Tipo de inmueble</td>
                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.property_type_id.name if prop.property_type_id else '&#8212;'"/></td>
                            </tr>
                            <tr>
                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Operaci&#243;n solicitada</td>
                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;">
                                    <t t-if="prop.offer_type == 'sale'">Venta</t>
                                    <t t-elif="prop.offer_type == 'rent'">Alquiler</t>
                                    <t t-else="">&#8212;</t>
                                </td>
                            </tr>
                            <tr>
                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Superficie total</td>
                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.area or 0"/> m&#178;</td>
                            </tr>
                            <tr>
                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Dormitorios / Ba&#241;os</td>
                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.bedrooms or 0"/> / <t t-esc="prop.bathrooms or 0"/></td>
                            </tr>
                            <tr>
                                <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">Parqueaderos</td>
                                <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.parking_spaces or 0"/></td>
                            </tr>
                            <t t-if="prop.year_built">
                                <tr>
                                    <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; border-bottom:1px solid #D8DCE5; color:#555; font-weight:600;">A&#241;o Construcci&#243;n</td>
                                    <td style="padding:5px 10px; border-bottom:1px solid #D8DCE5;"><t t-esc="prop.year_built"/></td>
                                </tr>
                            </t>
                            <t t-if="prop.latitude and prop.longitude">
                                <tr>
                                    <td style="background:#F8F9FB; padding:5px 10px; border-right:1px solid #D8DCE5; color:#555; font-weight:600;">Coordenadas GPS</td>
                                    <td style="padding:5px 10px;">Lat: <t t-esc="prop.latitude"/> &#183; Lng: <t t-esc="prop.longitude"/></td>
                                </tr>
                            </t>
                        </table>

                        <!-- ══ 3. CONDICIONES COMERCIALES ═════════════════════════════ -->
                        <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                            3. Condiciones Comerciales
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none; margin-bottom:14px;">
                            <thead>
                                <tr style="background:#263d61; color:white;">
                                    <th style="padding:7px 10px; text-align:left; font-weight:700;">Concepto</th>
                                    <th style="padding:7px 10px; text-align:right; font-weight:700;">Valor</th>
                                    <th style="padding:7px 10px; text-align:left; font-weight:700;">Observaci&#243;n</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Precio de publicaci&#243;n</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; text-align:right; font-weight:700; color:#004274;">$<t t-esc="'{:,.2f}'.format(prop.price or 0)"/></td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; color:#666;">Acordado con propietario</td>
                                </tr>
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Precio m&#237;nimo aceptable</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; text-align:right;">$<t t-esc="'{:,.2f}'.format(prop.bottom_price or 0)"/></td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; color:#666;">Margen de negociaci&#243;n</td>
                                </tr>
                                <tr>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Comisi&#243;n por venta</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; text-align:right;"><t t-esc="prop.commission_percentage or 5"/>%</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; color:#666;">Sobre precio final</td>
                                </tr>
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:6px 10px;">Modalidad de captaci&#243;n</td>
                                    <td style="padding:6px 10px; text-align:right;">
                                        <t t-if="prop.is_exclusive">
                                            <span style="color:#15803d; font-weight:700;">Exclusiva</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color:#888;">Sin exclusividad</span>
                                        </t>
                                    </td>
                                    <td style="padding:6px 10px; color:#666;">
                                        <t t-if="prop.is_exclusive and prop.exclusive_user_id">
                                            Asesor: <t t-esc="prop.exclusive_user_id.name"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ══ 4. DOCUMENTACIÓN ═══════════════════════════════════════ -->
                        <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                            4. Checklist de Documentaci&#243;n
                        </div>
                        <table style="width:100%; border-collapse:collapse; font-size:11px; border:1px solid #D8DCE5; border-top:none; margin-bottom:14px;">
                            <thead>
                                <tr style="background:#263d61; color:white;">
                                    <th style="padding:7px 10px; text-align:left;">Documento / Gesti&#243;n</th>
                                    <th style="padding:7px 10px; text-align:center; width:80px;">Entregado</th>
                                    <th style="padding:7px 10px; text-align:left;">Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Escritura / T&#237;tulo de propiedad</td>
                                    <td style="padding:6px 10px; text-align:center; border-bottom:1px solid #E8EAED; color:#888;">[ ]</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;"></td>
                                </tr>
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">C&#233;dula de identidad del propietario</td>
                                    <td style="padding:6px 10px; text-align:center; border-bottom:1px solid #E8EAED; color:#888;">[ ]</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;"></td>
                                </tr>
                                <tr>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Certificado de grav&#225;menes</td>
                                    <td style="padding:6px 10px; text-align:center; border-bottom:1px solid #E8EAED; color:#888;">[ ]</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;"></td>
                                </tr>
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Pago de impuesto predial al d&#237;a</td>
                                    <td style="padding:6px 10px; text-align:center; border-bottom:1px solid #E8EAED; color:#888;">[ ]</td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;"></td>
                                </tr>
                                <tr>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Aval&#250;o realizado</td>
                                    <td style="padding:6px 10px; text-align:center; border-bottom:1px solid #E8EAED;">
                                        <t t-if="prop.appraisal_ids"><span style="color:#15803d; font-weight:700;">[X]</span></t>
                                        <t t-else=""><span style="color:#888;">[ ]</span></t>
                                    </td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; color:#666;">
                                        <t t-if="prop.appraisal_ids"><t t-esc="len(prop.appraisal_ids)"/> aval&#250;o(s)</t>
                                    </td>
                                </tr>
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Fotograf&#237;as tomadas</td>
                                    <td style="padding:6px 10px; text-align:center; border-bottom:1px solid #E8EAED;">
                                        <t t-if="prop.image_main"><span style="color:#15803d; font-weight:700;">[X]</span></t>
                                        <t t-else=""><span style="color:#888;">[ ]</span></t>
                                    </td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED; color:#666;">
                                        <t t-if="prop.image_ids"><t t-esc="len(prop.image_ids)"/> foto(s)</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;">Contrato de exclusividad firmado</td>
                                    <td style="padding:6px 10px; text-align:center; border-bottom:1px solid #E8EAED;">
                                        <t t-if="prop.is_exclusive"><span style="color:#15803d; font-weight:700;">[X]</span></t>
                                        <t t-else=""><span style="color:#888;">[ ]</span></t>
                                    </td>
                                    <td style="padding:6px 10px; border-bottom:1px solid #E8EAED;"></td>
                                </tr>
                                <tr style="background:#F9FAFB;">
                                    <td style="padding:6px 10px;">Publicado en portales/redes</td>
                                    <td style="padding:6px 10px; text-align:center;">
                                        <t t-if="prop.wp_published or prop.fb_published or prop.ig_published"><span style="color:#15803d; font-weight:700;">[X]</span></t>
                                        <t t-else=""><span style="color:#888;">[ ]</span></t>
                                    </td>
                                    <td style="padding:6px 10px; color:#666;">
                                        <t t-if="prop.wp_published">WP </t>
                                        <t t-if="prop.fb_published">FB </t>
                                        <t t-if="prop.ig_published">IG </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ══ 5. DESCRIPCIÓN ═════════════════════════════════════════ -->
                        <t t-if="prop.description">
                            <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                                5. Descripci&#243;n de la Propiedad
                            </div>
                            <div style="border:1px solid #D8DCE5; border-top:none; padding:10px 14px; font-size:11px; color:#444; margin-bottom:14px; line-height:1.6;">
                                <t t-out="prop.description"/>
                            </div>
                        </t>

                        <!-- ══ 6. ACEPTACIÓN / FIRMAS ═════════════════════════════════ -->
                        <div style="background:#004274; color:white; font-size:8px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:6px 14px;">
                            6. Aceptaci&#243;n
                        </div>
                        <div style="border:1px solid #D8DCE5; border-top:none; padding:10px 14px; margin-bottom:24px; font-size:10px; color:#555; line-height:1.6;">
                            El propietario declara que la informaci&#243;n proporcionada es ver&#237;dica y autoriza a
                            <t t-esc="env.company.name"/> a publicar y gestionar la propiedad
                            <t t-if="prop.is_exclusive">en exclusividad</t><t t-else="">sin exclusividad</t>.
                            La presente hoja de captaci&#243;n tiene car&#225;cter informativo y precontractual;
                            las condiciones definitivas ser&#225;n formalizadas en el contrato de prestaci&#243;n de servicios inmobiliarios.
                        </div>

                        <table style="width:100%; border-collapse:collapse; margin-top:36px;">
                            <tr>
                                <td style="width:45%; text-align:center; vertical-align:top; padding-top:8px; border-top:1px solid #333; font-size:11px;">
                                    <strong>FIRMA DEL ASESOR</strong><br/>
                                    <t t-esc="prop.user_id.name if prop.user_id else '___________________'"/>
                                </td>
                                <td style="width:10%;"/>
                                <td style="width:45%; text-align:center; vertical-align:top; padding-top:8px; border-top:1px solid #333; font-size:11px;">
                                    <strong>FIRMA DEL PROPIETARIO</strong><br/>
                                    <t t-esc="prop.owner_id.name if prop.owner_id else '___________________'"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ══ PIE ═══════════════════════════════════════════════════════ -->
                        <table style="width:100%; border-collapse:collapse; border-top:3px solid #004274; margin-top:14px; font-size:8px; color:#888;">
                            <tr>
                                <td style="padding:5px 0; width:50%;">
                                    <t t-if="env.company.street"><strong><t t-esc="env.company.street"/></strong></t>
                                    <t t-if="env.company.city"> &#183; <t t-esc="env.company.city"/></t>
                                    <t t-if="env.company.email"> &#183; <t t-esc="env.company.email"/></t>
                                    <t t-if="env.company.phone"> &#183; <t t-esc="env.company.phone"/></t>
                                </td>
                                <td style="padding:5px 0; width:20%; text-align:center; font-weight:700; color:#004274; font-size:9px;">
                                    <t t-esc="env.company.name"/>
                                </td>
                                <td style="padding:5px 0; width:30%; text-align:right; color:#004274; font-weight:600;">
                                    <t t-esc="prop.name"/> &#183; Emitido <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                </td>
                            </tr>
                        </table>

                    </div>
            </t>
        </t>
    </template>

</odoo>
