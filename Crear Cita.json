      "id": "fde0e670-a41c-4030-8bed-b5bbed24aa9f",
      "name": "Preparar Datos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        416,
        704
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://{{ $('Preparar Datos').item.json.odoo_host }}:8069/jsonrpc",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"common\",\n    \"method\": \"authenticate\",\n    \"args\": [\"{{ $('Preparar Datos').item.json.odoo_db }}\", \"{{ $('Preparar Datos').item.json.odoo_login }}\", \"{{ $('Preparar Datos').item.json.odoo_api_key }}\", {}]\n  },\n  \"id\": 1\n}",
        "options": {}
      },
      "id": "bbe8ffa2-0523-4a85-8c09-6ef4028833b4",
      "name": "Autenticar Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        704
      ]
    },
    {
