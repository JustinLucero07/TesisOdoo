        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\n      \"{{ $('Preparar Datos').item.json.odoo_db }}\",\n      {{ $json.uid }},\n      \"{{ $('Preparar Datos').item.json.odoo_login }}\",\n      \"calendar.event\",\n      \"create\",\n      [{{ JSON.stringify($json.vals) }}]\n    ]\n  },\n  \"id\": 3\n}",
        "options": {}
      },
